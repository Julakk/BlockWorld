    const door = new THREE.Mesh(new THREE.BoxGeometry(1.1, 1.7, 0.08), new THREE.MeshLambertMaterial({ color: 0x3a2618 }));
    door.position.set(-0.9, 0.85, 1.62); g.add(door);
