  /* ===== PERAHU (v4.5: dijual Pak Karto, tidak lagi di dermaga) ===== */
  var boat = C.boatMesh, sailing = false, dock = { x: boat.position.x, z: boat.position.z, r: boat.rotation.y };
  var WALK_SPEED = 4.2;
  var BOATS = [
    { id: 'sampan', name: 'Sampan',            price: 0,     speed: 4.2,  scale: 0.85, color: 0xffffff, desc: 'Perahu kecil dayung. Gratis.' },
    { id: 'jukung', name: 'Jukung',            price: 2500,  speed: 5.6,  scale: 1.0,  color: 0xffe3a8, desc: 'Perahu bercadik tradisional.' },
    { id: 'motor',  name: 'Perahu Motor',      price: 9000,  speed: 7.6,  scale: 1.1,  color: 0xa8d4ff, desc: 'Pakai mesin tempel, lumayan ngebut.' },
    { id: 'speed',  name: 'Speedboat',         price: 28000, speed: 10.5, scale: 1.2,  color: 0xff9a8a, desc: 'Cepat banget buat jelajah.' },
    { id: 'royal',  name: 'Kapal Layar Mewah', price: 80000, speed: 14,   scale: 1.45, color: 0xffe27a, desc: 'Kapal paling kencang dan megah.' }
  ];
  var fmtN = function (n) { return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
  function bget(id) { for (var i = 0; i < BOATS.length; i++) if (BOATS[i].id === id) return BOATS[i]; return BOATS[0]; }
  function bsave() {
    var s = S(); if (!s.boats) s.boats = {};
    s.boats.sampan = 1;
    if (!s.boat || !s.boats[s.boat]) s.boat = 'sampan';
    return s;
  }
  function setSpeed(v) { if (C.setSpeed) C.setSpeed(v); }

  var BOAT_Y = { sampan: 0.12, jukung: 0.15, motor: 0.25, speed: 0.25, royal: 0.25 };
  var boatModels = {}, thumbs = {}, thumbsDone = false;
  function ensureThumbs() {
    if (thumbsDone) return; thumbsDone = true;
    try {
      var W = 320, H = 190, cv = document.createElement('canvas'); cv.width = W; cv.height = H;
      var r = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true, preserveDrawingBuffer: true });
      r.setPixelRatio(1); r.setSize(W, H, false); r.setClearColor(0x000000, 0);
      if ('outputEncoding' in r && THREE.sRGBEncoding) r.outputEncoding = THREE.sRGBEncoding;
      var sc = new THREE.Scene(); sc.add(new THREE.HemisphereLight(0xe6f4ff, 0x3b4650, 0.95));
      var dl = new THREE.DirectionalLight(0xfff0d0, 1.2); dl.position.set(5, 8, 6); sc.add(dl);
      var cam = new THREE.PerspectiveCamera(30, W / H, 0.1, 200);
      BOATS.forEach(function (b) {
        var m = pmBuildBoat(b.id); m.rotation.y = -0.75; sc.add(m); m.updateMatrixWorld(true);
        var bb = new THREE.Box3().setFromObject(m), c = bb.getCenter(new THREE.Vector3()), rad = bb.getBoundingSphere(new THREE.Sphere()).radius;
        var dist = rad * 0.92 / Math.tan(Math.PI / 12), dir = new THREE.Vector3(0.35, 0.38, 0.86).normalize();
        cam.position.copy(c).addScaledVector(dir, dist); cam.lookAt(c);
        r.render(sc, cam); thumbs[b.id] = cv.toDataURL('image/png');
        sc.remove(m); m.traverse(function (o) { if (o.geometry) o.geometry.dispose(); if (o.material) o.material.dispose(); });
      });
      r.dispose(); if (r.forceContextLoss) r.forceContextLoss();
    } catch (e) { console.warn('thumb perahu gagal', e); }
  }
  function applyLook(b) {
    boat.scale.set(1, 1, 1);
    if (!boatModels[b.id]) { var m = pmBuildBoat(b.id); m.position.y = BOAT_Y[b.id] || 0.2; boatModels[b.id] = m; boat.add(m); }
    boat.children.forEach(function (c) { c.visible = false; });
    boatModels[b.id].visible = true;
  }
  boat.visible = false;

  var boatE = { id: 'boat', name: 'PERAHU', label: 'Turun ke Dermaga', x: 9999, z: 9999, action: function () { if (sailing) leaveBoat(); } };
  function board(id) {
    var s = bsave(), b = bget(id), p = C.player.position;
    s.boat = b.id; C.persist();
    sailing = true; p.x = dock.x; p.z = dock.z;
    boat.position.x = dock.x; boat.position.z = dock.z; boat.rotation.y = dock.r;
    boat.visible = true; applyLook(b); setSpeed(b.speed);
    boatE.label = 'Turun ke Dermaga'; boatE.x = p.x; boatE.z = p.z;
    $('interactBtn').textContent = boatE.label;
    C.toast('Berlayar dengan ' + b.name + '!');
  }
  function leaveBoat() {
    var p = C.player.position;
    sailing = false; p.x = 0; p.z = 36;
    boat.visible = false; boat.position.x = dock.x; boat.position.z = dock.z; boat.rotation.y = dock.r;
    boatE.x = 9999; boatE.z = 9999; setSpeed(WALK_SPEED);
    C.toast('Kembali ke dermaga');
  }
  C.TOWN_SHOPS.push(boatE);

  /* --- Toko Perahu (Pak Karto) --- */
  var bov = document.createElement('div');
  bov.className = 'modalOverlay'; bov.id = 'modalBoatShop';
  document.body.appendChild(bov);
  function closeBoatShop() { bov.classList.remove('show'); }
  function openBoatShop() { renderBoatShop(); bov.classList.add('show'); }
  function pickBoat(id) {
    var s = bsave(), b = bget(id);
    if (!s.boats[id]) {
      if (s.coins < b.price) { C.toast('Koin kurang, butuh ' + fmtN(b.price)); return; }
      s.coins -= b.price; s.boats[id] = 1;
      C.persist(); C.refresh(); C.Sfx.sell(); C.toast('Beli ' + b.name + '!');
      renderBoatShop(); return;
    }
    closeBoatShop(); board(id);
  }
  function renderBoatShop() {
    var s = bsave();
    ensureThumbs();
    var h = '<div class="modalBox"><div class="modalHead"><h2>Pak Karto - Toko Perahu</h2><button class="modalClose" id="bsClose">\u2715</button></div><div class="modalBody">';
    h += '<div style="margin-bottom:10px">Koin kamu: <b>' + fmtN(s.coins) + '</b></div>';
    BOATS.forEach(function (b) {
      var own = !!s.boats[b.id];
      var lbl = own ? 'Naik' : ('Beli ' + fmtN(b.price));
      h += '<div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid rgba(255,255,255,.12)">' +
        (thumbs[b.id] ? '<img src="' + thumbs[b.id] + '" alt="' + b.name + '" style="width:96px;height:57px;flex-shrink:0;object-fit:contain;border-radius:10px;background:linear-gradient(180deg,#2f86a8,#123b52);box-shadow:0 3px 8px rgba(0,0,0,.35)">' : '<div style="width:14px;height:34px;border-radius:4px;background:#' + ('000000' + b.color.toString(16)).slice(-6) + '"></div>') +
        '<div style="flex:1;min-width:0"><div style="font-weight:700">' + b.name + (s.boat === b.id ? ' \u2605' : '') + '</div>' +
        '<div style="font-size:12px;opacity:.8">' + b.desc + ' Kecepatan: ' + b.speed + '</div></div>' +
        '<button class="rowBtn" data-b="' + b.id + '">' + lbl + '</button></div>';
    });
    h += '</div><div class="modalFoot"><span>\u2605 = perahu terakhir dipakai</span><button class="rowBtn" id="bsOk">Tutup</button></div></div>';
    bov.innerHTML = h;
    $('bsClose').onclick = closeBoatShop; $('bsOk').onclick = closeBoatShop;
    bov.querySelectorAll('button[data-b]').forEach(function (btn) { btn.onclick = function () { pickBoat(btn.getAttribute('data-b')); }; });
  }

  /* --- NPC Pak Karto: model 3D detail, berdiri di samping Rod Shop --- */
  (function () {
    var NPC_X = -7.6, NPC_Z = 29.7, NPC_BASE = 1.1;
    var gh = null;
    C.setGround(function (o, x, z) { if (!gh) gh = o; return o(x, z); });
    var npc = new T.Group();

    function mat(col, rough, extra) {
      var o = { color: col, roughness: rough == null ? 0.7 : rough, metalness: 0 };
      if (extra) for (var k in extra) o[k] = extra[k];
      return new T.MeshStandardMaterial(o);
    }
    function tex(w, h, draw) {
      var cv = document.createElement('canvas'); cv.width = w; cv.height = h;
      draw(cv.getContext('2d'), w, h);
      var tx = new T.CanvasTexture(cv); tx.anisotropy = 8; return tx;
    }
    function add(geo, m, x, y, z, par) {
      var o = new T.Mesh(geo, m); o.position.set(x, y, z);
      o.castShadow = true; o.receiveShadow = true; (par || npc).add(o); return o;
    }
    function rr(g, x, y, w, h, r) {
      g.beginPath(); g.moveTo(x + r, y);
      g.arcTo(x + w, y, x + w, y + h, r); g.arcTo(x + w, y + h, x, y + h, r);
      g.arcTo(x, y + h, x, y, r); g.arcTo(x, y, x + w, y, r); g.closePath();
    }

    /* tekstur */
    var shirtTex = tex(256, 256, function (g, w, h) {
      g.fillStyle = '#2d8a58'; g.fillRect(0, 0, w, h);
      for (var i = 0; i < w; i += 32) { g.fillStyle = 'rgba(255,255,255,0.10)'; g.fillRect(i, 0, 14, h); }
      for (var j = 0; j < 900; j++) { g.fillStyle = 'rgba(0,0,0,' + (Math.random() * 0.06) + ')'; g.fillRect(Math.random() * w, Math.random() * h, 2, 2); }
    });
    shirtTex.wrapS = T.RepeatWrapping; shirtTex.repeat.set(2, 1);
    var pantsTex = tex(128, 128, function (g, w, h) {
      g.fillStyle = '#2a3a58'; g.fillRect(0, 0, w, h);
      for (var i = 0; i < 700; i++) { g.fillStyle = 'rgba(255,255,255,' + (Math.random() * 0.07) + ')'; g.fillRect(Math.random() * w, Math.random() * h, 1, 3); }
    });
    var strawTex = tex(256, 256, function (g, w, h) {
      g.fillStyle = '#e6cf8c'; g.fillRect(0, 0, w, h);
      for (var i = 0; i < h; i += 8) { g.fillStyle = (i / 8) % 2 ? 'rgba(160,120,50,0.22)' : 'rgba(255,245,200,0.18)'; g.fillRect(0, i, w, 4); }
      for (var j = 0; j < w; j += 10) { g.fillStyle = 'rgba(120,90,40,0.12)'; g.fillRect(j, 0, 2, h); }
    });
    var boardTex = tex(512, 256, function (g, w, h) {
      g.fillStyle = '#7a4a28'; g.fillRect(0, 0, w, h);
      for (var i = 0; i < h; i += 32) { g.fillStyle = 'rgba(0,0,0,0.18)'; g.fillRect(0, i, w, 3); }
      g.strokeStyle = '#3d2412'; g.lineWidth = 10; g.strokeRect(5, 5, w - 10, h - 10);
      g.fillStyle = '#fff3c9'; g.textAlign = 'center'; g.textBaseline = 'middle';
      g.font = 'bold 84px sans-serif'; g.fillText('PERAHU', w / 2, 100);
      g.font = 'bold 40px sans-serif'; g.fillStyle = '#ffd46b'; g.fillText('Toko Pak Karto', w / 2, 180);
    });
    var tagTex = tex(256, 64, function (g, w, h) {
      g.fillStyle = 'rgba(10,25,40,0.72)'; rr(g, 4, 6, w - 8, h - 12, 18); g.fill();
      g.strokeStyle = 'rgba(255,255,255,0.55)'; g.lineWidth = 3; g.stroke();
      g.font = 'bold 30px sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillStyle = '#ffffff'; g.fillText('Pak Karto', w / 2, h / 2 + 1);
    });

    /* material */
    var skin = mat(0xe3ab7e, 0.55), skinD = mat(0xc98d62, 0.6), white = mat(0xffffff, 0.3), black = mat(0x1b1b1b, 0.3);
    var gray = mat(0xd6d6d6, 0.85), brown = mat(0x5a3a22, 0.8), gold = mat(0xd9b34a, 0.3, { metalness: 0.8 }), red = mat(0xb02a2a, 0.6);
    var pantsM = mat(0xffffff, 0.85, { map: pantsTex }), shirtM = mat(0xffffff, 0.8, { map: shirtTex }), strawM = mat(0xffffff, 0.9, { map: strawTex });

    /* kaki, sepatu */
    add(new T.CylinderGeometry(0.115, 0.1, 0.66, 14), pantsM, -0.15, 0.4, 0);
    add(new T.CylinderGeometry(0.115, 0.1, 0.66, 14), pantsM, 0.15, 0.4, 0);
    var shoeG = new T.SphereGeometry(1, 14, 10);
    [-0.15, 0.15].forEach(function (sx) { var s = add(shoeG, brown, sx, 0.07, 0.07); s.scale.set(0.14, 0.09, 0.24); });

    /* badan */
    var torso = add(new T.CylinderGeometry(0.30, 0.33, 0.72, 20), shirtM, 0, 1.08, 0); torso.scale.z = 0.72;
    var belt = add(new T.CylinderGeometry(0.335, 0.335, 0.07, 20), brown, 0, 0.77, 0); belt.scale.z = 0.72;
    add(new T.BoxGeometry(0.1, 0.075, 0.03), gold, 0, 0.77, 0.255);
    var collar = add(new T.TorusGeometry(0.19, 0.035, 8, 20), white, 0, 1.43, 0); collar.rotation.x = Math.PI / 2; collar.scale.y = 0.75;
    add(new T.CylinderGeometry(0.07, 0.08, 0.12, 12), skin, 0, 1.5, 0);

    /* lengan */
    function makeArm(sx) {
      var pv = new T.Group(); pv.position.set(sx, 1.36, 0); npc.add(pv);
      add(new T.SphereGeometry(0.115, 14, 10), shirtM, 0, 0, 0, pv);
      add(new T.CylinderGeometry(0.095, 0.085, 0.5, 14), shirtM, 0, -0.27, 0, pv);
      add(new T.CylinderGeometry(0.085, 0.07, 0.12, 14), skin, 0, -0.56, 0, pv);
      add(new T.SphereGeometry(0.085, 14, 10), skin, 0, -0.65, 0, pv);
      return pv;
    }
    var armR = makeArm(0.4), armL = makeArm(-0.4);

    /* kepala */
    var head = new T.Group(); head.position.y = 1.72; npc.add(head);
    var hs = add(new T.SphereGeometry(0.24, 24, 18), skin, 0, 0, 0, head); hs.scale.set(1, 1.08, 1);
    [-1, 1].forEach(function (s) {
      var ew = add(new T.SphereGeometry(0.045, 12, 10), white, s * 0.09, 0.04, 0.2, head); ew.scale.z = 0.5;
      add(new T.SphereGeometry(0.022, 10, 8), black, s * 0.09, 0.04, 0.232, head);
      var br = add(new T.BoxGeometry(0.09, 0.018, 0.02), gray, s * 0.09, 0.115, 0.215, head); br.rotation.z = s * 0.15;
      var ear = add(new T.SphereGeometry(0.05, 10, 8), skin, s * 0.24, 0, 0, head); ear.scale.set(0.5, 1, 0.8);
      var mu = add(new T.SphereGeometry(0.05, 12, 8), gray, s * 0.045, -0.08, 0.222, head); mu.scale.set(1.6, 0.7, 0.8); mu.rotation.z = -s * 0.25;
      var sb = add(new T.SphereGeometry(0.06, 10, 8), gray, s * 0.2, -0.02, 0.03, head); sb.scale.set(0.6, 1.3, 1);
    });
    var nose = add(new T.SphereGeometry(0.04, 12, 10), skinD, 0, -0.02, 0.24, head); nose.scale.set(1, 1.1, 1);
    var smile = add(new T.TorusGeometry(0.06, 0.008, 6, 16, Math.PI), red, 0, -0.1, 0.225, head); smile.rotation.z = Math.PI;

    /* topi jerami */
    var brim = add(new T.CylinderGeometry(0.46, 0.46, 0.03, 28), strawM, 0, 0.2, 0, head); brim.rotation.x = 0.05;
    add(new T.CylinderGeometry(0.25, 0.28, 0.16, 24), strawM, 0, 0.29, 0, head);
    var top = add(new T.SphereGeometry(0.25, 20, 10, 0, Math.PI * 2, 0, Math.PI / 2), strawM, 0, 0.37, 0, head); top.scale.y = 0.5;
    add(new T.CylinderGeometry(0.285, 0.285, 0.05, 24), red, 0, 0.24, 0, head);

    /* label nama */
    var tag = new T.Sprite(new T.SpriteMaterial({ map: tagTex, transparent: true, depthWrite: false }));
    tag.scale.set(1.5, 0.375, 1); tag.position.y = 2.55; npc.add(tag);

    npc.position.set(NPC_X, C.DECK_Y, NPC_Z); npc.rotation.y = NPC_BASE;
    C.town.add(npc);
    C.TOWN_COLLIDERS.push({ x: NPC_X, z: NPC_Z, r: 0.8 });

    /* papan toko di sebelahnya */
    var board = new T.Group();
    [-0.5, 0.5].forEach(function (sx) { add(new T.CylinderGeometry(0.045, 0.05, 1.3, 8), brown, sx, 0.65, 0, board); });
    add(new T.BoxGeometry(1.25, 0.62, 0.06), mat(0x5a3a22, 0.8), 0, 1.05, 0, board);
    var pl = new T.Mesh(new T.PlaneGeometry(1.17, 0.58), new T.MeshBasicMaterial({ map: boardTex }));
    pl.position.set(0, 1.05, 0.034); board.add(pl);
    var BX = NPC_X + 0.3, BZ = NPC_Z + 1.7;
    board.position.set(BX, C.DECK_Y, BZ); board.rotation.y = NPC_BASE;
    C.town.add(board);
    C.TOWN_COLLIDERS.push({ x: BX, z: BZ, r: 0.7 });

    C.TOWN_SHOPS.push({ id: 'boatnpc', name: 'PAK KARTO', label: 'Bicara dengan Pak Karto', x: NPC_X, z: NPC_Z, action: function () { if (!sailing) openBoatShop(); } });

    /* animasi */
    C.hookAnim(function (t) {
      if (gh) { npc.position.y = gh(NPC_X, NPC_Z); board.position.y = gh(BX, BZ); }
      var p = C.player.position, dx = p.x - NPC_X, dz = p.z - NPC_Z, near = dx * dx + dz * dz < 64;
      var tgt = near ? Math.atan2(dx, dz) : NPC_BASE;
      var d = Math.atan2(Math.sin(tgt - npc.rotation.y), Math.cos(tgt - npc.rotation.y));
      npc.rotation.y += d * 0.08;
      var br = Math.sin(t * 2.0);
      torso.scale.y = 1 + br * 0.012; head.position.y = 1.72 + br * 0.008; head.rotation.z = Math.sin(t * 0.9) * 0.03;
      armR.rotation.z = near ? 2.55 + Math.sin(t * 7) * 0.28 : 0.09 + Math.sin(t * 1.4) * 0.03;
      armL.rotation.z = -0.09 - Math.sin(t * 1.4 + 1) * 0.03;
    });
  })();
  C.setWalkable(function (o, x, z) { if (!sailing) return o(x, z); var d = Math.hypot(x, z); return d > C.ISLAND_RADIUS + 1 && d < 260 && !(Math.abs(x) < 2.7 && z > 27) && !(Math.abs(Math.abs(x) - 11.5) < 2.3 && z > 27 && z < 43.6) && !(Math.abs(Math.abs(x) - 11.5) < 4.2 && z > 38.5 && z < 43.6) && !(Math.abs(x) < 6 && z > 46 && z < 51.2); });
  C.setNearWater(function (o) { return sailing || o(); });
  C.setGround(function (o, x, z) { return sailing ? 0.24 : o(x, z); });

  /* ===== EVENT ===== */
  var EV = [
    { n: 'Golden Hour', d: 'Peluang ikan Emas naik!', c: 'rgba(255,200,60,0.18)', b: '#c98a10', up: 0.35, muts: ['emas'], boost: 1.1 },
    { n: 'Blood Moon', d: 'Ikan Hantu & Pelangi bermunculan!', c: 'rgba(200,20,40,0.22)', b: '#a01828', up: 0.3, muts: ['ghost', 'pelangi'], boost: 1.25 }
  ];
  var evNow = null, evEnd = 0, evNext = performance.now() / 1000 + 150 + Math.random() * 120;
  var evO = document.createElement('div'); evO.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:7;opacity:0;transition:opacity 1.5s'; document.body.appendChild(evO);
  var evB = document.createElement('div'); evB.id = 'evBadge'; document.body.appendChild(evB);
  function evTick(now) {
    if (!evNow && now >= evNext) {
      evNow = EV[Math.floor(Math.random() * EV.length)]; evEnd = now + 100;
      evO.style.background = 'radial-gradient(ellipse at center, transparent 40%, ' + evNow.c + ' 100%)'; evO.style.opacity = 1;
      evB.style.background = evNow.b; evB.style.display = 'block';
      C.toast('EVENT: ' + evNow.n + '! ' + evNow.d); C.Sfx.levelUp(); C.vibe([60, 40, 60]);
    } else if (evNow && now >= evEnd) {
      evNow = null; evNext = now + 240 + Math.random() * 240; evO.style.opacity = 0; evB.style.display = 'none'; C.toast('Event selesai');
    }
    if (evNow) { var r = Math.max(0, Math.ceil(evEnd - now)), tx = evNow.n + ' • ' + Math.floor(r / 60) + ':' + ('0' + (r % 60)).slice(-2); if (evB.textContent !== tx) evB.textContent = tx; }
  }
  C.hookRoll(function (orig, boost) {
    var ev = evNow, r = orig(boost * (ev ? ev.boost : 1));
    if (ev && r.mutation.id === 'normal' && Math.random() < ev.up) {
      var id = ev.muts[Math.floor(Math.random() * ev.muts.length)];
      var m = C.MUTATIONS.filter(function (x) { return x.id === id; })[0];
      if (m) { r.mutation = m; r.value = Math.round(r.fish.value * m.mult); }
    }
    return r;
  });

  /* PM_V42 peringkat + boss + pasar pemain */
  var UID = (function () {
    function rnd() { var u = ''; for (var j = 0; j < 28; j++) u += Math.floor(Math.random() * 16).toString(16); return u; }
    try {
      var u = localStorage.getItem('pm_uid');
      if (u && /^[A-Za-z0-9]{16,40}$/.test(u)) return u;
      u = '';
      if (window.crypto && crypto.getRandomValues) { var a = new Uint8Array(14); crypto.getRandomValues(a); for (var i = 0; i < a.length; i++) u += ('0' + a[i].toString(16)).slice(-2); }
      else u = rnd();
      localStorage.setItem('pm_uid', u); return u;
    } catch (e) { return rnd(); }
  })();
  function netUp() { var n = window.PMNet; return !!(n && n.up && n.up()); }
  function netSend(o) { if (window.PMNet && window.PMNet.raw) window.PMNet.raw(o); }
  function fmt(n) { return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function escH(x) { return String(x).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
  function fishById(id) { return C.FISH_TABLE.filter(function (f) { return f.id === id; })[0]; }
  function mutById(id) { return C.MUTATIONS.filter(function (m) { return m.id === id; })[0]; }
  function addItem(fid, mid) {
    var f = fishById(fid), mu = mutById(mid); if (!f || !mu) return false;
    var s = S(), k = fid + '|' + mid;
    s.inventory[k] = s.inventory[k] || { fish: f, mutation: mu, count: 0 };
    s.inventory[k].count++; s.discovered = s.discovered || {}; s.discovered[fid] = true; return true;
  }
  var css42 = document.createElement('style');
  css42.textContent = [
    '.pm42Tabs{display:flex;gap:6px;margin-bottom:8px}'
  ].join('');
  document.head.appendChild(css42);

  /* --- peringkat --- */
  var mLB = mkModal('modalLB', 'Peringkat Online'), lbData = null, lbTab = 'c';
  /* PM_V44: papan peringkat kayu (modal + papan 3D di samping Akuarium) */
  function fmtC(n) {
    n = +n || 0;
    var a = [[1e12, 'T'], [1e9, 'B'], [1e6, 'M'], [1e3, 'K']];
    for (var i = 0; i < a.length; i++) if (n >= a[i][0]) return (n / a[i][0]).toFixed(2) + a[i][1];
    return String(Math.round(n));
  }
  function lbHue(name) { return hash(String(name)) % 360; }
  function lbAv(name) {
    var h = lbHue(name), ch = String(name).charAt(0).toUpperCase() || '?';
    return '<div class="lbAv" style="background:linear-gradient(145deg,hsl(' + h + ',72%,62%),hsl(' + ((h + 40) % 360) + ',70%,30%))">' + escH(ch) + '</div>';
  }
  var LB_FISH = '<svg viewBox="0 0 64 40" width="54" height="34" aria-hidden="true"><defs><linearGradient id="lbFg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b8f7ff"/><stop offset="1" stop-color="#1aa3e8"/></linearGradient></defs><path d="M4 20C14 4 36 2 48 16L62 6L58 20L62 34L48 24C36 38 14 36 4 20Z" fill="url(#lbFg)" stroke="#0a5d8f" stroke-width="2.5" stroke-linejoin="round"/><circle cx="16" cy="17" r="3" fill="#06324d"/><circle cx="15" cy="16" r="1" fill="#fff"/><path d="M24 12C28 20 28 20 24 28" stroke="#0a5d8f" stroke-width="2" fill="none" opacity=".6"/></svg>';
  var cssLB = document.createElement('style');
  cssLB.textContent = [
    '#modalLB .modalBox{background:repeating-linear-gradient(92deg,rgba(0,0,0,.06) 0 2px,rgba(255,255,255,.035) 2px 6px),linear-gradient(180deg,#bd8148,#8d5b30 45%,#6c4222);border:4px solid #3f2713;border-radius:18px;box-shadow:0 16px 44px rgba(0,0,0,.7),inset 0 2px 0 rgba(255,255,255,.28),inset 0 -8px 16px rgba(0,0,0,.4);color:#fff}',
    '#modalLB .modalHead{background:transparent;border:0}',
    '#modalLB .modalHead h2{color:#f6e3c4;font-size:12px;letter-spacing:2px;text-transform:uppercase;text-shadow:0 2px 0 rgba(0,0,0,.5)}',
    '#modalLB .modalBody{padding:4px 10px 10px}',
    '#modalLB .modalFoot{background:rgba(0,0,0,.28);border:0;color:#f3dcb8}',
    '.lbTitle{display:flex;align-items:center;justify-content:center;gap:10px;margin:0 0 8px;transform:rotate(-1.5deg)}',
    '.lbTitle span{font-size:28px;font-weight:900;font-style:italic;color:#3adaff;-webkit-text-stroke:1.5px #06324d;paint-order:stroke fill;text-shadow:0 3px 0 #06324d,0 7px 12px rgba(0,0,0,.5)}',
    '.lbTitle svg{filter:drop-shadow(0 3px 3px rgba(0,0,0,.5))}',
    '.lbTabs{display:flex;gap:6px;margin-bottom:8px}',
    '.lbTab{flex:1;padding:8px 4px;border-radius:10px;border:2px solid #3a2210;font-weight:900;font-size:12px;color:#f6e3c4;background:linear-gradient(180deg,#7a4d28,#55331a);box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 2px 0 rgba(0,0,0,.4)}',
    '.lbTab.on{color:#06324d;background:linear-gradient(180deg,#8ff0ff,#25b4ee);border-color:#06324d;text-shadow:0 1px 0 rgba(255,255,255,.4)}',
    '.lbRows{background:rgba(44,25,11,.6);border:2px solid #47290f;border-radius:12px;padding:6px 6px 8px;box-shadow:inset 0 4px 10px rgba(0,0,0,.65),0 1px 0 rgba(255,255,255,.2);max-height:56vh;overflow-y:auto}',
    '.lbHd,.lbRow{display:grid;grid-template-columns:54px 1fr auto;gap:8px;align-items:center}',
    '.lbHd{padding:2px 8px 4px;font-size:10px;font-weight:900;letter-spacing:1px;color:#f6e3c4}',
    '.lbRow{margin-top:6px;padding:6px 10px 6px 4px;border:2px solid #3a2210;border-radius:9px;background:linear-gradient(180deg,#936139,#6b4223);box-shadow:inset 0 1px 0 rgba(255,255,255,.24),0 2px 0 rgba(0,0,0,.4)}',
    '.lbRow.r1{background:linear-gradient(180deg,#b88a3a,#7c5418);border-color:#5a3c06}',
    '.lbRk{text-align:center;font-size:28px;font-weight:900;line-height:1;color:#f5ecd8;-webkit-text-stroke:1.5px #2a1805;paint-order:stroke fill;text-shadow:0 2px 0 #2a1805}',
    '.r1 .lbRk{color:#ffd84a}.r2 .lbRk{color:#e3ebf5}.r3 .lbRk{color:#f0a165}',
    '.lbWho{display:flex;align-items:center;gap:8px;min-width:0}',
    '.lbAv{flex:none;width:40px;height:40px;border-radius:8px;border:2px solid #20120a;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:19px;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.6);box-shadow:inset 0 2px 0 rgba(255,255,255,.38),0 2px 5px rgba(0,0,0,.45)}',
    '.lbNm{font-size:15px;font-weight:900;color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.55);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}',
    '.lbSb{font-size:10px;color:#f1d9b4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}',
    '.lbVal{font-size:15px;font-weight:900;color:#fff;text-align:right;white-space:nowrap;text-shadow:0 2px 0 rgba(0,0,0,.55)}',
    '.lbMsg{text-align:center;padding:16px;font-size:13px;color:#f1d9b4}'
  ].join('');
  document.head.appendChild(cssLB);
  function renderLB() {
    var meta = { c: ['Ikan Ditangkap', 'DITANGKAP'], w: ['Ikan Terberat', 'BERAT'], p: ['Prestise', 'REBIRTH'] }[lbTab];
    var h = '<div class="lbTitle">' + LB_FISH + '<span>' + meta[0] + '</span></div>';
    h += '<div class="lbTabs">' + [['c', 'Tangkapan'], ['w', 'Terberat'], ['p', 'Prestise']].map(function (t) {
      return '<button class="lbTab' + (lbTab === t[0] ? ' on' : '') + '" data-lt="' + t[0] + '">' + t[1] + '</button>';
    }).join('') + '</div>';
    h += '<div class="lbRows"><div class="lbHd"><span style="text-align:center">RANK</span><span>NAMA</span><span>' + meta[1] + '</span></div>';
    if (!netUp()) h += '<div class="lbMsg">Belum tersambung ke server.</div>';
    else if (!lbData) h += '<div class="lbMsg">Memuat peringkat...</div>';
    else {
      var l = (lbData[lbTab] || []).slice(0, 10);
      if (!l.length) h += '<div class="lbMsg">Belum ada data.</div>';
      l.forEach(function (e, i) {
        var val, sub = '';
        if (lbTab === 'c') val = fmtC(e[1]);
        else if (lbTab === 'w') { val = C.fmtKg(e[1]); sub = e[2] || ''; }
        else { val = 'R' + e[1]; sub = 'Level ' + e[2]; }
        h += '<div class="lbRow r' + (i < 3 ? i + 1 : 0) + '"><div class="lbRk">' + (i + 1) + '</div>'
          + '<div class="lbWho">' + lbAv(e[0]) + '<div style="min-width:0"><div class="lbNm">' + escH(e[0]) + '</div>'
          + (sub ? '<div class="lbSb">' + escH(sub) + '</div>' : '') + '</div></div>'
          + '<div class="lbVal">' + escH(val) + '</div></div>';
      });
    }
    h += '</div>';
    mLB.body.innerHTML = h; mLB.foot.textContent = 'Data dilaporkan tiap pemain, diperbarui tiap 45 detik';
  }
  mLB.body.addEventListener('click', function (ev) {
    var b = ev.target.closest('[data-lt]'); if (!b) return; lbTab = b.dataset.lt; renderLB();
  });

  /* --- papan peringkat 3D di samping Akuarium --- */
  var LBB = { x: AQ.x - 4.3, z: AQ.z + 0.2 };
  var lbCv = document.createElement('canvas'); lbCv.width = 1024; lbCv.height = 640;
  var lbTex = new T.CanvasTexture(lbCv); lbTex.minFilter = T.LinearFilter; lbTex.magFilter = T.LinearFilter; lbTex.generateMipmaps = false;
  try { lbTex.anisotropy = 8; } catch (e) {}
  function rr(g, x, y, w, h, r) { g.beginPath(); g.moveTo(x + r, y); g.arcTo(x + w, y, x + w, y + h, r); g.arcTo(x + w, y + h, x, y + h, r); g.arcTo(x, y + h, x, y, r); g.arcTo(x, y, x + w, y, r); g.closePath(); }
  function strokeFill(g, txt, x, y, fill, stroke, lw) { g.lineJoin = 'round'; g.lineWidth = lw; g.strokeStyle = stroke; g.strokeText(txt, x, y); g.fillStyle = fill; g.fillText(txt, x, y); }
  function drawLB() {
    var g = lbCv.getContext('2d'), W = 1024, H = 640, i, k;
    // papan kayu + serat
    var bg = g.createLinearGradient(0, 0, 0, H); bg.addColorStop(0, '#c58a50'); bg.addColorStop(0.5, '#9a6636'); bg.addColorStop(1, '#74481f');
    g.fillStyle = bg; g.fillRect(0, 0, W, H);
    for (i = 0; i < 9; i++) { g.fillStyle = 'rgba(0,0,0,' + (i % 2 ? 0.1 : 0.05) + ')'; g.fillRect(0, i * 72, W, 3); }
    for (i = 0; i < 90; i++) { g.fillStyle = 'rgba(60,30,10,' + (0.05 + (i % 5) * 0.015) + ')'; g.fillRect((i * 97) % W, (i * 53) % H, 40 + (i * 13) % 120, 2); }
    g.lineWidth = 14; g.strokeStyle = '#4a2c14'; g.strokeRect(7, 7, W - 14, H - 14);
    g.lineWidth = 3; g.strokeStyle = 'rgba(255,220,170,.35)'; g.strokeRect(18, 18, W - 36, H - 36);
    // paku
    [[34, 34], [W - 34, 34], [34, H - 34], [W - 34, H - 34]].forEach(function (p) { g.fillStyle = '#2b1a0c'; g.beginPath(); g.arc(p[0], p[1], 9, 0, 7); g.fill(); g.fillStyle = '#c9b79a'; g.beginPath(); g.arc(p[0] - 2, p[1] - 2, 4, 0, 7); g.fill(); });
    // judul + ikan
    var fp = new Path2D('M4 20C14 4 36 2 48 16L62 6L58 20L62 34L48 24C36 38 14 36 4 20Z');
    g.save(); g.translate(150, 36); g.scale(3.1, 3.1);
    var fg = g.createLinearGradient(0, 0, 0, 40); fg.addColorStop(0, '#b8f7ff'); fg.addColorStop(1, '#1aa3e8');
    g.fillStyle = fg; g.fill(fp); g.lineWidth = 2.5; g.strokeStyle = '#0a5d8f'; g.lineJoin = 'round'; g.stroke(fp);
    g.fillStyle = '#06324d'; g.beginPath(); g.arc(16, 17, 3, 0, 7); g.fill(); g.fillStyle = '#fff'; g.beginPath(); g.arc(15, 16, 1, 0, 7); g.fill();
    g.restore();
    g.textAlign = 'left'; g.textBaseline = 'middle'; g.font = 'italic 900 78px sans-serif';
    g.shadowColor = 'rgba(0,0,0,.5)'; g.shadowBlur = 14; g.shadowOffsetY = 6;
    strokeFill(g, 'Ikan Ditangkap', 370, 92, '#3adaff', '#06324d', 12);
    g.shadowColor = 'transparent'; g.shadowBlur = 0; g.shadowOffsetY = 0;
    // panel isi
    rr(g, 40, 166, W - 80, 434, 18); g.fillStyle = 'rgba(48,27,12,.72)'; g.fill(); g.lineWidth = 4; g.strokeStyle = '#3a2210'; g.stroke();
    g.font = '800 22px sans-serif'; g.fillStyle = '#f6e3c4';
    g.textAlign = 'center'; g.fillText('PERINGKAT', 112, 190); g.textAlign = 'left'; g.fillText('NAMA', 190, 190); g.textAlign = 'right'; g.fillText('DITANGKAP', W - 70, 190);
    var list = (lbData && lbData.c) ? lbData.c.slice(0, 5) : [], msg = '';
    if (!netUp()) msg = 'Belum tersambung ke server'; else if (!lbData) msg = 'Memuat peringkat...'; else if (!list.length) msg = 'Belum ada data';
    if (msg) { g.textAlign = 'center'; g.font = '800 38px sans-serif'; g.fillStyle = '#f1d9b4'; g.fillText(msg, W / 2, 390); }
    var col = ['#ffd84a', '#e3ebf5', '#f0a165', '#f5ecd8', '#f5ecd8'];
    list.forEach(function (e, n) {
      var y = 208 + n * 76, nm = String(e[0]);
      rr(g, 56, y, W - 112, 68, 12);
      var rg = g.createLinearGradient(0, y, 0, y + 68);
      if (n === 0) { rg.addColorStop(0, '#b88a3a'); rg.addColorStop(1, '#7c5418'); } else { rg.addColorStop(0, '#936139'); rg.addColorStop(1, '#6b4223'); }
      g.fillStyle = rg; g.fill(); g.lineWidth = 3; g.strokeStyle = '#3a2210'; g.stroke();
      g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = '900 52px sans-serif';
      strokeFill(g, String(n + 1), 112, y + 36, col[n], '#2a1805', 9);
      var hh = lbHue(nm);
      rr(g, 170, y + 8, 52, 52, 8); var ag = g.createLinearGradient(170, y, 222, y + 60); ag.addColorStop(0, 'hsl(' + hh + ',72%,62%)'); ag.addColorStop(1, 'hsl(' + ((hh + 40) % 360) + ',70%,30%)');
      g.fillStyle = ag; g.fill(); g.lineWidth = 3; g.strokeStyle = '#20120a'; g.stroke();
      g.font = '900 30px sans-serif'; g.fillStyle = '#fff'; g.fillText((nm.charAt(0) || '?').toUpperCase(), 196, y + 36);
      g.textAlign = 'left'; g.font = '900 36px sans-serif'; if (nm.length > 18) nm = nm.slice(0, 17) + '…';
      g.shadowColor = 'rgba(0,0,0,.6)'; g.shadowBlur = 4; g.shadowOffsetY = 3; g.fillStyle = '#fff'; g.fillText(nm, 240, y + 36);
      g.textAlign = 'right'; g.fillText(fmtC(e[1]), W - 76, y + 36);
      g.shadowColor = 'transparent'; g.shadowBlur = 0; g.shadowOffsetY = 0;
    });
    lbTex.needsUpdate = true;
  }
  var lbBoard = new T.Group(); lbBoard.position.set(LBB.x, C.DECK_Y, LBB.z); C.town.add(lbBoard);
  var lbWood = new T.MeshLambertMaterial({ color: 0x5a3a1e });
  [-1.55, 1.55].forEach(function (px) { var p = new T.Mesh(new T.BoxGeometry(0.2, 2.0, 0.2), lbWood); p.position.set(px, 1.0, -0.05); lbBoard.add(p); });
  var lbFrame = new T.Mesh(new T.BoxGeometry(3.7, 2.35, 0.14), lbWood); lbFrame.position.set(0, 1.9, 0); lbBoard.add(lbFrame);
  var lbFace = new T.Mesh(new T.PlaneGeometry(3.5, 2.19), new T.MeshBasicMaterial({ map: lbTex })); lbFace.position.set(0, 1.9, 0.075); lbBoard.add(lbFace);
  var lbRoof = new T.Mesh(new T.BoxGeometry(3.95, 0.12, 0.42), lbWood); lbRoof.position.set(0, 3.12, 0.05); lbBoard.add(lbRoof);
  C.TOWN_COLLIDERS.push({ x: LBB.x, z: LBB.z, r: 1.75 });
  C.TOWN_SHOPS.push({ id: 'lboard', name: 'PERINGKAT', label: 'Lihat Peringkat', x: LBB.x, z: LBB.z + 0.6, action: function () { openLB(); mLB.open(); } });
  var lbKey = '';
  function lbBoardTick() {
    var k = (netUp() ? '1' : '0') + (lbData && lbData.c ? JSON.stringify(lbData.c.slice(0, 5)) : '-');
    if (k !== lbKey) { lbKey = k; drawLB(); }
  }
  drawLB(); setInterval(lbBoardTick, 2000);
  setInterval(function () {
    var p = C.player.position;
    if (netUp() && Math.hypot(p.x - LBB.x, p.z - LBB.z) < 16) netSend({ t: 'lbget' });
  }, 30000);
  setTimeout(function () { if (netUp()) netSend({ t: 'lbget' }); }, 7000);
  function openLB() { netSend({ t: 'lbget' }); renderLB(); }
  window.PMOpenLB = function () { openLB(); mLB.open(); };
  function lbReport() {
    if (!netUp()) return;
    var s = S(), t = st(), best = (s.rec || [])[0], tr = 0;
    Object.keys(s.ach || {}).forEach(function (k) { if (s.ach[k]) tr++; });
    netSend({ t: 'stat', c: t.catches, w: best ? best.w : 0, wf: best ? best.n : '', rb: s.rebirth || 0, lv: s.level || 1, tr: tr });
  }
  setInterval(lbReport, 45000); setTimeout(lbReport, 8000);

  /* --- pasar pemain --- */
  var mM = mkModal('modalMarket', 'Pasar Pemain'), mkData = null, mkTab = 'buy', mkMult = 1, pend = {}, busy = false;
  function newRid() { return 'r' + Date.now().toString(36) + Math.floor(Math.random() * 1e4).toString(36); }
  function startReq(o) {
    if (!netUp()) { C.toast('Belum tersambung ke server'); return null; }
    if (busy) { C.toast('Tunggu proses sebelumnya'); return null; }
    busy = true; setTimeout(function () { busy = false; }, 12000);
    var r = newRid(); pend[r] = o; return r;
  }
  function renderMK() {
    var s = S(), h = '<div class="pm42Tabs">' + [['buy', 'Beli'], ['sell', 'Jual'], ['me', 'Saya']].map(function (t) {
      return '<button class="rowBtn' + (mkTab === t[0] ? ' owned' : '') + '" data-mt="' + t[0] + '" style="flex:1">' + t[1] + '</button>';
    }).join('') + '</div>';
    if (!netUp()) h += '<div class="rowSub" style="text-align:center;padding:14px">Belum tersambung ke server.</div>';
    else if (!mkData) h += '<div class="rowSub" style="text-align:center;padding:14px">Memuat pasar...</div>';
    else if (mkTab === 'buy') {
      var any = false;
      mkData.list.forEach(function (l) {
        if (l.mine) return;
        var f = fishById(l.f), mu = mutById(l.mu); if (!f || !mu) return; any = true;
        var e = { fish: f, mutation: mu };
        h += row(icon(e), escH(lbl(e)), C.RARITY_LABEL[f.rarity] + ' • ' + fmt(l.price) + ' koin • oleh ' + escH(l.s),
          '<button class="rowBtn" data-buy="' + l.id + '" data-price="' + l.price + '"' + (s.coins < l.price ? ' disabled' : '') + '>Beli</button>');
      });
      if (!any) h += '<div class="rowSub" style="text-align:center;padding:14px">Belum ada barang dari pemain lain.</div>';
    } else if (mkTab === 'sell') {
      h += '<div class="rowSub" style="margin-bottom:6px">Harga jual = nilai ikan x pengali. Biaya pasar 5% dipotong dari hasil.</div><div class="pm42Tabs">' +
        [1, 1.5, 2, 3].map(function (m) { return '<button class="rowBtn' + (mkMult === m ? ' owned' : '') + '" data-mm="' + m + '" style="flex:1">x' + m + '</button>'; }).join('') + '</div>';
      var any2 = false;
      Object.keys(s.inventory).forEach(function (k) {
        var e = s.inventory[k]; if (!e || e.count <= 0 || !e.fish || !e.mutation) return; any2 = true;
        var price = Math.min(5000000, Math.max(10, Math.round(e.fish.value * (e.mutation.mult || 1) * mkMult)));
        h += row(icon(e), escH(lbl(e)), 'x' + e.count + ' • ' + C.RARITY_LABEL[e.fish.rarity] + ' • pasang ' + fmt(price) + ' koin',
          '<button class="rowBtn" data-put="' + escH(k) + '" data-price="' + price + '">Pasang</button>');
      });
      if (!any2) h += '<div class="rowSub" style="text-align:center;padding:14px">Tas kosong.</div>';
    } else {
      h += row('', 'Hasil penjualan', fmt(mkData.pay || 0) + ' koin' + (mkData.mail ? ' • ' + mkData.mail + ' barang kembali' : ''),
        '<button class="rowBtn" data-collect="1"' + ((mkData.pay || mkData.mail) ? '' : ' disabled') + '>Ambil</button>');
      h += '<div class="rowName" style="margin-top:6px">Listing kamu</div>';
      var any3 = false;
      mkData.list.forEach(function (l) {
        if (!l.mine) return;
        var f = fishById(l.f), mu = mutById(l.mu); if (!f || !mu) return; any3 = true;
        var e = { fish: f, mutation: mu };
        h += row(icon(e), escH(lbl(e)), fmt(l.price) + ' koin', '<button class="rowBtn" data-cancel="' + l.id + '">Batal</button>');
      });
      if (!any3) h += '<div class="rowSub">Belum ada listing.</div>';
    }
    mM.body.innerHTML = h; mM.foot.textContent = 'Koin: ' + fmt(s.coins);
  }
  function openMK() { netSend({ t: 'mget', u: UID }); renderMK(); }
  mM.body.addEventListener('click', function (ev) {
    var b = ev.target.closest('button'); if (!b || b.disabled) return; var s = S(), d = b.dataset, r;
    if (d.mt) { mkTab = d.mt; renderMK(); return; }
    if (d.mm) { mkMult = +d.mm; renderMK(); return; }
    if (d.put) {
      var e = s.inventory[d.put]; if (!e || e.count <= 0) return;
      r = startReq({ k: 'list', key: d.put, f: e.fish.id, mu: e.mutation.id }); if (!r) return;
      e.count--; C.persist(); C.refresh();
      netSend({ t: 'mput', rid: r, u: UID, f: e.fish.id, mu: e.mutation.id, price: +d.price });
      renderMK();
    } else if (d.buy) {
      var price = +d.price; if (s.coins < price) return;
      r = startReq({ k: 'buy', price: price }); if (!r) return;
      s.coins -= price; C.persist(); C.refresh();
      netSend({ t: 'mbuy', rid: r, u: UID, id: +d.buy });
      renderMK();
    } else if (d.cancel) {
      r = startReq({ k: 'cancel' }); if (!r) return;
      netSend({ t: 'mcancel', rid: r, u: UID, id: +d.cancel });
    } else if (d.collect) {
      r = startReq({ k: 'collect' }); if (!r) return;
      netSend({ t: 'mcollect', rid: r, u: UID });
    }
  });

  /* --- router pesan server --- */
  window.PMLB = { on: function (m) {
    var s = S(), q;
    if (m.t === 'lb') { lbData = m; if (mLB.ov.classList.contains('show')) renderLB(); }
    else if (m.t === 'mlist') { mkData = m; if (mM.ov.classList.contains('show')) renderMK(); }
    else if (m.t === 'mok') { delete pend[m.rid]; busy = false; C.toast('Barang dipasang di pasar'); netSend({ t: 'mget', u: UID }); }
    else if (m.t === 'mfail') {
      q = pend[m.rid]; delete pend[m.rid]; busy = false;
      if (q && q.k === 'list') { var e = s.inventory[q.key]; if (e) e.count++; else addItem(q.f, q.mu); }
      else if (q && q.k === 'buy') s.coins += q.price;
      C.toast('Gagal: ' + (m.why || 'ditolak')); C.persist(); C.refresh(); renderMK();
    }
    else if (m.t === 'mbought') {
      q = pend[m.rid]; delete pend[m.rid]; busy = false;
      if (q && q.k === 'buy') s.coins += q.price - m.price;
      if (addItem(m.f, m.mu)) { var fb = fishById(m.f); C.toast('Dibeli: ' + (fb ? fb.name : m.f)); C.Sfx.sell(); }
      else s.coins += m.price;
      C.persist(); C.refresh(); netSend({ t: 'mget', u: UID });
    }
    else if (m.t === 'mcancelled') {
      delete pend[m.rid]; busy = false; addItem(m.f, m.mu); C.toast('Listing dibatalkan, barang kembali ke tas');
      C.persist(); C.refresh(); netSend({ t: 'mget', u: UID });
    }
    else if (m.t === 'mpay') {
      delete pend[m.rid]; busy = false; var n = 0;
      s.coins += Math.max(0, Math.min(+m.coins || 0, 1e9));
      (m.items || []).forEach(function (it) { if (addItem(it.f, it.mu)) n++; });
      C.toast((m.coins || n) ? 'Diambil: +' + fmt(m.coins || 0) + ' koin' + (n ? ' • ' + n + ' barang' : '') : 'Belum ada yang bisa diambil');
      C.persist(); C.refresh(); netSend({ t: 'mget', u: UID });
    }
    else if (m.t === 'msold') { C.toast('Barangmu terjual! Ambil ' + fmt(m.coins) + ' koin di Pasar Pemain > Saya'); C.Sfx.sell(); }
  } };

  /* ===== LOOP + MENU ===== */
  var last = 0, lx = 0, lz = 0, achT = 0;
  C.hookAnim(function (t) {
    var dt = Math.min(0.1, t - last); last = t;
    applyRod(t); applyCos(); evTick(t);
    var p = C.player.position;
    if (sailing) {
      boat.position.x = p.x; boat.position.z = p.z; boatE.x = p.x; boatE.z = p.z;
      var dx = p.x - lx, dz = p.z - lz;
      if (dx * dx + dz * dz > 1e-5) { var d = Math.atan2(dx, dz) - boat.rotation.y; d = Math.atan2(Math.sin(d), Math.cos(d)); boat.rotation.y += d * Math.min(1, dt * 6); }
    }
    lx = p.x; lz = p.z;
    if (t - achT > 2) { achT = t; checkAch(); }
  });
  function addMenu() {
    var host = $('menuPanel') || $('hudPills'); if (!host) return;
    [['Trofi', renderT, mT], ['Karakter', renderChar, mC], ['Pasar', renderP, mP], ['Rekor', renderR, mR], ['Pasar Pemain', openMK, mM]].forEach(function (x) {
      var b = document.createElement('button'); b.className = 'hudPill'; b.textContent = x[0];
      b.onclick = function () { var mp = $('menuPanel'); if (mp) mp.classList.remove('show'); x[1](); x[2].open(); };
      host.appendChild(b);
    });
  }
  if (document.readyState === 'complete') addMenu(); else window.addEventListener('load', addMenu);
};
</script>
<!-- /pm-ext -->
<script src="three.min.js"></script>
<script>window.THREE || document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>');</script>
<script>
// ================= PENGAMAN LOADING SCREEN (paling awal, di luar kode game) =================
// Nangkep error apa pun yang bikin skrip berhenti sebelum boot() sempat jalan,
// nampilin pesannya di layar loading (biar ketauan dari screenshot, gak perlu console),
// dan maksa loading screen ilang setelah 12 detik walau ada yang gagal, biar gak nyangkut selamanya.
(function () {
  function showBootError(msg) {
    const el = document.getElementById('loadingLabel');
    if (el) { el.textContent = 'Error: ' + msg; el.style.color = '#ff8a7a'; }
  }
  window.addEventListener('error', (e) => showBootError((e.error && e.error.message) || e.message || 'gagal jalan'));
  window.addEventListener('unhandledrejection', (e) => showBootError((e.reason && e.reason.message) || String(e.reason)));
  setTimeout(() => {
    const scr = document.getElementById('loadingScreen');
    if (scr && scr.style.display !== 'none' && !scr.classList.contains('hidden')) {
      console.warn('Loading screen dipaksa ditutup (watchdog 12 detik)');
      scr.classList.add('hidden');
      setTimeout(() => { scr.style.display = 'none'; }, 500);
    }
  }, 12000);
})();
</script>



<!-- MULTIPLAYER -->
<script>
(function () {
  var DEFAULT_SERVER = 'wss://game.ahmadfivem.my.id'; // alamat server buat player publik (wajib wss://)
  var prev = window.PMExt;
  window.PMExt = function (C) {
    if (prev) { try { prev(C); } catch (e) { console.warn('PMExt lama gagal:', e); } }
    try { init(C); } catch (e) { console.warn('Multiplayer gagal:', e); }
  };
  function LS(k, v) { try { if (v === undefined) return localStorage.getItem(k); if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) {} return null; }

  function init(C) {
    var T = THREE, $ = function (i) { return document.getElementById(i); };
    var profile = null; try { profile = JSON.parse(LS('pm_profile') || 'null'); } catch (e) {}
    var devToken = LS('pm_dev_token');
    var isDev = false, why = '', ws = null, myId = null, retry = 0, started = false, blocked = false, remotes = {}, selfG = null;
    var sendT = 0, keepT = 0, lx = 0, lz = 0, lry = 0, lt = 0, gender = null, taps = 0, tapT = 0;

    var st = document.createElement('style');
    st.textContent = '#mpSetup{position:fixed;inset:0;z-index:45;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:rgba(2,8,14,.88);padding:16px;text-align:center}' +
      '#mpSetup h2{margin:0;font-size:20px}#mpSetup .row{display:flex;gap:10px}' +
      '#mpSetup button{padding:12px 22px;border-radius:14px;border:2px solid rgba(255,255,255,.3);background:rgba(255,255,255,.08);color:#fff;font-weight:700;font-size:15px}' +
      '#mpSetup button.sel{border-color:var(--gold);background:rgba(255,207,77,.22)}' +
      '#mpSetup input{padding:12px 14px;border-radius:12px;border:2px solid rgba(255,255,255,.3);background:rgba(0,0,0,.35);color:#fff;font-size:16px;text-align:center;width:min(260px,80vw)}' +
      '#mpSetup #mpGo{background:linear-gradient(90deg,var(--accent),var(--accent2));color:#052730;border:none}#mpMsg{min-height:18px;color:var(--danger);font-size:13px}' +
      '#mpBadge{position:fixed;left:8px;bottom:8px;z-index:25;font-size:11px;padding:3px 8px;border-radius:999px;background:rgba(0,0,0,.45);display:none}';
    st.textContent += '#mpDevBtn{position:fixed;left:8px;bottom:34px;z-index:26;width:38px;height:38px;border-radius:50%;border:2px solid var(--gold);background:rgba(0,0,0,.55);font-size:18px;display:none}#mpDevPanel{position:fixed;inset:0;z-index:46;display:none;align-items:center;justify-content:center;background:rgba(2,8,14,.7);padding:12px}#mpDevPanel .mpBox{width:min(92vw,380px);max-height:86vh;overflow:auto;background:var(--panel);border:1px solid var(--panel-border-strong);border-radius:16px;padding:14px;display:flex;flex-direction:column;gap:10px}#mpDevPanel h3{margin:0}.mpP{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.1)}.mpSm{font-size:12px;color:var(--text-dim)}.mpRow{display:flex;gap:6px}.mpRow input{flex:1;min-width:0;padding:8px;border-radius:10px;border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.35);color:#fff}#mpDevPanel button{padding:7px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);color:#fff;font-weight:700;margin-left:4px}';
    st.textContent += '#mpChatBtn{position:fixed;left:8px;top:158px;z-index:26;width:38px;height:38px;border-radius:50%;border:2px solid rgba(255,255,255,.4);background:rgba(0,0,0,.55);font-size:18px;display:none}#mpChatRow{position:fixed;left:54px;top:158px;z-index:27;display:none;gap:6px;width:min(66vw,320px)}#mpChatRow input{flex:1;min-width:0;padding:8px 10px;border-radius:12px;border:1px solid rgba(255,255,255,.35);background:rgba(0,0,0,.6);color:#fff;font-size:14px}#mpChatRow button{padding:8px 12px;border-radius:12px;border:none;background:linear-gradient(90deg,var(--accent),var(--accent2));color:#052730;font-weight:700}#mpChatLog{position:fixed;left:8px;top:204px;z-index:24;width:min(62vw,300px);pointer-events:none;font-size:12px;text-shadow:0 1px 2px #000;display:flex;flex-direction:column;gap:2px}.mpC{background:rgba(0,0,0,.35);border-radius:8px;padding:2px 8px;color:#fff;word-break:break-word}#mpGate{position:fixed;inset:0;z-index:60;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:rgba(2,8,14,.95);padding:20px;text-align:center}#mpGate h2{margin:0;font-size:22px}#mpGate .row{display:flex;gap:10px}#mpGate button{padding:12px 22px;border-radius:14px;border:none;background:linear-gradient(90deg,var(--accent),var(--accent2));color:#052730;font-weight:700;font-size:15px}';
    document.head.appendChild(st);
    var ov = document.createElement('div'); ov.id = 'mpSetup';
    ov.innerHTML = '<h2 id="mpTitle">Buat Karakter</h2><div class="row"><button id="mpM">♂ Cowok</button><button id="mpF">♀ Cewek</button></div>' +
      '<input id="mpName" maxlength="16" placeholder="Username (3-16 huruf/angka/_)" autocomplete="off"><div id="mpMsg"></div><button id="mpGo">Lanjut</button>';
    document.body.appendChild(ov);
    var badge = document.createElement('div'); badge.id = 'mpBadge'; document.body.appendChild(badge);
    function msg(t) { $('mpMsg').textContent = t || ''; }
    function showSetup(t) { msg(t); ov.style.display = 'flex'; }
    function setBadge(on, n) { badge.textContent = on ? '🟢 Online: ' + n : '⚪ Offline · b' + BUILD + (why ? ' · ' + why : ''); }

    function pick(g) { gender = g; $('mpM').className = g === 'm' ? 'sel' : ''; $('mpF').className = g === 'f' ? 'sel' : ''; }
    $('mpM').onclick = function () { pick('m'); }; $('mpF').onclick = function () { pick('f'); };
    $('mpGo').onclick = function () {
      var n = $('mpName').value.trim();
      if (!gender) return msg('Pilih cowok atau cewek dulu');
      if (!/^[A-Za-z0-9_]{3,16}$/.test(n)) return msg('Username 3-16 karakter: huruf, angka, _');
      profile = { name: n, gender: gender }; LS('pm_profile', JSON.stringify(profile));
      ov.style.display = 'none'; resume();
    };
    $('mpTitle').onclick = function () { // rahasia developer: tap judul 7x
      var now = Date.now(); taps = now - tapT > 10000 ? 1 : taps + 1; tapT = now;
      if (taps < 7) return; taps = 0;
      var tok = prompt('Kode developer:'); if (tok) { devToken = tok.trim(); LS('pm_dev_token', devToken); }
      var sv = prompt('Alamat server (kosongkan = default):', LS('pm_server') || DEFAULT_SERVER); if (sv) LS('pm_server', sv.trim());
      if (devToken) { ov.style.display = 'none'; resume(); }
    };
    function resume() { blocked = false; if (started && !ws) open(); }
    var ss = $('startScreen');
    function needSetup() { if (!profile && !devToken && ss.style.display === 'flex') showSetup(); }
    new MutationObserver(needSetup).observe(ss, { attributes: true, attributeFilter: ['style'] }); needSetup();
    $('startBtn').addEventListener('click', function () { started = true; badge.style.display = 'block'; setBadge(false); open(); });

    // ---------- gerbang maintenance / update ----------
    var BUILD = parseInt('__PM_BUILD__', 10) || 0; // diisi otomatis oleh workflow GitHub
    var DL = 'https://github.com/Julakk/BlockWorld/releases/latest', dismissedB = 0; // link cadangan = halaman rilis
    var gate = document.createElement('div'); gate.id = 'mpGate'; document.body.appendChild(gate);
    function showGate(k, title, text, btns) {
      gate.innerHTML = '<h2></h2><div class="mpSm"></div><div class="row"></div>'; gate.dataset.k = k;
      gate.children[0].textContent = title; gate.children[1].textContent = text || '';
      btns.forEach(function (b) { var e = document.createElement('button'); e.textContent = b[0]; e.onclick = b[1]; gate.children[2].appendChild(e); });
      if (k === 'm') { var au = document.createElement('div'); au.className = 'mpAuto'; au.textContent = 'Dicek otomatis tiap 10 detik, layar ini hilang sendiri kalau server sudah buka.'; gate.appendChild(au); }
      gate.style.display = 'flex';
    }
    function hideGate() { gate.style.display = 'none'; }
    function checkStatus() {
      var c = new AbortController(), to = setTimeout(function () { c.abort(); }, 5000);
      var url = (LS('pm_server') || DEFAULT_SERVER).replace(/^ws/, 'http').replace(/\/+$/, '') + '/status';
      fetch(url, { signal: c.signal }).then(function (r) { return r.json(); }).then(function (s) {
        clearTimeout(to);
        if (s.maint && !devToken) return showGate('m', '🔧 Sedang maintenance', s.msg || 'Server lagi diperbaiki, coba lagi sebentar lagi.', [['Coba lagi', function () { hideGate(); checkStatus(); }]]);
        if (BUILD && s.latest > BUILD && (s.min > BUILD || dismissedB !== s.latest)) {
          var force = s.min > BUILD;
          showGate('u', '⬆ Update tersedia', 'Versi baru (build ' + s.latest + ') sudah ada.' + (force ? ' Update dulu supaya bisa main.' : ''),
            [['Download', function () { location.href = s.url || DL; }]].concat(force ? [] : [['Nanti', function () { dismissedB = s.latest; hideGate(); }]]));
        }
      }).catch(function () { clearTimeout(to); });
    }
    checkStatus();
    setInterval(function () { if (gate.style.display !== 'flex') checkStatus(); }, 180000); // cek update/maintenance tiap 3 menit
    function pollMaint() { // layar maintenance hilang sendiri begitu server buka lagi
      if (gate.dataset.k !== 'm' || gate.style.display !== 'flex') return;
      var c = new AbortController(), to = setTimeout(function () { c.abort(); }, 5000);
      var url = (LS('pm_server') || DEFAULT_SERVER).replace(/^ws/, 'http').replace(/\/+$/, '') + '/status';
      fetch(url, { signal: c.signal }).then(function (r) { return r.json(); }).then(function (s) {
        clearTimeout(to); if (!s.maint || devToken) { hideGate(); resume(); checkStatus(); }
      }).catch(function () { clearTimeout(to); });
    }
    setInterval(pollMaint, 10000);
    document.addEventListener('visibilitychange', function () { if (!document.hidden && gate.style.display !== 'flex') checkStatus(); });

    // ---------- chat ----------
    var cb = document.createElement('button'); cb.id = 'mpChatBtn'; cb.textContent = '💬'; document.body.appendChild(cb);
    var cr = document.createElement('div'); cr.id = 'mpChatRow'; document.body.appendChild(cr);
    cr.innerHTML = '<input id="mpChatIn" maxlength="100" placeholder="Ketik pesan..." autocomplete="off"><button id="mpChatGo">Kirim</button>';
    var cl = document.createElement('div'); cl.id = 'mpChatLog'; document.body.appendChild(cl);
    // ---------- chat publik 2 tab: Live Chat & Info Secret (v3.3) ----------
    var chatMsgs = [], secMsgs = [], tab = 'chat', unread = 0;
    var st3 = document.createElement('style');
    st3.textContent = '#mpTabs{position:fixed;left:8px;top:204px;z-index:27;display:none;gap:4px}#mpTabs button{position:relative;padding:5px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.55);color:#fff;font-size:12px;font-weight:700}#mpTabs button.on{background:linear-gradient(90deg,var(--accent),var(--accent2));color:#052730;border-color:transparent}#mpTabs button[data-k=sec].on{background:linear-gradient(90deg,#ffd54f,#ff9ad5)}#mpDot{display:none;width:9px;height:9px;border-radius:50%;background:#ff4d6d;position:absolute;top:-3px;right:-3px}#mpFeed{position:fixed;left:8px;top:238px;z-index:26;width:min(72vw,330px);max-height:34vh;overflow-y:auto;display:none;flex-direction:column;gap:3px;padding:4px;border-radius:12px;background:rgba(0,0,0,.35);font-size:12px;text-shadow:0 1px 2px #000;-webkit-overflow-scrolling:touch}.mpEmpty{color:#cfe;opacity:.7;padding:6px 8px}.mpS{border-radius:8px;padding:4px 8px;color:#fff;background:linear-gradient(90deg,rgba(255,213,79,.45),rgba(255,90,209,.35));border:1px solid rgba(255,224,102,.6)}.mpS small{opacity:.8;margin-left:6px}#mpChatBtn.dot::after{content:"";position:absolute;top:0;right:0;width:10px;height:10px;border-radius:50%;background:#ff4d6d}';
    document.head.appendChild(st3);
    var tabs = document.createElement('div'); tabs.id = 'mpTabs';
    tabs.innerHTML = '<button data-k="chat" class="on">💬 Live Chat</button><button data-k="sec">🌟 Info Secret<i id="mpDot"></i></button>';
    document.body.appendChild(tabs);
    var feed = document.createElement('div'); feed.id = 'mpFeed'; document.body.appendChild(feed);
    function isOpen() { return cr.style.display === 'flex'; }
    function hhmm(ts) { var d = new Date(ts || Date.now()); return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }
    function chatRow(m) {
      var d = document.createElement('div'); d.className = 'mpC';
      var n = document.createElement('b'); n.textContent = (m.dev ? '★ ' : '') + m.name + ': '; if (m.dev) n.style.color = '#ffcf4d';
      var t = document.createElement('span'); t.textContent = m.text; d.appendChild(n); d.appendChild(t); return d;
    }
    function secRow(m) {
      var d = document.createElement('div'); d.className = 'mpS';
      var b = document.createElement('b'); b.textContent = '🌟 ' + (m.dev ? '★ ' : '') + (m.id === myId ? 'Kamu' : m.name);
      var s = document.createElement('span'); s.textContent = ' mendapatkan ' + (m.mut ? m.mut + ' ' : '') + m.fish + (m.w ? ' (' + m.w + ' kg)' : '') + '!';
      var tm = document.createElement('small'); tm.textContent = hhmm(m.ts);
      d.appendChild(b); d.appendChild(s); d.appendChild(tm); return d;
    }
    function renderFeed() {
      var list = tab === 'chat' ? chatMsgs : secMsgs; feed.textContent = '';
      if (!list.length) { var e = document.createElement('div'); e.className = 'mpEmpty'; e.textContent = tab === 'chat' ? 'Belum ada obrolan.' : 'Belum ada yang dapat ikan Secret.'; feed.appendChild(e); }
      list.forEach(function (m) { feed.appendChild(tab === 'chat' ? chatRow(m) : secRow(m)); });
      feed.scrollTop = feed.scrollHeight;
    }
    function syncUI() {
      var o = isOpen(); if (o && tab === 'sec') unread = 0;
      tabs.style.display = o ? 'flex' : 'none'; feed.style.display = o ? 'flex' : 'none'; cl.style.display = o ? 'none' : 'flex';
      Array.prototype.forEach.call(tabs.querySelectorAll('button'), function (b) { b.className = b.getAttribute('data-k') === tab ? 'on' : ''; });
      $('mpDot').style.display = unread && tab !== 'sec' ? 'inline-block' : 'none';
      cb.className = unread && !o ? 'dot' : '';
      if (o) renderFeed();
    }
    tabs.onclick = function (e) { var k = e.target && e.target.getAttribute && e.target.getAttribute('data-k'); if (!k) return; tab = k; syncUI(); };
    cb.onclick = function () { cr.style.display = isOpen() ? 'none' : 'flex'; if (isOpen()) $('mpChatIn').focus(); syncUI(); };
    function addSecret(m, silent) {
      secMsgs.push(m); if (secMsgs.length > 40) secMsgs.shift();
      if (silent) return;
      if (isOpen() && tab === 'sec') renderFeed();
      else { unread++; syncUI(); }
      C.toast('🌟 ' + (m.id === myId ? 'Kamu' : m.name) + ' dapat ' + (m.mut ? m.mut + ' ' : '') + m.fish + (m.w ? ' (' + m.w + ' kg)' : '') + '!', 'secret');
    }
    function sendChat() { var v = $('mpChatIn').value.trim(); if (v && ws) { send({ t: 'chat', text: v }); $('mpChatIn').value = ''; } }
    $('mpChatGo').onclick = sendChat;
    $('mpChatIn').onkeydown = function (e) { e.stopPropagation(); if (e.key === 'Enter') sendChat(); };
    function addChat(m) {
      chatMsgs.push(m); if (chatMsgs.length > 60) chatMsgs.shift();
      if (isOpen()) { if (tab === 'chat') renderFeed(); return; }
      addChatFloat(m);
    }
    function addChatFloat(m) {
      var d = document.createElement('div'); d.className = 'mpC';
      var n = document.createElement('b'); n.textContent = (m.dev ? '★ ' : '') + m.name + ': '; if (m.dev) n.style.color = '#ffcf4d';
      var t = document.createElement('span'); t.textContent = m.text; d.appendChild(n); d.appendChild(t); cl.appendChild(d);
      while (cl.children.length > 6) cl.removeChild(cl.firstChild);
      setTimeout(function () { if (d.parentNode) d.parentNode.removeChild(d); }, 15000);
    }
    var maintOn = false;
    function setMaintBtn() { $('mpMaint').textContent = 'Maint: ' + (maintOn ? 'ON' : 'OFF'); }

    // ---------- panel developer (cuma muncul kalau server nganggep lo developer) ----------
    var esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); };
    var pb = document.createElement('button'); pb.id = 'mpDevBtn'; pb.textContent = '🛠'; document.body.appendChild(pb);
    var pn = document.createElement('div'); pn.id = 'mpDevPanel';
    pn.innerHTML = '<div class="mpBox"><h3>🛠 Panel Developer</h3><div id="mpDevList"></div><div class="mpRow"><input id="mpSay" maxlength="120" placeholder="Pengumuman ke semua player"><button id="mpSayGo">Kirim</button></div><div class="mpRow"><input id="mpMsg2" maxlength="120" placeholder="Pesan maintenance"><button id="mpMaint">Maint: OFF</button></div><button id="mpDevX">Tutup</button></div>';
    document.body.appendChild(pn);
    var lastH = '';
    function renderPanel() {
      var ids = Object.keys(remotes), h = '<div class="mpSm">Online: ' + (ids.length + 1) + ' (termasuk lo)</div>';
      ids.forEach(function (id) { var r = remotes[id];
        h += '<div class="mpP"><span>' + (r.gender === 'f' ? '♀ ' : '♂ ') + esc(r.name) + '</span><span><button data-a="tp" data-id="' + id + '">TP</button><button data-a="mute" data-id="' + id + '">Mute</button><button data-a="kick" data-id="' + id + '">Kick</button><button data-a="ban" data-id="' + id + '">Ban</button></span></div>'; });
      if (!ids.length) h += '<div class="mpSm">Belum ada player lain.</div>';
      if (h !== lastH) { lastH = h; $('mpDevList').innerHTML = h; }
    }
    pb.onclick = function () { pn.style.display = 'flex'; renderPanel(); };
    $('mpDevX').onclick = function () { pn.style.display = 'none'; };
    setInterval(function () { if (pn.style.display === 'flex') renderPanel(); }, 1000);
    $('mpDevList').onclick = function (e) {
      var b = e.target, a = b.getAttribute && b.getAttribute('data-a'), id = b.getAttribute && b.getAttribute('data-id'), r = remotes[id];
      if (!a || !r) return;
      if (a === 'tp') { C.player.position.set(r.g.position.x + 1, r.g.position.y, r.g.position.z + 1); pn.style.display = 'none'; }
      else if (a === 'mute') send({ t: 'mute', id: +id });
      else if (confirm((a === 'ban' ? 'Ban ' : 'Kick ') + r.name + '?')) send({ t: a, id: +id });
    };
    $('mpSayGo').onclick = function () { var v = $('mpSay').value.trim(); if (v) { send({ t: 'say', text: v }); $('mpSay').value = ''; } };
    $('mpMaint').onclick = function () { send({ t: 'maint', on: !maintOn, msg: $('mpMsg2').value.trim() }); };

    // ---------- koneksi ----------
    function send(o) { if (ws && ws.readyState === 1) ws.send(JSON.stringify(o)); }
    function open() {
      if (ws || blocked) return;
      if (!profile && !devToken) { why = 'belum ada profil'; return setBadge(false); }
      try { why = 'menyambung ' + (LS('pm_server') || DEFAULT_SERVER).replace(/^wss?:\/\//, ''); setBadge(false); ws = new WebSocket(LS('pm_server') || DEFAULT_SERVER); } catch (e) { ws = null; why = 'error ' + e.message; setBadge(false); return later(); }
      var me = ws;
      me.onopen = function () { retry = 0; send({ t: 'join', name: profile && profile.name, gender: profile && profile.gender, token: devToken || undefined, cv: 2 }); };
      me.onmessage = function (ev) { var m; try { m = JSON.parse(ev.data); } catch (e) { return; } handle(m); };
      me.onclose = function (ev) { why = 'putus (' + (ev && ev.code) + ')'; if (ws === me) ws = null; myId = null; clearRemotes(); setBadge(false); pb.style.display = 'none'; cb.style.display = 'none'; cr.style.display = 'none'; syncUI(); later(); };
      me.onerror = function () {};
    }
    function later() { if (!started || blocked) return; retry++; setTimeout(open, Math.min(15000, 1500 * retry)); }
    function handle(m) {
      if (m.t === 'welcome') { myId = m.id; isDev = !!m.you.dev; pb.style.display = isDev ? 'block' : 'none'; maintOn = !!m.maint; setMaintBtn(); cb.style.display = 'block'; dressSelf(m.you); m.players.forEach(addRemote); (m.secrets || []).forEach(function (x) { addSecret(x, true); }); setBadge(true, m.n); flushSec(); }
      else if (m.t === 'join') { addRemote(m.p); setBadge(true, m.n); }
      else if (m.t === 'leave') { removeRemote(m.id); setBadge(true, m.n); }
      else if (m.t === 'state') m.s.forEach(function (a) { var r = remotes[a[0]]; if (r) { r.x = a[1]; r.y = a[2]; r.z = a[3]; r.ry = a[4]; r.mv = a[5]; } });
      else if (m.t === 'say') C.toast('📢 ' + m.text);
      else if (m.t === 'chat') addChat(m);
      else if (m.t === 'secret') addSecret(m);
      else if (/^(lb|boss|bossr|mlist|mok|mfail|mbought|mcancelled|mpay|msold|aqs|aqpay)$/.test(m.t)) { if (window.PMLB) window.PMLB.on(m); }
      else if (m.t === 'maint') { maintOn = !!m.on; setMaintBtn(); if (m.on && !isDev && !devToken) showGate('m', '🔧 Sedang maintenance', m.msg || 'Server lagi maintenance.', [['Coba lagi', function () { hideGate(); checkStatus(); }]]); else if (!m.on && gate.dataset.k === 'm') hideGate(); }
      else if (m.t === 'kicked') { blocked = true; C.toast(m.msg); }
      else if (m.t === 'err') {
        if (m.code === 'bad_token') { devToken = null; LS('pm_dev_token', null); }
        if (m.code === 'bad_token' || m.code === 'bad_name' || m.code === 'name_taken') { blocked = true; if (m.code !== 'bad_token') { profile = null; LS('pm_profile', null); } showSetup(m.msg); }
        if (m.code === 'maint') { blocked = true; showGate('m', '🔧 Sedang maintenance', m.msg, [['Coba lagi', function () { hideGate(); blocked = false; resume(); checkStatus(); }]]); }
        if (m.code === 'banned') blocked = true;
        C.toast(m.msg);
      }
    }

    var pendSec = [];
    function flushSec() { // kirim antrian Secret (tiap satu didahului 'cast' biar lolos cek server)
      if (!pendSec.length || !(ws && ws.readyState === 1)) return;
      var p = pendSec.shift(); send({ t: 'cast' });
      setTimeout(function () { if (ws && ws.readyState === 1) send(p); else pendSec.unshift(p); flushSec(); }, 4100);
    }
    window.PMNet = { raw: function (o) { send(o); }, up: function () { return !!(ws && ws.readyState === 1); }, cast: function () { if (ws && ws.readyState === 1) send({ t: 'cast' }); }, secret: function (o) {
      var p = { t: 'secret', id: o.id, w: Math.round((+o.w || 0) * 10) / 10, mut: o.mut ? String(o.mut).slice(0, 20) : '' };
      if (ws && ws.readyState === 1) send(p); else { pendSec.push(p); if (pendSec.length > 3) pendSec.shift(); }
    } };

    // ---------- tampilan karakter ----------
    function mat(c) { return new T.MeshLambertMaterial({ color: c }); }
    function label(name, dev) {
      var c = document.createElement('canvas'); c.width = 320; c.height = 64; var x = c.getContext('2d');
      x.font = 'bold 28px sans-serif'; x.textAlign = 'center'; x.lineWidth = 6; x.strokeStyle = 'rgba(0,0,0,.75)';
      var t = (dev ? '★ ' : '') + name; x.strokeText(t, 160, 42); x.fillStyle = dev ? '#ffcf4d' : '#fff'; x.fillText(t, 160, 42);
      var s = new T.Sprite(new T.SpriteMaterial({ map: new T.CanvasTexture(c), transparent: true, fog: false, depthWrite: false }));
      s.scale.set(2.25, 0.45, 1); s.position.y = 2.15; return s;
    }
    function decor(g, p) { // aksesori: cewek (rambut panjang + gaun), developer (mahkota + jubah)
      function add(geo, m, x, y, z) { var o = new T.Mesh(geo, m); o.position.set(x, y, z); g.add(o); return o; }
      if (p.gender === 'f') {
        add(new T.CylinderGeometry(0.17, 0.12, 0.55, 10), mat(0x3a2a1a), 0, 1.3, -0.16);
        add(new T.CylinderGeometry(0.2, 0.38, 0.42, 14), mat(p.dev ? 0x7b3fe4 : 0xe8628f), 0, 0.56, 0);
      }
      if (p.dev) {
        var gold = new T.MeshLambertMaterial({ color: 0xffcf4d, emissive: 0x553300 });
        add(new T.CylinderGeometry(0.15, 0.2, 0.14, 6), gold, 0, 1.78, 0);
        var cape = add(new T.BoxGeometry(0.5, 0.85, 0.04), new T.MeshLambertMaterial({ color: 0xd8483a, side: T.DoubleSide }), 0, 0.95, -0.2); cape.rotation.x = 0.08;
      }
    }
    function dressSelf(p) {
      if (selfG) C.player.remove(selfG);
      selfG = new T.Group(); decor(selfG, p); selfG.add(label(p.name, p.dev)); C.player.add(selfG);
      if (p.dev) { try { C.body.material.color.set(0x7b3fe4); } catch (e) {} }
    }
    function avatar(p) {
      var g = new T.Group(), fem = p.gender === 'f', dev = p.dev;
      var skin = mat(0xf0c299), shirt = mat(dev ? 0x7b3fe4 : fem ? 0xe8628f : 0x4ac0e0), pants = mat(dev ? 0x2a1a52 : 0x33485f);
      function add(geo, m, x, y, z) { var o = new T.Mesh(geo, m); o.position.set(x, y, z); g.add(o); return o; }
      add(new T.CylinderGeometry(0.25, 0.22, 0.65, 12), shirt, 0, 0.95, 0).scale.z = 0.66;
      add(new T.SphereGeometry(0.2, 14, 10), skin, 0, 1.5, 0);
      if (!fem) add(new T.SphereGeometry(0.21, 14, 10), mat(0x3a2a1a), 0, 1.53, -0.04);
      var leg = function (x) { return add(new T.CylinderGeometry(0.1, 0.09, 0.54, 8).translate(0, -0.27, 0), fem ? skin : pants, x, 0.62, 0); };
      var arm = function (x) { return add(new T.CylinderGeometry(0.07, 0.06, 0.5, 8).translate(0, -0.25, 0), shirt, x, 1.22, 0); };
      g.userData = { l: leg(-0.13), rl: leg(0.13), al: arm(-0.32), ar: arm(0.32) };
      decor(g, p); g.add(label(p.name, dev)); return g;
    }
    function addRemote(p) {
      if (p.id === myId || remotes[p.id]) return;
      var g = avatar(p); g.position.set(p.x, p.y, p.z); g.rotation.y = p.ry; C.scene.add(g);
      remotes[p.id] = { name: p.name, gender: p.gender, g: g, x: p.x, y: p.y, z: p.z, ry: p.ry, mv: 0, ph: 0 };
    }
    function removeRemote(id) { var r = remotes[id]; if (r) { C.scene.remove(r.g); delete remotes[id]; } }
    function clearRemotes() { Object.keys(remotes).forEach(removeRemote); }

    // ---------- loop per frame ----------
    C.hookAnim(function (t) {
      var dt = Math.min(0.1, Math.max(0, t - lt)); lt = t; if (!dt) return;
      var k = Math.min(1, dt * 10);
      for (var id in remotes) {
        var r = remotes[id], g = r.g, u = g.userData;
        g.position.x += (r.x - g.position.x) * k; g.position.y += (r.y - g.position.y) * k; g.position.z += (r.z - g.position.z) * k;
        var d = r.ry - g.rotation.y; d = Math.atan2(Math.sin(d), Math.cos(d)); g.rotation.y += d * k;
        if (r.mv) r.ph += dt * 9;
        u.l.rotation.x += ((r.mv ? Math.sin(r.ph) * 0.6 : 0) - u.l.rotation.x) * k;
        u.rl.rotation.x = -u.l.rotation.x; u.al.rotation.x = -u.l.rotation.x; u.ar.rotation.x = u.l.rotation.x;
      }
      if (!myId || t - sendT < 0.1) return; sendT = t;
      var p = C.player.position, ry = C.player.rotation.y, moved = Math.hypot(p.x - lx, p.z - lz);
      if (moved < 0.02 && Math.abs(ry - lry) < 0.02 && t - keepT < 1) return;
      var rd = function (v) { return Math.round(v * 100) / 100; };
      send({ t: 'pos', x: rd(p.x), y: rd(p.y), z: rd(p.z), ry: rd(ry), mv: moved > 0.03 ? 1 : 0 });
      lx = p.x; lz = p.z; lry = ry; keepT = t;
    });
  }
})();
</script>

<script>
(function () {
  const isMobile = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;

  // ================= DATA IKAN =================
  // rarity dipakai buat warna & bobot dasar peluang. value = harga jual dasar (koin).
  const RARITY_COLOR = { common: '#b7c2c6', uncommon: '#5fd15f', rare: '#4fa3ff', epic: '#b45fe8', legendary: '#ffb03a', mythical: '#ff4fd8', secret: '#ffe066' };
  const RARITY_LABEL = { common: 'Biasa', uncommon: 'Lumayan', rare: 'Langka', epic: 'Epik', legendary: 'Legendaris', mythical: 'Mitos', secret: 'Rahasia' };
  const FISH_TABLE = [
    { id: 'teri', name: 'Ikan Teri', rarity: 'common', value: 4 },
    { id: 'mujair', name: 'Ikan Mujair', rarity: 'common', value: 7 },
    { id: 'lele', name: 'Ikan Lele', rarity: 'common', value: 10 },
    { id: 'nila', name: 'Ikan Nila', rarity: 'uncommon', value: 22 },
    { id: 'kakap', name: 'Ikan Kakap', rarity: 'uncommon', value: 32 },
    { id: 'tenggiri', name: 'Ikan Tenggiri', rarity: 'rare', value: 75 },
    { id: 'tuna', name: 'Ikan Tuna', rarity: 'rare', value: 110 },
    { id: 'hiu_kecil', name: 'Hiu Kecil', rarity: 'epic', value: 280 },
    { id: 'marlin', name: 'Ikan Marlin', rarity: 'epic', value: 420 },
    { id: 'naga_laut', name: 'Naga Laut', rarity: 'legendary', value: 1100 },
    { id: 'mutiara', name: 'Ikan Mutiara', rarity: 'legendary', value: 1700 },
    { id: 'leviathan', name: 'Leviathan', rarity: 'mythical', value: 5500 },
    { id: 'kraken_purba', name: 'Kraken Purba', rarity: 'secret', value: 50000 },
    { id: 'u_gabus', name: 'Ikan Gabus', rarity: 'uncommon', value: 28 },
    { id: 'u_toman', name: 'Ikan Toman', rarity: 'rare', value: 85 },
  ];
  const FISH_WEIGHT = { teri: [0.05, 0.3], mujair: [0.3, 1.2], lele: [0.8, 3], nila: [1, 6], kakap: [3, 15], tenggiri: [8, 40], tuna: [30, 250], hiu_kecil: [100, 800], marlin: [250, 1500], naga_laut: [800, 6000], mutiara: [500, 4000], leviathan: [5000, 60000], kraken_purba: [20000, 140000],
    bandeng: [0.3, 2], belanak: [0.2, 1.5], baronang: [0.4, 3], kerapu: [3, 60], ubur: [0.5, 12], kuda_laut: [0.02, 0.3], penyu: [60, 400],
    layur: [0.1, 2], kembung: [0.1, 0.9], lentera: [0.2, 3], todak: [20, 180], pari_manta: [200, 1500], hiu_martil: [150, 900],
    cumi_raksasa: [500, 3000], ikan_bulan: [800, 5000], paus_biru: [8000, 80000], megalodon: [25000, 150000],
    u_gabus: [0.5, 4], u_toman: [2, 20] };
  const ROD_WEIGHT = { bambu: 10, luckrod: 15, kayu: 20, grass: 250, karbon: 400, ice: 750, perak: 5000, midrod: 10000, steampunk: 25000, emas: 90000, legendaris: 160000, angler: 125000, dev: 1e9 };
  function hudAb(n) { // 19600 -> 19,6K ; 1000000000 -> 1B
    n = Math.round(+n) || 0;
    if (n < 10000) return String(n);
    const u = [[1e12, 'T'], [1e9, 'B'], [1e6, 'M'], [1e3, 'K']];
    for (let i = 0; i < u.length; i++) if (n >= u[i][0]) { const x = n / u[i][0]; return String(x >= 100 ? Math.round(x) : Math.round(x * 10) / 10).replace('.', ',') + u[i][1]; }
    return String(n);
  }
  function hudKg(w) { return w >= 10000 ? hudAb(w) + ' kg' : fmtKg(w); }
  function fmtKg(w) {
    if (w < 1) return Math.round(w * 1000) + ' g';
    if (w < 100) return (Math.round(w * 10) / 10) + ' kg';
    return String(Math.round(w)).replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' kg';
  }
  function assignWeight(c) {
    // v4.7: rentang berat ikan menyesuaikan kapasitas rod, dan condong ke ikan berat kalau luck rod + bait tinggi
    const wr = FISH_WEIGHT[c.fish.id] || [1, 2];
    const rod = currentRod(), bait = currentBait();
    const cap = ROD_WEIGHT[rod.id] || 10;
    const wm = (c.mutation && c.mutation.wmult) || 1;
    const lo = wr[0] * wm, hi = wr[1] * wm;
    c.tooHeavy = lo > cap;
    const top = c.tooHeavy ? hi : Math.max(lo, Math.min(hi, cap));
    const gp = Math.min(6, (rod.rarityBoost - 1) + (bait.rarityBoost - 1));
    const k = Math.max(0.55, 1.5 / (1 + 0.25 * gp));
    const w = lo + Math.pow(Math.random(), k) * (top - lo);
    c.weight = Math.round(w * 100) / 100;
  }
  function castRating(p) {
    if (p >= 0.78 && p < 0.90) return { n: 'PERFECT!', b: 0.6, c: '#ffc233' };
    if ((p >= 0.66 && p < 0.78) || (p >= 0.90 && p < 0.97)) return { n: 'AMAZING!', b: 0.35, c: '#4aa8ff' };
    if (p >= 0.45 && p < 0.66) return { n: 'GOOD', b: 0.15, c: '#7be86b' };
    return { n: 'MISS', b: 0, c: '#ff8a7a' };
  }
  function showCastRating(cr) {
    const el = document.getElementById('castRating'); if (!el) return;
    el.textContent = cr.n; el.style.color = cr.c;
    el.classList.remove('show'); void el.offsetWidth; el.classList.add('show');
  }
  function castLuckBonus() { const cr = castRating(lockedPower); showCastRating(cr); return cr.b; }
  const FISH_BY_RARITY = {};
  FISH_TABLE.forEach(f => { (FISH_BY_RARITY[f.rarity] = FISH_BY_RARITY[f.rarity] || []).push(f); });
  const MUTATIONS = [
    { id: 'normal', name: '', mult: 1, chance: 0.86, tint: null },
    { id: 'emas', name: 'Emas', mult: 4, chance: 0.06, tint: [255, 213, 74] },
    { id: 'pelangi', name: 'Pelangi', mult: 8, chance: 0.02, tint: 'rainbow' },
    { id: 'big', name: 'Besar', mult: 2.5, chance: 0.04, tint: null, wmult: 1.6 },
    { id: 'ghost', name: 'Hantu', mult: 6, chance: 0.02, tint: [196, 224, 255] },
  ];
  const SHINY_CHANCE = 0.04; // roll sendiri, bisa nempel ke mutasi lain
  const DEEP_R = 56;         // batas Laut Dalam (jarak dari pusat pulau)
  let castZone = 'umum';

  // ================= DATA JORAN & UMPAN =================
  const ROD_TIERS = [
    { id: 'bambu',      name: 'Starter Rod',   price: 0,     biteSpeed: 1.00, rarityBoost: 1.00, castRange: 7 },
    { id: 'luckrod',    name: 'Luck Rod',      price: 80,    biteSpeed: 1.02, rarityBoost: 1.50, castRange: 8 },
    { id: 'kayu',       name: 'Carbon Rod',    price: 150,   biteSpeed: 1.04, rarityBoost: 1.30, castRange: 9 },
    { id: 'grass',      name: 'Grass Rod',     price: 400,   biteSpeed: 1.05, rarityBoost: 1.55, castRange: 10 },
    { id: 'karbon',     name: 'Damascus Rod',  price: 600,   biteSpeed: 1.04, rarityBoost: 1.80, castRange: 11 },
    { id: 'ice',        name: 'Ice Rod',       price: 1200,  biteSpeed: 1.07, rarityBoost: 1.60, castRange: 12 },
    { id: 'perak',      name: 'Lucky Rod',     price: 2000,  biteSpeed: 1.07, rarityBoost: 2.40, castRange: 13 },
    { id: 'midrod',     name: 'Midnight Rod',  price: 3500,  biteSpeed: 1.10, rarityBoost: 2.00, castRange: 14 },
    { id: 'steampunk',  name: 'Steampunk Rod', price: 5500,  biteSpeed: 1.19, rarityBoost: 3.25, castRange: 15 },
    { id: 'emas',       name: 'Chrome Rod',    price: 9000,  biteSpeed: 1.23, rarityBoost: 3.80, castRange: 16 },
    { id: 'legendaris', name: 'Astral Rod',    price: 20000, biteSpeed: 1.23, rarityBoost: 4.00, castRange: 18 },
    { id: 'angler',     name: 'Angler Rod',    price: 40000, biteSpeed: 1.43, rarityBoost: 4.80, castRange: 20 },
  ];
  const AUTOFISH_PRICE = 2500;
  const BAIT_TYPES = [
    { id: 'biasa',    name: 'Starter Bait',     price: 5,     rarityBoost: 1.08, stock: 999 },
    { id: 'luck',     name: 'Luck Bait',        price: 40,    rarityBoost: 1.12, stock: 0 },
    { id: 'midnight', name: 'Midnight Bait',    price: 150,   rarityBoost: 1.22, stock: 0 },
    { id: 'super',    name: 'Nature Bait',      price: 500,   rarityBoost: 1.45, xp: 0.04, stock: 0 },
    { id: 'chroma',   name: 'Chroma Bait',      price: 1800,  rarityBoost: 2.00, stock: 0 },
    { id: 'ajaib',    name: 'Dark Matter Bait', price: 5000,  rarityBoost: 2.70, xp: 0.05, shiny: 0.05, stock: 0 },
    { id: 'corrupt',  name: 'Corrupt Bait',     price: 12000, rarityBoost: 3.20, mut: 0.10, shiny: 0.10, stock: 0 },
    { id: 'aether',   name: 'Aether Bait',      price: 25000, rarityBoost: 3.60, mut: 0.15, shiny: 0.05, stock: 0 },
  ];
  function baitExtra(b) { return (b.xp ? ' \u2022 XP +' + Math.round(b.xp * 100) + '%' : '') + (b.shiny ? ' \u2022 Shiny +' + Math.round(b.shiny * 100) + '%' : '') + (b.mut ? ' \u2022 Mutasi +' + Math.round(b.mut * 100) + '%' : ''); }

  // ================= PELUANG RARITAS =================
  // boost gabungan dari joran x umpan. Makin gede boost, makin condong ke ikan langka.
  const RARITY_ORDER = ['common', 'uncommon', 'rare', 'epic', 'legendary', 'mythical', 'secret'];
  const RARITY_BASE = [68, 20, 8.5, 2.7, 0.65, 0.15, 0.02]; // peluang dasar (joran bambu + umpan biasa) -- secret nyaris mustahil di gear awal
  const RARITY_MAXGEAR = [20, 28, 28, 16, 6.5, 1.3, 0.2]; // peluang di gear paling maksimal (jumlahnya tetap 100) -- secret tetap sangat jarang walau gear full
  // boost 1 = gear paling awal, MAX_BOOST = joran+umpan paling mahal. Di antaranya interpolasi lurus,
  // biar ikan mitos tetap kerasa "langka" walau udah gear terbaik (gak sampe lebih umum dari ikan biasa).
  const MAX_BOOST = 4.8 + 3.6 - 1;
  function rollRarity(boost) {
    const t = Math.max(0, Math.min(1, (boost - 1) / (MAX_BOOST - 1)));
    const shifted = RARITY_BASE.map((w, i) => w + (RARITY_MAXGEAR[i] - w) * t);
    const total = shifted.reduce((a, b) => a + b, 0);
    let r = Math.random() * total;
    for (let i = 0; i < RARITY_ORDER.length; i++) { if (r < shifted[i]) return RARITY_ORDER[i]; r -= shifted[i]; }
    return RARITY_ORDER[0];
  }
  function rollMutation() {
    const bt = currentBait(), mx = bt.mut || 0;
    let r = Math.random(), acc = 0, base = MUTATIONS[0];
    for (const m of MUTATIONS) { acc += m.id === 'normal' ? Math.max(0.1, m.chance - mx) : m.chance * (1 + mx / 0.14); if (r <= acc) { base = m; break; } }
    if (Math.random() < SHINY_CHANCE + (bt.shiny || 0)) {
      const sh = Object.assign({}, base);
      delete sh.chance;
      sh.id = base.id === 'normal' ? 'shiny' : 'shiny_' + base.id;
      sh.name = 'Shiny' + (base.name ? ' ' + base.name : '');
      sh.mult = base.mult * 3; sh.shiny = true;
      if (!base.tint) sh.tint = [120, 255, 240];
      return sh;
    }
    return base;
  }
  function rollFish(boost) {
    const deep = false;
    const rarity = rollRarity(boost + (deep ? 0.4 : 0));
    const all = FISH_BY_RARITY[rarity] || FISH_BY_RARITY.common;
    let pool = all.filter(f => !f.zone || f.zone === castZone);
    if (!pool.length) pool = all;
    const fish = pool[Math.floor(Math.random() * pool.length)];
    const mutation = rollMutation();
    return { fish, mutation, value: Math.round(fish.value * mutation.mult) };
  }

  // ================= SIMPAN / MUAT (localStorage) =================
  const GEAR_COLORS = {
    rod: { bambu: '#c2a94a', luckrod: '#4fcf6a', kayu: '#8a929a', grass: '#5bbf3a', karbon: '#cfd6dc', ice: '#7fd8ff', perak: '#4a8aff', midrod: '#6a5aff', steampunk: '#d8883a', emas: '#b56bff', legendaris: '#ffc233', angler: '#19d3c0' },
    bait: { biasa: '#9fb4bd', luck: '#5fd36b', midnight: '#4aa8ff', super: '#b56bff', chroma: '#ffc233', ajaib: '#ff4d6d', corrupt: '#b13cff', aether: '#7af0ff' }
  };
  const SAVE_KEY = 'pancingmania_save_v1';
  function defaultSave() {
    return { coins: 20, xp: 0, level: 1, rod: 'bambu', bait: 'biasa', ownedRods: ['bambu'], baitStock: { biasa: 999 }, inventory: {}, discovered: {}, autoFish: false, muted: false };
  }
  let save = defaultSave();
  function loadSave() {
    try {
      const raw = localStorage.getItem(SAVE_KEY);
      if (raw) save = Object.assign(defaultSave(), JSON.parse(raw));
      save.discovered = save.discovered || {};
      for (const k in save.inventory) { const e = save.inventory[k]; if (e && e.fish) save.discovered[e.fish.id] = true; }
    } catch (e) { console.warn('Gagal muat save, mulai baru:', e); save = defaultSave(); }
  }
  let saveTimer = null;
  function persistSave() {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      try { localStorage.setItem(SAVE_KEY, JSON.stringify(save)); } catch (e) { console.warn('Gagal simpan:', e); }
    }, 600);
  }

  function xpForLevel(lv) { return Math.round(40 * Math.pow(lv, 1.55)); }
  function addXp(amount) {
    save.xp += amount;
    let need = xpForLevel(save.level);
    while (save.xp >= need) { save.xp -= need; save.level++; need = xpForLevel(save.level); showToast('Naik ke Level ' + save.level + '!'); Sfx.levelUp(); vibe([40, 30, 40]); }
  }
  function currentRod() {
    const r = ROD_TIERS.find(x => x.id === save.rod) || ROD_TIERS[0];
    const en = save.enchants && save.enchants[r.id];
    if (!en) { const bx = pm4b(); if (!bx.luck && !bx.speed) return r; return Object.assign({}, r, { rarityBoost: r.rarityBoost + bx.luck, biteSpeed: r.biteSpeed * (1 + bx.speed) }); }
    return Object.assign({}, r, { rarityBoost: r.rarityBoost + (en.luck || 0) + pm4b().luck, biteSpeed: r.biteSpeed * (1 + (en.speed || 0) + pm4b().speed) });
  }
  /* PM_V40 rebirth + pet */
  function pm4b() { return window.PM4 ? window.PM4.bonus() : { luck: 0, speed: 0, sell: 0, xp: 0 }; }
  (function () {
    const RB = { luck: 0.05, speed: 0.04, sell: 0.10, xp: 0.10 };
    const LBL = { luck: 'Luck', speed: 'Speed', sell: 'Harga Jual', xp: 'XP' };
    const EGG = 2500;
    const PETS = [
      { id: 'camar', name: 'Camar', w: 40, t: 'Common', c: '#9fb4bd', b: { sell: 0.03 } },
      { id: 'kepiting', name: 'Kepiting', w: 28, t: 'Rare', c: '#4aa8ff', b: { speed: 0.04 } },
      { id: 'kucing', name: 'Kucing Dermaga', w: 18, t: 'Rare', c: '#4aa8ff', b: { luck: 0.04, xp: 0.04 } },
      { id: 'penyu', name: 'Penyu', w: 9, t: 'Epic', c: '#b56bff', b: { luck: 0.06, speed: 0.05, xp: 0.05 } },
      { id: 'lumba', name: 'Lumba-lumba', w: 4, t: 'Legendary', c: '#ffc233', b: { luck: 0.10, sell: 0.08, speed: 0.06 } },
      { id: 'naga', name: 'Naga Laut', w: 1, t: 'Mythic', c: '#ff4d6d', b: { luck: 0.15, speed: 0.10, sell: 0.15, xp: 0.15 } }
    ];
    const TITLES = [[10, 'Dewa Pancing'], [5, 'Legenda Laut'], [3, 'Penakluk'], [1, 'Perantau'], [0, 'Pemula']];
    let tab = 'rb', last = null, armed = false, armT = null;
    const rbN = () => save.rebirth || 0;
    const need = n => 30 + 5 * n;
    const slots = () => (rbN() >= 3 ? 2 : 1);
    const titleOf = n => (TITLES.find(t => n >= t[0]) || TITLES[4])[1];
    const stars = id => Math.min(5, (save.pets && save.pets[id]) || 0);
    const mult = s2 => 1 + 0.2 * (s2 - 1);
    function rbOnly(n) { const o = {}; for (const k in RB) o[k] = RB[k] * n; return o; }
    function bonus() {
      const o = rbOnly(rbN());
      (save.petEq || []).slice(0, slots()).forEach(id => {
        const p = PETS.find(x => x.id === id), st = stars(id); if (!p || !st) return;
        for (const k in p.b) o[k] = (o[k] || 0) + p.b[k] * mult(st);
      });
      return { luck: o.luck || 0, speed: o.speed || 0, sell: o.sell || 0, xp: o.xp || 0 };
    }
    function fmtB(b) { const q = []; for (const k in LBL) if (b[k]) q.push(LBL[k] + ' +' + Math.round(b[k] * 100) + '%'); return q.join(' • ') || '-'; }
    function roll() { let t = 0; PETS.forEach(p => { t += p.w; }); let r = Math.random() * t; for (const p of PETS) { if (r < p.w) return p; r -= p.w; } return PETS[0]; }
    function buyEgg() {
      if (save.coins < EGG) { showToast('Koin kurang buat Telur Pet'); return; }
      save.coins -= EGG; save.pets = save.pets || {}; save.petEq = save.petEq || [];
      const p = roll(), had = save.pets[p.id] || 0;
      save.pets[p.id] = had + 1;
      if (!had && save.petEq.length < slots()) save.petEq.push(p.id);
      last = { p: p, dup: had > 0 };
      Sfx.sell(); vibe(30);
      if (p.w <= 9) { Sfx.levelUp(); vibe([40, 30, 40]); }
      persistSave(); refreshHud(); render();
    }
    function equip(id) {
      save.petEq = save.petEq || [];
      const i = save.petEq.indexOf(id);
      if (i >= 0) save.petEq.splice(i, 1);
      else { if (save.petEq.length >= slots()) save.petEq.shift(); save.petEq.push(id); }
      persistSave(); render();
    }
    function doRebirth() {
      const n = rbN(); if ((save.level || 1) < need(n)) return;
      if (!armed) { armed = true; clearTimeout(armT); armT = setTimeout(function () { armed = false; render(); }, 4000); render(); return; }
      armed = false; clearTimeout(armT);
      save.rebirth = n + 1;
      save.coins = 20 + 500 * save.rebirth; save.level = 1; save.xp = 0;
      save.rod = 'bambu'; save.ownedRods = ['bambu']; save.bait = 'biasa'; save.baitStock = { biasa: 999 };
      persistSave(); refreshHud(); Sfx.levelUp(); vibe([60, 40, 60, 40, 120]);
      showToast('REBIRTH ke-' + save.rebirth + '! Gelar: ' + titleOf(save.rebirth));
      render();
    }
    function render() {
      const body = document.getElementById('pm4Body'); if (!body) return;
      const n = rbN(), lv = save.level || 1, nd = need(n), ok = lv >= nd;
      let h = '<div class="pm4Tabs"><button data-a="tab" data-v="rb" class="' + (tab === 'rb' ? 'on' : '') + '">Rebirth</button><button data-a="tab" data-v="pet" class="' + (tab === 'pet' ? 'on' : '') + '">Pet</button></div>';
      if (tab === 'rb') {
        h += '<div class="pm4Card"><div class="pm4Big">Rebirth ke-' + n + '</div><div class="pm4Sub">Gelar: <b>' + titleOf(n) + '</b></div>' +
          '<div class="pm4Sub" style="margin-top:6px;">Bonus permanen sekarang:<br><b>' + fmtB(rbOnly(n)) + '</b></div></div>';
        h += '<div class="pm4Card"><div class="pm4Sub">Tiap Rebirth menambah:<br><b>' + fmtB(RB) + '</b></div>' +
          '<div class="pm4Sub" style="margin-top:6px;">Direset: level, XP, koin, joran, umpan.<br>Tetap: tas ikan, koleksi, enchant, pet.</div>' +
          '<div class="pm4Sub" style="margin-top:6px;">Syarat: Level <b>' + nd + '</b> (kamu Level ' + lv + ')</div></div>';
        h += '<button class="pm4Btn" data-a="rebirth" ' + (ok ? '' : 'disabled') + '>' + (ok ? (armed ? 'YAKIN? Tap lagi buat Rebirth' : 'REBIRTH SEKARANG') : 'Belum cukup level') + '</button>';
      } else {
        h += '<div class="pm4Card"><div class="pm4Sub">Slot pet: <b>' + (save.petEq || []).length + '/' + slots() + '</b> (slot ke-2 terbuka di Rebirth 3). Pet duplikat menambah bintang, bonus naik 20% per bintang (maks 5).</div></div>';
        h += '<button class="pm4Btn" data-a="egg" ' + (save.coins < EGG ? 'disabled' : '') + '>Beli Telur Pet (' + EGG + ' koin)</button>';
        if (last) h += '<div class="pm4Card" style="margin-top:10px;border:2px solid ' + last.p.c + ';"><div class="pm4Big" style="color:' + last.p.c + '">' + last.p.name + '</div><div class="pm4Sub">' + last.p.t + (last.dup ? ' • duplikat, bintang naik!' : ' • pet baru!') + '</div></div>';
        h += '<div class="pm4Card" style="margin-top:10px;">';
        let any = false;
        PETS.forEach(function (p) {
          const st = stars(p.id); if (!st) return; any = true;
          const b = {}; for (const k in p.b) b[k] = p.b[k] * mult(st);
          const on = (save.petEq || []).indexOf(p.id) >= 0;
          h += '<div class="pm4Row"><div><b style="color:' + p.c + '">' + p.name + '</b> <span class="pm4Sub">' + new Array(st + 1).join('★') + '</span><div class="pm4Sub">' + fmtB(b) + '</div></div><button data-a="equip" data-id="' + p.id + '" class="' + (on ? 'on' : '') + '">' + (on ? 'Dipakai' : 'Pakai') + '</button></div>';
        });
        if (!any) h += '<div class="pm4Sub">Belum punya pet. Beli Telur Pet dulu.</div>';
        h += '</div>';
      }
      body.innerHTML = h;
    }
    const CSS = [
      '#pm4Ov{position:fixed;left:0;top:0;right:0;bottom:0;z-index:60;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.55);padding:12px;box-sizing:border-box}',
      '#pm4Ov.show{display:flex}',
      '#pm4Box{width:100%;max-width:430px;max-height:88vh;display:flex;flex-direction:column;border-radius:20px;background:linear-gradient(160deg,#1d5068,#0a1e2c);border:3px solid #5fd0e0;box-shadow:0 8px 0 rgba(0,0,0,.35);color:#fff;overflow:hidden}',
      '#pm4Head{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:rgba(0,0,0,.25)}',
      '#pm4Head h2{margin:0;font-size:17px;font-weight:900}',
      '#pm4X{border:0;background:rgba(255,255,255,.15);color:#fff;width:30px;height:30px;border-radius:50%;font-size:15px}',
      '#pm4Body{padding:12px;overflow-y:auto;-webkit-overflow-scrolling:touch}',
      '.pm4Tabs{display:flex;gap:8px;margin-bottom:10px}',
      '.pm4Tabs button{flex:1;padding:8px;border:0;border-radius:12px;background:rgba(255,255,255,.12);color:#fff;font-weight:800;font-size:13px}',
      '.pm4Tabs button.on{background:linear-gradient(90deg,#ffc233,#ff8a3d);color:#2a1a00}',
      '.pm4Card{background:rgba(0,0,0,.25);border-radius:14px;padding:12px;margin-bottom:10px;line-height:1.5;font-size:13px}',
      '.pm4Big{font-size:20px;font-weight:900}',
      '.pm4Sub{font-size:12px;opacity:.9}',
      '.pm4Btn{width:100%;padding:12px;border:0;border-radius:14px;font-weight:900;font-size:14px;color:#2a1a00;background:linear-gradient(90deg,#ffc233,#ff8a3d)}',
      '.pm4Btn:disabled{opacity:.45}',
      '.pm4Row{display:flex;align-items:center;gap:8px;justify-content:space-between;padding:8px 0;border-top:1px solid rgba(255,255,255,.08)}',
      '.pm4Row button{padding:6px 12px;border:0;border-radius:10px;font-weight:800;font-size:12px;background:rgba(255,255,255,.18);color:#fff}',
      '.pm4Row button.on{background:#5fd36b;color:#06240c}'
    ].join('');
    function ensure() {
      if (document.getElementById('pm4Ov')) return;
      const st = document.createElement('style'); st.textContent = CSS; document.head.appendChild(st);
      const ov = document.createElement('div'); ov.id = 'pm4Ov';
      ov.innerHTML = '<div id="pm4Box"><div id="pm4Head"><h2>Rebirth &amp; Pet</h2><button id="pm4X" data-a="close">✕</button></div><div id="pm4Body"></div></div>';
      document.body.appendChild(ov);
      ov.addEventListener('click', function (ev) {
        if (ev.target === ov) { ov.classList.remove('show'); return; }
        const b = ev.target.closest('[data-a]'); if (!b || b.disabled) return;
        const a = b.dataset.a;
        if (a === 'close') ov.classList.remove('show');
        else if (a === 'tab') { tab = b.dataset.v; render(); }
        else if (a === 'rebirth') doRebirth();
        else if (a === 'egg') buyEgg();
        else if (a === 'equip') equip(b.dataset.id);
      });
    }
    function open() { ensure(); armed = false; render(); document.getElementById('pm4Ov').classList.add('show'); }
    function addBtn() {
      const host = document.getElementById('menuPanel') || document.getElementById('hudPills');
      if (!host || document.getElementById('pm4Btn')) return;
      const b = document.createElement('button'); b.id = 'pm4Btn'; b.className = 'hudPill'; b.textContent = 'Rebirth';
      b.onclick = function () { const mp = document.getElementById('menuPanel'); if (mp) mp.classList.remove('show'); open(); };
      host.appendChild(b);
    }
    if (document.readyState === 'complete') setTimeout(addBtn, 1200); else window.addEventListener('load', function () { setTimeout(addBtn, 1200); });
    window.PM4 = { bonus: bonus, open: open, title: function () { return titleOf(rbN()); } };
  })();
  /* ENCHANT_V38 */
  function enchBonus(k) { const en = save.enchants && save.enchants[save.rod]; return ((en && en[k]) || 0) + (pm4b()[k] || 0); }
  function currentBait() { return BAIT_TYPES.find(b => b.id === save.bait) || BAIT_TYPES[0]; }
  function totalBoost() { return currentRod().rarityBoost + currentBait().rarityBoost - 1; }

  // ================= TOAST =================
  function showToast(text, variant) {
    const wrap = document.getElementById('toastWrap');
    const el = document.createElement('div');
    el.className = 'toast' + (variant ? ' toast-' + variant : ''); el.textContent = text;
    wrap.appendChild(el);
    setTimeout(() => el.remove(), variant === 'secret' ? 4200 : 2600);
  }

    // ================= EFEK TAMBAHAN SECRET & MITOS (v2) =================
  function cfxShake(ms) {
    let best = null, area = 0;
    document.querySelectorAll('canvas').forEach(function (c) {
      const a = c.clientWidth * c.clientHeight;
      if (a > area) { area = a; best = c; }
    });
    if (!best) return;
    best.classList.remove('cfxShake'); void best.offsetWidth; best.classList.add('cfxShake');
    setTimeout(function () { best.classList.remove('cfxShake'); }, ms);
  }
  function cfxMythicFx() {
    let el = document.getElementById('mythFx');
    if (!el) { el = document.createElement('div'); el.id = 'mythFx'; document.body.appendChild(el); }
    el.className = ''; el.innerHTML = ''; void el.offsetWidth; el.className = 'show';
    const COL = ['#ff4fd8', '#ffe27a', '#7fe8ff', '#b36bff'];
    for (let i = 0; i < 34; i++) {
      const s = document.createElement('div');
      s.className = 'mythSpark';
      const ang = Math.random() * Math.PI * 2, dist = 80 + Math.random() * 260;
      const col = COL[i % COL.length];
      s.style.setProperty('--dx', (Math.cos(ang) * dist) + 'px');
      s.style.setProperty('--dy', (Math.sin(ang) * dist) + 'px');
      s.style.background = col; s.style.boxShadow = '0 0 10px 3px ' + col;
      s.style.animationDelay = (Math.random() * 0.25) + 's';
      el.appendChild(s);
    }
    cfxShake(800);
    clearTimeout(cfxMythicFx._t);
    cfxMythicFx._t = setTimeout(function () { el.className = ''; el.innerHTML = ''; }, 3500);
  }
  // Tes tanpa nunggu drop: buka index.html?fxtest=secret atau ?fxtest=mythical
  (function () {
    const m = /[?&]fxtest=(\w+)/.exec(location.search);
    if (!m) return;
    setTimeout(function () {
      if (m[1] === 'secret') { triggerSecretCatchFX('Tes Ikan Rahasia'); return; }
      try { showCatchReveal({ fish: { id: 'leviathan', name: 'Leviathan', rarity: 'mythical', value: 5500 }, mutation: {}, weight: 1, value: 5500 }); }
      catch (e) { cfxMythicFx(); }
    }, 3000);
  })();

  // ================= EFEK TANGKAP IKAN SECRET =================
  function triggerSecretCatchFX(label) {
    const overlay = document.getElementById('secretFxOverlay');
    const sub = document.getElementById('secretFxSub');
    if (!overlay || !sub) return;
    sub.textContent = label;
    overlay.classList.remove('show'); void overlay.offsetWidth; overlay.classList.add('show');
    cfxShake(900);
    for (let i = 0; i < 52; i++) {
      const s = document.createElement('div');
      s.className = 'secretSparkle'; const cc = ['#ff5ad1', '#ffd54f', '#5cf2ff', '#ffffff', '#9dff7a'][i % 5]; s.style.background = cc; s.style.boxShadow = '0 0 10px 3px ' + cc;
      const ang = Math.random() * Math.PI * 2, dist = 90 + Math.random() * 300;
      s.style.setProperty('--dx', (Math.cos(ang) * dist) + 'px');
      s.style.setProperty('--dy', (Math.sin(ang) * dist) + 'px');
      s.style.animationDelay = (Math.random() * 0.18) + 's';
      overlay.appendChild(s);
      setTimeout(() => s.remove(), 2600);
    }
    setTimeout(() => overlay.classList.remove('show'), 2800);
  }


  // ================= SUARA & GETAR =================
  const Sfx = (() => {
    let ctx = null;
    function ensure() {
      if (save.muted) return null;
      try {
        if (!ctx) { const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return null; ctx = new AC(); }
        if (ctx.state === 'suspended') ctx.resume();
      } catch (e) { return null; }
      return ctx;
    }
    function tone(freq, start, dur, type, vol, slideTo) {
      const c = ensure(); if (!c) return;
      const t0 = c.currentTime + start;
      const o = c.createOscillator(), g = c.createGain();
      o.type = type || 'sine';
      o.frequency.setValueAtTime(freq, t0);
      if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, t0 + dur);
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(vol || 0.12, t0 + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
      o.connect(g); g.connect(c.destination);
      o.start(t0); o.stop(t0 + dur + 0.05);
    }
    const SCALE = [523, 587, 659, 784, 880, 1047, 1319, 1568];
    function arp(n, step, type, vol) { for (let i = 0; i < n; i++) tone(SCALE[i % SCALE.length], i * step, 0.28, type, vol); }
    return {
      unlock() { ensure(); },
      suspend() { try { if (ctx && ctx.state === 'running') ctx.suspend(); } catch (e) {} },
      resume() { try { if (ctx && ctx.state === 'suspended' && !save.muted) ctx.resume(); } catch (e) {} },
      cast() { tone(700, 0, 0.25, 'sine', 0.1, 220); },
      bite() { tone(880, 0, 0.09, 'square', 0.07); tone(1175, 0.11, 0.12, 'square', 0.07); },
      tap() { tone(1000, 0, 0.04, 'triangle', 0.05); },
      sell() { tone(1319, 0, 0.09, 'triangle', 0.1); tone(1760, 0.09, 0.2, 'triangle', 0.1); },
      levelUp() { arp(4, 0.09, 'triangle', 0.1); },
      fail() { tone(400, 0, 0.35, 'sawtooth', 0.06, 120); },
      catchFish(rarity) {
        const n = { common: 2, uncommon: 3, rare: 4, epic: 5, legendary: 6, mythical: 7, secret: 8 }[rarity] || 2;
        arp(n, rarity === 'secret' ? 0.11 : 0.085, (rarity === 'common' || rarity === 'uncommon') ? 'sine' : 'triangle', 0.11);
        if (rarity === 'mythical' || rarity === 'secret') tone(196, 0, 0.9, 'sine', 0.1);
        if (rarity === 'mythical') { tone(98, 0, 1.2, 'sawtooth', 0.05, 392); tone(784, 0.5, 0.6, 'triangle', 0.08); }
        if (rarity === 'secret') tone(80, 0, 1.4, 'sine', 0.14, 40);
        if (rarity === 'secret') { for (let i = 0; i < 6; i++) tone(2000 + i * 300, 0.9 + i * 0.07, 0.25, 'sine', 0.05); }
      },
    };
  })();
  function vibe(p) { try { if (navigator.vibrate) navigator.vibrate(p); } catch (e) {} }
  const CATCH_VIBE = { common: [25], uncommon: [35], rare: [50], epic: [60, 40, 60], legendary: [100, 50, 100, 50, 160], mythical: [150, 60, 150, 60, 260], secret: [200, 80, 200, 80, 200, 80, 450] };
  function saveQuiet() { try { localStorage.setItem(SAVE_KEY, JSON.stringify(save)); } catch (e) {} }

  // ================= REVEAL IKAN LANGKA (epic ke atas, secret punya efek sendiri) =================
  const REVEAL_SECS = { common: 1.3, uncommon: 1.4, rare: 1.6, epic: 1.9, legendary: 2.5, mythical: 3.6 };
  let revealTimer = null;
  function showCatchReveal(c) {
    const dur = REVEAL_SECS[c.fish.rarity]; if (!dur) return;
    const el = document.getElementById('catchReveal'), card = document.getElementById('catchRevealCard');
    document.getElementById('catchRevealImg').src = fishIconCanvas(c.fish, c.mutation);
    document.getElementById('catchRevealTier').textContent = RARITY_LABEL[c.fish.rarity] + (c.mutation.name ? ' • MUTASI ' + c.mutation.name : '');
    document.getElementById('catchRevealName').textContent = (c.mutation.name ? c.mutation.name + ' ' : '') + c.fish.name;
    document.getElementById('catchRevealVal').textContent = (c.weight ? fmtKg(c.weight) + ' • ' : '') + c.value + ' koin';
    card.style.setProperty('--rc', RARITY_COLOR[c.fish.rarity]);
    card.style.setProperty('--dur', dur + 's');
    el.className = ''; void el.offsetWidth;
    el.className = 'show tier-' + c.fish.rarity;
    if (c.fish.rarity === 'mythical') cfxMythicFx();
    clearTimeout(revealTimer);
    revealTimer = setTimeout(() => { el.className = ''; }, dur * 1000 + 100);
  }

  // ================= GENERATOR TEKSTUR (canvas, pixel style) =================
  function hashStr(str) { let h = 2166136261; for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }
  function makeRng(seed) { let s = (seed >>> 0) || 1; return () => { s ^= s << 13; s >>>= 0; s ^= s >>> 17; s ^= s << 5; s >>>= 0; return s / 4294967296; }; }

  function makeSkyTexture() {
    const c = document.createElement('canvas'); c.width = 2; c.height = 256;
    const g = c.getContext('2d');
    const grad = g.createLinearGradient(0, 0, 0, 256);
    grad.addColorStop(0, '#2a5db5');
    grad.addColorStop(0.18, '#9dc3e6');
    grad.addColorStop(0.3, '#ffcf9e');
    grad.addColorStop(1, '#ffdfae');
    g.fillStyle = grad; g.fillRect(0, 0, 2, 256);
    const t = new THREE.CanvasTexture(c);
    t.needsUpdate = true;
    return t;
  }

  function makeIslandTexture() {
    const SZ = 256, HALF = SZ / 2;
    const c = document.createElement('canvas'); c.width = c.height = SZ;
    const g = c.getContext('2d');
    const img = g.createImageData(SZ, SZ), d = img.data;
    const rand = makeRng(777);
    for (let y = 0; y < SZ; y++) for (let x = 0; x < SZ; x++) {
      const cx = x - HALF, cy = y - HALF;
      const dist = Math.sqrt(cx * cx + cy * cy) / HALF;
      let col;
      if (dist > 0.82) col = [232, 214, 168]; // pasir
      else col = [86, 172, 78]; // rumput
      const n = (rand() - 0.5) * 18;
      const i = (y * SZ + x) * 4;
      d[i] = col[0] + n; d[i + 1] = col[1] + n; d[i + 2] = col[2] + n; d[i + 3] = 255;
    }
    g.putImageData(img, 0, 0);
    const t = new THREE.CanvasTexture(c);
    t.magFilter = THREE.NearestFilter; t.minFilter = THREE.NearestFilter;
    return t;
  }

  function makeWaterTexture() {
    const SZ = 128;
    const c = document.createElement('canvas'); c.width = c.height = SZ;
    const g = c.getContext('2d');
    const img = g.createImageData(SZ, SZ), d = img.data;
    const rand = makeRng(555);
    for (let y = 0; y < SZ; y++) for (let x = 0; x < SZ; x++) {
      const wave = Math.sin(x * 0.25) * 6 + Math.cos(y * 0.2) * 6; // frekuensi dihalvekan biar pola gelombang sama, cuma lebih halus
      const n = (rand() - 0.5) * 8;
      const base = [40, 120, 168];
      const i = (y * SZ + x) * 4;
      d[i] = base[0] + wave * 0.3 + n; d[i + 1] = base[1] + wave * 0.5 + n; d[i + 2] = base[2] + wave + n; d[i + 3] = 210;
    }
    g.putImageData(img, 0, 0);
    const t = new THREE.CanvasTexture(c);
    t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(24, 24);
    return t;
  }

  var IC = {};
  function mkC(w, h) { var c = document.createElement('canvas'); c.width = w; c.height = h; return c; }
  var FM = {teri:['f','#9fb8c4','#f0f6f8',{L:50,H:13}],mujair:['f','#6f7f6a','#d8d9b0',{L:54,H:24,st:1}],lele:['f','#4a4d4a','#b9b5a0',{L:68,H:15,tail:14}],nila:['f','#7e8b8f','#e7d9d0',{L:56,H:27}],kakap:['f','#c9523f','#f3c2b4',{L:62,H:26}],tenggiri:['f','#4d6b86','#d8e2ea',{L:70,H:19,st:1}],tuna:['f','#24476e','#dfe8ef',{L:70,H:27}],hiu_kecil:['s','#6f8793','#e9eff2',{}],marlin:['f','#2a5c9a','#e0ecf7',{L:76,H:20,bill:1,dors:2}],naga_laut:['g','#2fbf8f','#c8ffe6'],mutiara:['f','#e9dcee','#ffffff',{L:56,H:28,pearl:1}],leviathan:['w','#2b3a6b','#8fa6d6',{}],kraken_purba:['q','#6b2f8a','#d58aff',{big:1}],bandeng:['f','#aab6bb','#f4f6f6',{L:64,H:16}],belanak:['f','#8fa0a6','#eef2f2',{L:60,H:15}],baronang:['f','#b7a24a','#f3ebb5',{L:52,H:28,st:1}],kerapu:['f','#8a5a3a','#d9b89a',{L:62,H:30,dots:1}],ubur:['j','#9fe3ff','#e8fbff'],kuda_laut:['h','#ffd27a','#fff1c8'],penyu:['t','#4f8a4a','#c9d98a'],layur:['f','#c7d3d9','#f4f8fa',{L:76,H:9}],kembung:['f','#3d7a8c','#e3f0f2',{L:56,H:19,st:1}],lentera:['f','#2c3a5a','#7da0d8',{L:50,H:22,lamp:1}],todak:['f','#3e6f93','#dceaf3',{L:76,H:13,bill:1}],pari_manta:['r','#2f3f55','#f0f3f7'],hiu_martil:['s','#77808a','#eceff2',{L:70,H:21}],cumi_raksasa:['q','#b03a3a','#ffb0a0',{big:1}],ikan_bulan:['f','#9aa7b0','#e9eef1',{L:38,H:44,tail:10}],paus_biru:['w','#3a6f9c','#d6e4ef',{}],megalodon:['s','#3c434a','#b9c0c6',{L:80,H:27}],u_gabus:['f','#5a5a3a','#c8c49a',{L:66,H:17}],u_toman:['f','#3d4a3a','#b8c4a0',{L:72,H:20,dots:1}]};
  function hdBody(g, o, c1, c2) {
    var L = o.L, H = o.H, cx = 96, cy = 100, hx = cx - L, tx = cx + L * 0.72, T = o.tail || H * 1.1;
    var tg = g.createLinearGradient(0, cy - H, 0, cy + H);
    tg.addColorStop(0, c1); tg.addColorStop(0.55, c1); tg.addColorStop(0.62, c2); tg.addColorStop(1, c2);
    g.fillStyle = c1; g.globalAlpha = 0.9; g.beginPath(); g.moveTo(tx - 4, cy);
    g.lineTo(tx + T, cy - H * (o.shark ? 1.5 : 0.95)); g.quadraticCurveTo(tx + T * 0.55, cy, tx + T, cy + H * (o.shark ? 0.7 : 0.95)); g.closePath(); g.fill(); g.globalAlpha = 1;
    var dh = H * (o.shark ? 1 : 0.75) * (o.dors || 1);
    g.beginPath(); g.moveTo(cx - L * 0.25, cy - H * 0.92); g.quadraticCurveTo(cx + L * 0.05, cy - H * 0.92 - dh, cx + L * 0.42, cy - H * 0.72); g.closePath(); g.fill();
    g.beginPath(); g.moveTo(cx + L * 0.1, cy + H * 0.85); g.quadraticCurveTo(cx + L * 0.25, cy + H * 1.5, cx + L * 0.45, cy + H * 0.6); g.closePath(); g.fill();
    if (o.bill) { g.beginPath(); g.moveTo(hx + 4, cy - 3); g.lineTo(hx - L * 0.35, cy); g.lineTo(hx + 4, cy + 3); g.fill(); }
    var P = new Path2D();
    P.moveTo(hx, cy); P.bezierCurveTo(hx + L * 0.3, cy - H * 1.3, tx - L * 0.6, cy - H * 0.95, tx, cy - H * 0.2);
    P.lineTo(tx, cy + H * 0.2); P.bezierCurveTo(tx - L * 0.6, cy + H * 0.95, hx + L * 0.3, cy + H * 1.3, hx, cy); P.closePath();
    g.fillStyle = tg; g.fill(P); g.save(); g.clip(P);
    if (!o.whale) { g.strokeStyle = 'rgba(255,255,255,.13)'; g.lineWidth = 1.2;
      for (var r = -3; r <= 3; r++) for (var k = 0; k < 9; k++) { g.beginPath(); g.arc(hx + L * 0.45 + k * L * 0.17 + (r & 1 ? L * 0.085 : 0), cy + r * H * 0.3, H * 0.2, -1.2, 1.2); g.stroke(); } }
    if (o.st) { g.fillStyle = 'rgba(0,0,0,.18)'; for (var k2 = 0; k2 < 5; k2++) g.fillRect(hx + L * 0.55 + k2 * L * 0.2, cy - H * 1.3, L * 0.07, H * 2.6); }
    if (o.dots) { g.fillStyle = 'rgba(255,255,255,.35)'; for (var k3 = 0; k3 < 12; k3++) { g.beginPath(); g.arc(hx + L * 0.5 + (k3 % 6) * L * 0.18, cy - H * 0.4 + (k3 > 5 ? H * 0.5 : 0), 2.4, 0, 7); g.fill(); } }
    var sh = g.createLinearGradient(0, cy - H, 0, cy); sh.addColorStop(0, 'rgba(255,255,255,.4)'); sh.addColorStop(1, 'rgba(255,255,255,0)'); g.fillStyle = sh; g.fillRect(0, cy - H * 1.3, 200, H * 1.3);
    var sd = g.createLinearGradient(0, cy, 0, cy + H * 1.2); sd.addColorStop(0, 'rgba(0,0,0,0)'); sd.addColorStop(1, 'rgba(0,0,0,.28)'); g.fillStyle = sd; g.fillRect(0, cy, 200, H * 1.3);
    g.restore(); g.strokeStyle = 'rgba(0,0,0,.35)'; g.lineWidth = 1.6; g.stroke(P);
    g.strokeStyle = 'rgba(0,0,0,.25)'; g.beginPath(); g.arc(hx + L * 0.5, cy, H * 0.7, -1, 1); g.stroke();
