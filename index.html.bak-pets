<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Pancing Mania</title>
<style>
  :root {
    --accent: #37d1c8; --accent2: #2f9fc9; --gold: #ffcf4d; --gold2: #ff9e4a; --danger: #ff5a6a; --ok: #4ce88a;
    --panel: rgba(8,22,32,0.72); --panel-border: rgba(255,255,255,0.16); --panel-border-strong: rgba(255,255,255,0.34);
    --text: #f2fbfc; --text-dim: #a9c6cd; --shadow-panel: 0 10px 28px rgba(0,0,0,0.4);
    --radius-md: 16px; --radius-lg: 22px;
  }
  html, body { margin: 0; padding: 0; overflow: hidden; background: #061019; font-family: 'Poppins', 'Segoe UI', system-ui, -apple-system, Arial, sans-serif; color: var(--text); -webkit-tap-highlight-color: transparent; }
  canvas { display: block; touch-action: none; }
  * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }

  /* ================= LOADING SCREEN ================= */
  #loadingScreen {
    position: fixed; inset: 0; z-index: 999; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 16px;
    background: radial-gradient(ellipse at 50% 35%, #12455f 0%, #071a28 68%, #020810 100%);
    color: #fff; transition: opacity 0.45s ease;
  }
  #loadingScreen.hidden { opacity: 0; pointer-events: none; }
  #loadingLogo {
    font-size: 32px; font-weight: 900; letter-spacing: 0.5px;
    background: linear-gradient(90deg, var(--accent), var(--gold));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    filter: drop-shadow(1px 3px 6px rgba(0,0,0,0.6)); animation: loadBob 1.6s ease-in-out infinite;
  }
  @keyframes loadBob { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-6px) scale(1.02); } }
  #loadingBarTrack { width: min(78vw, 300px); height: 13px; border-radius: 999px; overflow: hidden; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); box-shadow: inset 0 2px 5px rgba(0,0,0,0.4); }
  #loadingBarFill { height: 100%; width: 4%; border-radius: 999px; background: linear-gradient(90deg, var(--accent), var(--gold)); box-shadow: 0 0 12px rgba(55,209,200,0.6); transition: width 0.25s ease-out; }
  #loadingLabel { font-size: 12px; color: var(--text-dim); letter-spacing: 0.3px; min-height: 16px; text-align: center; padding: 0 20px; }

  /* ================= HUD (gaya Fish It) ================= */
  #versionBadge { position: fixed; top: calc(8px + env(safe-area-inset-top, 0px)); left: 50%; transform: translateX(-50%); z-index: 21; color: rgba(255,255,255,0.45); font-size: 10px; padding: 2px 8px; font-weight: 600; letter-spacing: 0.5px; text-shadow: 1px 1px 2px rgba(0,0,0,0.8); }
  #hud { position: fixed; top: calc(14px + env(safe-area-inset-top, 0px)); left: 12px; z-index: 10; display: none; flex-direction: column; gap: 8px; }
  .hudPanel {
    position: relative;
    background: linear-gradient(160deg, #1d5068, #0c2836);
    border: 3px solid rgba(255,255,255,0.92);
    border-radius: 16px; padding: 6px 12px 6px 17px;
    box-shadow: 0 5px 0 rgba(0,0,0,0.32), 0 10px 18px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.12);
    min-width: 0;
  }
  #coinsRow { display: flex; align-items: center; gap: 7px; }
  .coinBadge {
    margin-left: -21px; flex-shrink: 0;
    width: 26px; height: 26px; border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, #ffe27a, #e0982a);
    border: 2.5px solid #fff; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 3px 0 rgba(120,70,0,0.45), 0 4px 8px rgba(0,0,0,0.4);
    position: relative; z-index: 1;
  }
  #coinsVal { font-size: 15px; font-weight: 900; color: #fff; text-shadow: 0 2px 0 rgba(0,0,0,0.4), 1px 1px 1px rgba(0,0,0,0.3); letter-spacing: 0.2px; }
  #levelRow { display: flex; align-items: center; gap: 6px; margin-left: 4px; padding-left: 8px; border-left: 2px solid rgba(255,255,255,0.25); font-size: 9px; font-weight: 800; color: #a9dbe6; letter-spacing: 0.4px; text-transform: uppercase; }
  #levelVal {
    flex-shrink: 0;
    width: 20px; height: 20px; border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, #8ef2ff, #1f8fae);
    border: 2px solid #fff; display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 900; color: #04303c; box-shadow: 0 2px 0 rgba(0,60,70,0.45), 0 3px 6px rgba(0,0,0,0.4);
  }
  #xpMini { display: flex; flex-direction: column; gap: 2px; width: 54px; }
  #xpTrack { width: 100%; height: 6px; border-radius: 999px; background: rgba(0,0,0,0.45); border: 1.5px solid rgba(255,255,255,0.5); overflow: hidden; box-shadow: inset 0 1px 2px rgba(0,0,0,0.5); }
  #xpFill { height: 100%; width: 0%; border-radius: 999px; background: linear-gradient(90deg, var(--accent), #7fe8ff); transition: width 0.3s ease; }
  #gearRow { font-size: 9.5px; color: #bfe8f0; margin-top: 3px; font-weight: 600; white-space: nowrap; }
  #gearRow b { color: #fff; font-weight: 800; }
  #gearRow .sep { color: rgba(255,255,255,0.35); margin: 0 4px; }
  #gearRow { display: flex; gap: 4px; align-items: center; }
  .gearChip { --rc: #9fb4bd; display: inline-flex; align-items: center; gap: 3px; padding: 1px 6px; border-radius: 8px; background: rgba(0,0,0,0.38); border: 1.5px solid var(--rc); }
  .gearChip .ico { width: 11px; height: 11px; color: var(--rc); }
  .baitDot { width: 7px; height: 7px; border-radius: 50%; background: var(--rc); box-shadow: 0 0 5px var(--rc); }
  @keyframes badgePop { 0% { transform: scale(1); } 35% { transform: scale(1.32); } 100% { transform: scale(1); } }
  .coinBadge.pop, #levelVal.pop { animation: badgePop 0.4s ease; }

  #topRightBW { position: fixed; top: calc(14px + env(safe-area-inset-top, 0px)); right: 10px; z-index: 10; display: none; flex-direction: column; align-items: center; gap: 12px; }
  #fpsFish { font-size: 10px; color: rgba(255,255,255,0.4); text-shadow: 1px 1px 2px black; margin-bottom: 0; }
  .iconBtn { width: 58px; display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; }
  .iconCircle {
    width: 52px; height: 52px; border-radius: 50%;
    background: linear-gradient(160deg, #2fb8d1, #196c81);
    border: 3px solid #fff; color: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 5px 0 rgba(0,0,0,0.35), 0 8px 16px rgba(0,0,0,0.4);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  #btnShop .iconCircle { background: linear-gradient(160deg, #ffcf4d, #e0982a); color: #4a2600; }
  .iconBtn:active .iconCircle { transform: translateY(4px); box-shadow: 0 1px 0 rgba(0,0,0,0.35), 0 3px 8px rgba(0,0,0,0.4); }
  .iconLabel { font-size: 10px; font-weight: 800; color: #fff; text-shadow: 1px 1px 3px rgba(0,0,0,0.7); letter-spacing: 0.3px; }

  /* ================= CUSTOM ICONS (ganti emoji biar konsisten semua device) ================= */
  .ico { width: 16px; height: 16px; display: inline-block; vertical-align: -3px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ico-star { fill: currentColor; stroke: none; }

  /* ================= JOYSTICK & KAMERA ================= */
  #joystickZone { position: fixed; bottom: 24px; left: 20px; width: 118px; height: 118px; z-index: 12; display: none; touch-action: none; }
  #joystickBase { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.18), rgba(255,255,255,0.05)); border: 2px solid rgba(255,255,255,0.3); box-shadow: 0 6px 18px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.15); }
  #joystickThumb { position: absolute; width: 46px; height: 46px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, #cfe9f2); left: 50%; top: 50%; transform: translate(-50%, -50%); box-shadow: 0 3px 10px rgba(0,0,0,0.4), 0 0 0 3px rgba(55,209,200,0.25); }
  #camDragZone { position: fixed; top: 0; right: 0; width: 55%; height: 100%; z-index: 8; touch-action: none; }

  /* ================= TOMBOL PANCING (gaya cast button Fish It) ================= */
  #fishActionWrap { position: fixed; bottom: 26px; right: 30px; z-index: 15; display: none; flex-direction: column; align-items: flex-end; gap: 12px; }
  #fishBtn {
    width: 104px; height: 104px; border-radius: 50%; border: 4px solid #fff;
    background: radial-gradient(circle at 35% 26%, #5cebe0, #0f8fa8); color: #04303c; font-weight: 900; font-size: 13px; letter-spacing: 0.3px;
    box-shadow: 0 8px 0 rgba(0,55,65,0.55), 0 14px 26px rgba(0,0,0,0.45), 0 0 0 6px rgba(55,209,200,0.16); cursor: pointer;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; line-height: 1.15; gap: 3px;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  #fishBtn .ico { width: 20px; height: 20px; }
  #fishBtnLabel { display: block; }
  #fishBtn.strike { background: radial-gradient(circle at 35% 26%, #ffe27a, #e08a20); color: #4a2600; box-shadow: 0 8px 0 rgba(120,70,0,0.55), 0 14px 26px rgba(0,0,0,0.45), 0 0 0 6px rgba(255,207,77,0.3); animation: strikePulse 0.5s infinite; }
  @keyframes strikePulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
  #fishBtn:active { transform: translateY(5px); box-shadow: 0 3px 0 rgba(0,55,65,0.55), 0 6px 14px rgba(0,0,0,0.4); }
  #fishHint { font-size: 12.5px; font-weight: 800; color: #fff; text-shadow: 1px 1px 3px black; background: linear-gradient(160deg, rgba(20,44,58,0.85), rgba(8,20,28,0.8)); border: 2px solid rgba(255,255,255,0.55); padding: 6px 14px; border-radius: 999px; }

  /* ================= POWER BAR CASTING (gaya Fish It: hijau bergaris + ujung bulat) ================= */
  #powerWrap { position: fixed; bottom: 148px; left: 50%; transform: translateX(-50%); z-index: 16; width: min(80vw, 320px); display: none; align-items: center; gap: 8px; }
  #powerTrack { position: relative; flex: 1; height: 28px; border-radius: 999px; background: rgba(0,0,0,0.5); border: 3px solid #fff; overflow: hidden; box-shadow: 0 5px 0 rgba(0,0,0,0.35), inset 0 2px 4px rgba(0,0,0,0.4); }
  #powerFill {
    position: absolute; left: 0; top: 0; bottom: 0; width: 0%; background: linear-gradient(180deg, #7be86b, #2f9f4f);
    background-image: linear-gradient(180deg, #7be86b, #2f9f4f), repeating-linear-gradient(125deg, rgba(255,255,255,0.32) 0 8px, transparent 8px 16px);
    transition: background 0.15s;
  }
  #powerFill.warn { background-image: linear-gradient(180deg, #ffe27a, #e0982a), repeating-linear-gradient(125deg, rgba(255,255,255,0.32) 0 8px, transparent 8px 16px); }
  #powerFill.critical { background-image: linear-gradient(180deg, #ff8a6b, #c23a2a), repeating-linear-gradient(125deg, rgba(255,255,255,0.32) 0 8px, transparent 8px 16px); }
  #powerMarker { position: absolute; top: -4px; width: 0; height: 0; border-left: 7px solid transparent; border-right: 7px solid transparent; border-top: 10px solid #fff; filter: drop-shadow(0 2px 2px rgba(0,0,0,0.5)); left: 0%; }
  .barEndIcon { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(160deg, #2fb8d1, #196c81); border: 2.5px solid #fff; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #fff; box-shadow: 0 3px 0 rgba(0,0,0,0.35); }

  /* ================= REELING MINIGAME (gaya Fish It: "Klik Cepat!" + bar hijau bergaris) ================= */
  #reelWrap { position: fixed; bottom: 148px; left: 50%; transform: translateX(-50%); z-index: 16; width: min(84vw, 340px); display: none; flex-direction: column; align-items: center; gap: 8px; }
  #reelTrackRow { display: flex; align-items: center; gap: 8px; width: 100%; }
  #reelTrack { position: relative; flex: 1; height: 32px; border-radius: 999px; background: rgba(20,10,10,0.6); border: 3px solid #fff; overflow: hidden; box-shadow: 0 5px 0 rgba(0,0,0,0.35), inset 0 2px 4px rgba(0,0,0,0.4); }
  #reelZone {
    position: absolute; top: 0; bottom: 0; right: 0; width: 100%; background: linear-gradient(180deg, #7be86b, #2f9f4f);
    background-image: linear-gradient(180deg, #7be86b, #2f9f4f), repeating-linear-gradient(125deg, rgba(255,255,255,0.32) 0 8px, transparent 8px 16px);
    transition: width 0.12s linear, background 0.15s;
  }
  #reelZone.warn { background-image: linear-gradient(180deg, #ffe27a, #e0982a), repeating-linear-gradient(125deg, rgba(255,255,255,0.32) 0 8px, transparent 8px 16px); }
  #reelZone.critical { background-image: linear-gradient(180deg, #ff8a6b, #c23a2a), repeating-linear-gradient(125deg, rgba(255,255,255,0.32) 0 8px, transparent 8px 16px); }
  #reelIndicator { display: none; }
  #reelProgressTrack { display: none; }
  #reelProgressFill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--accent), var(--gold)); }
  #reelLabelRow { display: flex; align-items: center; gap: 8px; }
  #reelLabel { font-size: 13px; font-weight: 900; color: #fff; text-shadow: 1px 1px 3px black; background: linear-gradient(160deg, rgba(20,44,58,0.85), rgba(8,20,28,0.8)); border: 2px solid rgba(255,255,255,0.55); padding: 5px 14px; border-radius: 999px; }
  #reelTapHint { font-size: 13px; font-weight: 900; color: #04303c; background: #ffe066; border: 2px solid #fff; padding: 5px 10px; border-radius: 999px; box-shadow: 0 3px 0 rgba(120,70,0,0.35); min-width: 46px; text-align: center; }

  /* ================= TOAST ================= */
  #toastWrap { position: fixed; top: 92px; left: 50%; transform: translateX(-50%); z-index: 60; display: flex; flex-direction: column; align-items: center; gap: 7px; pointer-events: none; }
  .toast { background: linear-gradient(160deg, rgba(16,34,46,0.94), rgba(8,18,26,0.9)); border: 2.5px solid rgba(255,255,255,0.85); border-radius: 999px; padding: 8px 18px; font-size: 13px; font-weight: 700; box-shadow: 0 4px 0 rgba(0,0,0,0.32), 0 8px 18px rgba(0,0,0,0.4); animation: toastIn 0.25s ease, toastOut 0.4s ease 2.1s forwards; white-space: nowrap; }
  @keyframes toastIn { from { opacity: 0; transform: translateY(-10px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes toastOut { to { opacity: 0; transform: translateY(-10px); } }
  .toast.toast-secret {
    color: #2a0f1e; font-weight: 900; font-size: 14px; border-color: #fff;
    background: linear-gradient(90deg, #ff8ae6, #ffe27a, #7fe8ff, #ff8ae6); background-size: 300% 100%;
    box-shadow: 0 4px 0 rgba(0,0,0,0.32), 0 0 26px rgba(255,255,255,0.55);
    animation: toastIn 0.25s ease, secretRainbowShift 1.1s linear infinite, toastOut 0.4s ease 3.7s forwards;
  }
  @keyframes secretRainbowShift { to { background-position: 300% 0; } }

  /* ================= EFEK TANGKAP IKAN SECRET ================= */
  #secretFxOverlay { position: fixed; inset: 0; z-index: 50; display: none; align-items: center; justify-content: center; pointer-events: none; overflow: hidden; }
  #secretFxOverlay.show { display: flex; }
  #secretFxOverlay.show::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle, rgba(255,255,255,0.55), rgba(255,224,102,0.15) 45%, transparent 72%);
    animation: secretFlashBg 1.5s ease forwards;
  }
  @keyframes secretFlashBg { 0% { opacity: 0; transform: scale(0.4); } 18% { opacity: 1; } 100% { opacity: 0; transform: scale(1.6); } }
  #secretFxBanner { position: relative; text-align: center; transform: scale(0.4); opacity: 0; animation: secretBannerPop 1.6s cubic-bezier(.2,1.5,.4,1) forwards; }
  @keyframes secretBannerPop { 0% { transform: scale(0.3) rotate(-6deg); opacity: 0; } 25% { transform: scale(1.15) rotate(2deg); opacity: 1; } 45% { transform: scale(1) rotate(0deg); } 78% { opacity: 1; } 100% { opacity: 0; transform: scale(1.05); } }
  #secretFxTitle {
    font-size: 30px; font-weight: 900; letter-spacing: 0.5px;
    background: linear-gradient(90deg, #ff5ad1, #ffd54f, #5cf2ff, #ff5ad1); background-size: 300% 100%;
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    animation: secretRainbowShift 1.1s linear infinite; text-shadow: 0 4px 18px rgba(0,0,0,0.4); white-space: nowrap;
  }
  #secretFxSub { margin-top: 8px; font-size: 14px; font-weight: 800; color: #fff; text-shadow: 1px 2px 4px rgba(0,0,0,0.7); }
  .secretSparkle {
    position: absolute; top: 50%; left: 50%; width: 8px; height: 8px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 10px 3px rgba(255,255,255,0.9);
    animation: sparkleFly 1.2s ease-out forwards;
  }
  @keyframes sparkleFly { 0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; } 100% { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.1); opacity: 0; } }

  /* ================= START SCREEN ================= */
  #startScreen { position: fixed; inset: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; background: radial-gradient(ellipse at 50% 20%, #124a68 0%, #071b2a 55%, #020810 100%); text-align: center; padding: 20px; }
  #startTitle { font-size: 42px; font-weight: 900; background: linear-gradient(90deg, var(--accent), var(--gold)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(2px 5px 6px rgba(0,0,0,0.55)); animation: loadBob 2.4s ease-in-out infinite; }
  #startSub { font-size: 13.5px; color: var(--text-dim); max-width: 300px; line-height: 1.5; }
  #startBtn { margin-top: 8px; padding: 15px 44px; border-radius: 999px; border: none; background: linear-gradient(90deg, var(--accent), var(--accent2)); color: #052730; font-weight: 800; font-size: 16px; box-shadow: 0 10px 26px rgba(55,209,200,0.35), 0 8px 20px rgba(0,0,0,0.4); cursor: pointer; letter-spacing: 0.3px; }
  #startBtn:active { filter: brightness(0.92); transform: scale(0.98); }
  #startTips { font-size: 11px; color: var(--text-dim); max-width: 280px; line-height: 1.7; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 10px 14px; }

  /* ================= MODAL (Inventory / Shop) ================= */
  .modalOverlay { position: fixed; inset: 0; z-index: 40; background: rgba(2,8,14,0.68); backdrop-filter: blur(3px); display: none; align-items: center; justify-content: center; padding: 16px; animation: fadeIn 0.15s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .modalOverlay.show { display: flex; }
  .modalBox { background: linear-gradient(165deg, #1d5068, #0a1e2c); border: 3px solid rgba(255,255,255,0.9); border-radius: 24px; width: min(94vw, 460px); max-height: 82vh; display: flex; flex-direction: column; box-shadow: 0 10px 0 rgba(0,0,0,0.35), 0 20px 44px rgba(0,0,0,0.5); }
  .modalHead { display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; border-bottom: 2px dashed rgba(255,255,255,0.24); }
  .modalHead h2 { margin: 0; font-size: 16.5px; font-weight: 800; }
  .modalClose { background: rgba(255,255,255,0.16); border: 2px solid rgba(255,255,255,0.55); color: #fff; width: 32px; height: 32px; border-radius: 50%; font-size: 15px; cursor: pointer; transition: transform 0.1s ease, background 0.12s ease; }
  .modalClose:active { background: rgba(255,255,255,0.3); transform: scale(0.92); }
  .modalBody { overflow-y: auto; padding: 12px 16px; display: flex; flex-direction: column; gap: 9px; }
  .rowItem { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.2); border-radius: 16px; padding: 10px 11px; transition: background 0.12s ease; }
  .rowIcon { width: 42px; height: 42px; border-radius: 11px; flex-shrink: 0; image-rendering: pixelated; box-shadow: 0 3px 8px rgba(0,0,0,0.35); }
  .rowInfo { flex: 1; min-width: 0; }
  .rowName { font-size: 13.5px; font-weight: 700; }
  .rowSub { font-size: 11px; color: var(--text-dim); margin-top: 2px; }
  .rowBtn { background: linear-gradient(90deg, var(--accent), var(--accent2)); border: 2px solid #fff; color: #052730; font-weight: 800; font-size: 12px; padding: 9px 14px; border-radius: 999px; cursor: pointer; white-space: nowrap; box-shadow: 0 4px 0 rgba(0,80,90,0.4), 0 6px 12px rgba(0,0,0,0.3); transition: transform 0.1s ease, box-shadow 0.1s ease; }
  .rowBtn:active { transform: translateY(3px); box-shadow: 0 1px 0 rgba(0,80,90,0.4), 0 2px 6px rgba(0,0,0,0.3); }
  .rowBtn:disabled { background: #33434c; color: rgba(255,255,255,0.35); cursor: default; box-shadow: none; border-color: rgba(255,255,255,0.25); }
  .rowBtn.owned { background: rgba(76,232,138,0.2); color: var(--ok); box-shadow: none; border-color: rgba(76,232,138,0.5); }
  .modalFoot { padding: 11px 16px; border-top: 2px dashed rgba(255,255,255,0.24); display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 600; }
  .modalFoot b { color: var(--gold); }
  .tabBar { display: flex; gap: 7px; padding: 0 16px 10px; }
  .tabBtn { flex: 1; background: rgba(255,255,255,0.06); border: 2px solid rgba(255,255,255,0.22); color: var(--text-dim); padding: 9px; border-radius: 14px; font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.12s ease; }
  .tabBtn.active { background: linear-gradient(90deg, var(--accent), var(--accent2)); color: #052730; border-color: #fff; box-shadow: 0 4px 0 rgba(0,80,90,0.4), 0 6px 12px rgba(0,0,0,0.3); }

  /* ================= HUD EXTRA (pill, badge, reveal) ================= */
  #hud .hudPanel { align-self: flex-start; }
  #xpText { color: rgba(255,255,255,0.75); font-size: 8px; letter-spacing: 0; text-transform: none; font-weight: 700; }
  .iconCircle { position: relative; }
  .notifBadge { position: absolute; top: -7px; right: -7px; min-width: 20px; height: 20px; padding: 0 5px; box-sizing: border-box; border-radius: 999px; background: #ff4d4d; border: 2px solid #fff; color: #fff; font-size: 11px; font-weight: 900; display: none; align-items: center; justify-content: center; box-shadow: 0 2px 0 rgba(0,0,0,0.35); }
  .notifBadge.show { display: flex; }
  #shopDot { background: #ffcf4d; color: #4a2600; }
  #hudPills { display: flex; flex-wrap: wrap; gap: 5px; margin-left: 6px; max-width: 220px; }
  .hudPill { background: linear-gradient(160deg, #2fb8d1, #196c81); border: 2px solid #fff; color: #fff; font-size: 9.5px; font-weight: 800; padding: 5px 9px; border-radius: 999px; cursor: pointer; white-space: nowrap; box-shadow: 0 2px 0 rgba(0,0,0,0.35), 0 4px 8px rgba(0,0,0,0.3); text-shadow: 0 1px 2px rgba(0,0,0,0.4); transition: transform 0.1s ease, box-shadow 0.1s ease; }
  .hudPill:active { transform: translateY(2px); box-shadow: 0 1px 0 rgba(0,0,0,0.35), 0 2px 5px rgba(0,0,0,0.3); }
  #btnSellHud { background: linear-gradient(160deg, #ffcf4d, #e0982a); color: #4a2600; text-shadow: none; }
  #btnAuto { display: none; }
  #btnAuto.on { background: linear-gradient(160deg, #6df0a0, #1fa85a); color: #052a14; text-shadow: none; }
  .rowBtns { display: flex; flex-direction: column; gap: 6px; }

  /* ================= REVEAL IKAN LANGKA ================= */
  #catchReveal { position: fixed; left: 50%; top: 34%; transform: translate(-50%, -50%); z-index: 45; display: none; pointer-events: none; }
  #catchReveal.show { display: block; }
  #catchRevealCard { --rc: #fff; display: flex; align-items: center; gap: 12px; padding: 12px 20px 12px 14px; border-radius: 22px; background: linear-gradient(160deg, #1d5068, #0a1e2c); border: 3px solid var(--rc); box-shadow: 0 6px 0 rgba(0,0,0,0.35), 0 0 22px var(--rc); animation: revealPop var(--dur, 2s) cubic-bezier(.2,1.4,.4,1) forwards; }
  #catchReveal.tier-legendary #catchRevealCard, #catchReveal.tier-mythical #catchRevealCard { padding: 16px 26px 16px 18px; box-shadow: 0 6px 0 rgba(0,0,0,0.35), 0 0 34px var(--rc), 0 0 64px var(--rc); }
  #catchRevealImg { width: 56px; height: 56px; border-radius: 14px; image-rendering: pixelated; background: rgba(255,255,255,0.08); }
  #catchReveal.tier-legendary #catchRevealImg, #catchReveal.tier-mythical #catchRevealImg { width: 72px; height: 72px; }
  #catchRevealTier { font-size: 11px; font-weight: 900; letter-spacing: 1.2px; text-transform: uppercase; color: var(--rc); }
  #catchRevealName { font-size: 17px; font-weight: 900; color: #fff; }
  #catchReveal.tier-mythical #catchRevealName { font-size: 20px; }
  #catchRevealVal { font-size: 12px; font-weight: 700; color: var(--gold); }
  @keyframes revealPop { 0% { transform: scale(0.3); opacity: 0; } 14% { transform: scale(1.12); opacity: 1; } 24% { transform: scale(1); } 82% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0.96) translateY(-10px); } }
  #interactBtn { position: fixed; right: 24px; bottom: 150px; z-index: 16; display: none; font-size: 13px; padding: 10px 18px; background: linear-gradient(160deg, #ffcf4d, #e0982a); color: #4a2600; text-shadow: none; }

/* ===== v1.2 rapihin layout ===== */
#hudPills { position: fixed; top: calc(26px + env(safe-area-inset-top, 0px)); left: 50%; transform: translateX(-50%); margin: 0; max-width: 90vw; flex-wrap: nowrap; justify-content: center; z-index: 11; }
#topRightBW { gap: 8px; }
.iconBtn { width: 52px; }
.iconCircle { width: 46px; height: 46px; }
#fishActionWrap { bottom: 20px; gap: 8px; }
#fishHint { max-width: 230px; text-align: center; font-size: 12px; padding: 5px 12px; }
/* ===== v1.3 safe-area kiri/kanan (notch landscape) ===== */
#hud { left: calc(12px + env(safe-area-inset-left, 0px)); }
#topRightBW { right: calc(10px + env(safe-area-inset-right, 0px)); }
#joystickZone { left: calc(20px + env(safe-area-inset-left, 0px)); }
#fishActionWrap { right: calc(30px + env(safe-area-inset-right, 0px)); }
#interactBtn { right: calc(24px + env(safe-area-inset-right, 0px)); }
</style>
<style>
/* ===== v2.0 gaya Fish It ===== */
#powerZones { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, transparent 0 45%, rgba(123,232,107,.62) 45% 66%, rgba(74,168,255,.72) 66% 78%, rgba(255,194,51,.92) 78% 90%, rgba(74,168,255,.72) 90% 97%, rgba(255,90,90,.6) 97% 100%); }
#powerFill { opacity: .5; }
#powerMarker { z-index: 2; top: 0; bottom: 0; width: 4px; height: auto; border: none; background: #fff; margin-left: -2px; box-shadow: 0 0 6px #fff; filter: none; }
#castRating { position: fixed; left: 50%; bottom: 190px; transform: translateX(-50%); z-index: 17; font-size: 22px; font-weight: 900; letter-spacing: 1px; opacity: 0; pointer-events: none; text-shadow: 0 3px 0 rgba(0,0,0,.45), 0 0 14px currentColor; }
#castRating.show { animation: ratingPop .9s ease forwards; }
@keyframes ratingPop { 0% { opacity: 0; transform: translate(-50%, 10px) scale(.6); } 20% { opacity: 1; transform: translate(-50%, 0) scale(1.2); } 70% { opacity: 1; transform: translate(-50%, -6px) scale(1); } 100% { opacity: 0; transform: translate(-50%, -18px) scale(1); } }
#reelZone { right: auto; left: 0; }
#reelProgressTrack { display: block; width: 100%; height: 9px; border-radius: 999px; background: rgba(0,0,0,.45); border: 2px solid rgba(255,255,255,.7); overflow: hidden; }
#reelProgressFill { transition: width .1s linear; }
#statsRow { display: flex; gap: 5px; align-items: center; margin-top: 4px; font-size: 9px; font-weight: 800; white-space: nowrap; }
#statsRow .st { padding: 1px 6px; border-radius: 7px; background: rgba(0,0,0,.35); border: 1.5px solid rgba(255,255,255,.25); }
#statsRow .stL { color: #7bf08a; border-color: #3fbf5a; }
#statsRow .stS { color: #ffe27a; border-color: #d9a92a; }
#statsRow .stW { color: #8ecbff; border-color: #4a8fd6; }
#invList { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; }
.fishCard { --rc: #9fb4bd; position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px 8px 9px; border-radius: 16px; background: linear-gradient(165deg, rgba(255,255,255,.07), rgba(0,0,0,.28)); border: 2.5px solid var(--rc); box-shadow: 0 0 9px var(--rc); }
.fishCard .fcImg { width: 64px; height: 64px; border-radius: 12px; image-rendering: pixelated; background: rgba(255,255,255,.08); }
.fishCard .fcName { font-size: 12px; font-weight: 800; text-align: center; line-height: 1.2; color: var(--rc); }
.fishCard .fcSub { font-size: 10px; color: var(--text-dim); text-align: center; }
.fishCard .fcCount { position: absolute; top: 6px; left: 8px; font-size: 11px; font-weight: 900; background: rgba(0,0,0,.5); border-radius: 8px; padding: 1px 6px; }
.fishCard .fcMut { position: absolute; top: 6px; right: 8px; font-size: 9px; font-weight: 900; color: #4a2600; background: linear-gradient(160deg, #ffe27a, #e0982a); border-radius: 8px; padding: 1px 6px; }
.fishCard .rowBtn { width: 100%; padding: 7px 6px; font-size: 11px; }
</style>
<style>/* v2.3 fix interact */
#interactBtn { bottom: 215px; }
</style>
<style>
/* ===== v2.8 loading + halaman utama ===== */
:root { --wave: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 12' preserveAspectRatio='none'><path d='M0 6 Q15 0 30 6 T60 6 T90 6 T120 6 V12 H0Z' fill='white'/></svg>"); }
#loadingScreen { background: linear-gradient(180deg, #0d4a6b 0%, #0a2c44 52%, #041522 100%); overflow: hidden; }
#loadingLogo { font-size: 36px; }
#loadingPct { font-size: 12px; font-weight: 800; color: var(--gold); min-height: 14px; }
#loadingTip { max-width: 290px; text-align: center; font-size: 11.5px; line-height: 1.5; color: var(--text-dim); padding: 8px 14px; border-radius: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); }
.wvBox { position: absolute; left: 0; right: 0; bottom: 0; height: 26%; pointer-events: none; }
.wv { position: absolute; left: 0; right: 0; bottom: 0; background: var(--wave) repeat-x; background-size: 240px 100%; animation: wvMove 7s linear infinite; }
.wv.w1 { height: 70%; opacity: .10; }
.wv.w2 { height: 50%; opacity: .16; animation-duration: 5s; animation-direction: reverse; }
.wv.w3 { height: 32%; opacity: .22; animation-duration: 9s; }
@keyframes wvMove { to { background-position-x: 240px; } }
.ldBobber { position: absolute; left: 50%; bottom: 52%; width: 18px; height: 18px; margin-left: -9px; border-radius: 50%; background: linear-gradient(180deg, #fff 0 45%, #e04a3a 45% 100%); border: 2px solid #fff; box-shadow: 0 0 14px rgba(255,255,255,.5); animation: bobFloat 2.2s ease-in-out infinite; }
@keyframes bobFloat { 0%,100% { transform: translateY(0) rotate(-6deg); } 50% { transform: translateY(-9px) rotate(6deg); } }

#startScreen { background: transparent !important; }
#startDeco { position: fixed; inset: 0; z-index: 19; overflow: hidden; pointer-events: none;
  background: linear-gradient(180deg, #1c3f7a 0%, #6a5a9e 28%, #f08a6a 52%, #ffc98a 66%, #0f5577 66.2%, #083049 100%); }
#startScreen[style*="display: none"] + #startDeco, #startScreen[style*="display:none"] + #startDeco { display: none; }
#startDeco .sun { position: absolute; left: 50%; top: 50%; width: 120px; height: 120px; margin-left: -60px; border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #fff6c9, #ffd27a 55%, #ff9e4a); box-shadow: 0 0 60px 20px rgba(255,190,110,.45); animation: sunPulse 5s ease-in-out infinite; }
@keyframes sunPulse { 50% { box-shadow: 0 0 80px 28px rgba(255,190,110,.6); } }
#startDeco .wvBox { height: 36%; }
#startDeco .wv { background-size: 300px 100%; }
#startDeco .wv.w1 { opacity: .14; } #startDeco .wv.w2 { opacity: .2; } #startDeco .wv.w3 { opacity: .3; }
.bub { position: absolute; bottom: -20px; width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.35); border: 1px solid rgba(255,255,255,.5); animation: bubUp linear infinite; }
@keyframes bubUp { to { transform: translateY(-105vh) translateX(18px); opacity: 0; } }
#startTitle { font-size: 46px; letter-spacing: .5px; filter: drop-shadow(0 0 14px rgba(55,209,200,.55)) drop-shadow(2px 5px 6px rgba(0,0,0,.55)); }
#startSub { color: #ffeedd; text-shadow: 1px 1px 3px rgba(0,0,0,.6); }
#startStats { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
#startStats span { padding: 5px 12px; border-radius: 999px; font-size: 11.5px; font-weight: 800; background: rgba(8,22,32,.6); border: 2px solid rgba(255,255,255,.7); box-shadow: 0 3px 0 rgba(0,0,0,.3); }
#startBtn { position: relative; overflow: hidden; border: 3px solid #fff; padding: 16px 52px; font-size: 17px; box-shadow: 0 7px 0 rgba(0,80,90,.55), 0 14px 26px rgba(0,0,0,.4); animation: btnBreath 2.4s ease-in-out infinite; }
#startBtn::after { content: ''; position: absolute; top: 0; bottom: 0; width: 40%; left: -60%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.55), transparent); animation: btnShine 3s ease-in-out infinite; }
@keyframes btnBreath { 50% { transform: scale(1.04); } }
@keyframes btnShine { 0% { left: -60%; } 55%,100% { left: 130%; } }
#startBtn:active { transform: translateY(5px); box-shadow: 0 2px 0 rgba(0,80,90,.55); animation: none; }
#startTips { background: rgba(8,22,32,.55); border-color: rgba(255,255,255,.2); }
@media (orientation: landscape) and (max-height: 520px) { #startDeco .sun { width: 80px; height: 80px; margin-left: -40px; top: 40%; } #startTitle { font-size: 32px; } #ldTipHide, #loadingTip { display: none; } }
@media (prefers-reduced-motion: reduce) { .wv, .bub, .ldBobber, #startBtn, #startBtn::after, #startDeco .sun, #startTitle, #loadingLogo { animation: none !important; } }
</style>
<style>.rowIcon,.fishCard .fcImg,#catchRevealImg{image-rendering:auto!important;object-fit:cover}.fishCard .fcImg{width:84px;height:84px}#catchRevealImg{width:76px;height:76px}#catchReveal.tier-legendary #catchRevealImg,#catchReveal.tier-mythical #catchRevealImg{width:96px;height:96px}</style>
<style id="cfx-v2">
/* ===== v2 efek Secret & Mitos ===== */
#secretFxOverlay.show::before { animation-duration: 2.3s; }
#secretFxOverlay.show::after {
  content: ''; position: absolute; left: 50%; top: 50%; width: 170vmax; height: 170vmax; margin: -85vmax 0 0 -85vmax;
  background: repeating-conic-gradient(from 0deg, rgba(255,90,209,.30) 0 8deg, rgba(92,242,255,.22) 8deg 16deg, rgba(255,213,79,.28) 16deg 24deg, transparent 24deg 32deg);
  -webkit-mask-image: radial-gradient(circle, #000 0, transparent 52%);
  mask-image: radial-gradient(circle, #000 0, transparent 52%);
  animation: cfxSpin 2.7s linear forwards, cfxRaysFade 2.7s ease forwards;
}
#secretFxBanner { animation-duration: 2.7s; }
#secretFxTitle { font-size: 34px; }
.secretSparkle { animation-duration: 1.9s; }
@keyframes cfxSpin { to { transform: rotate(360deg); } }
@keyframes cfxRaysFade { 0% { opacity: 0; } 15% { opacity: 1; } 75% { opacity: .9; } 100% { opacity: 0; } }

#mythFx { position: fixed; inset: 0; z-index: 44; display: none; pointer-events: none; overflow: hidden; }
#mythFx.show { display: block; }
#mythFx.show::before { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 90px 24px rgba(255,79,216,.6), inset 0 0 220px 40px rgba(120,40,255,.35); animation: mythEdge 3.4s ease forwards; }
#mythFx.show::after { content: ''; position: absolute; left: 50%; top: 34%; width: 40px; height: 40px; margin: -20px 0 0 -20px; border: 5px solid #ff4fd8; border-radius: 50%; box-shadow: 0 0 24px #ff4fd8; animation: mythRing 1.5s ease-out forwards; }
.mythSpark { position: absolute; top: 34%; left: 50%; width: 7px; height: 7px; border-radius: 50%; animation: sparkleFly 1.7s ease-out forwards; }
@keyframes mythEdge { 0% { opacity: 0; } 12% { opacity: 1; } 30% { opacity: .55; } 45% { opacity: 1; } 62% { opacity: .55; } 100% { opacity: 0; } }
@keyframes mythRing { 0% { transform: scale(.2); opacity: 1; } 100% { transform: scale(22); opacity: 0; } }
@keyframes mythGlowPulse { from { filter: brightness(1); } to { filter: brightness(1.25); } }
#catchReveal.tier-mythical #catchRevealCard { animation: revealPop var(--dur, 2s) cubic-bezier(.2,1.4,.4,1) forwards, mythGlowPulse .7s ease-in-out infinite alternate; }
#catchReveal.tier-mythical #catchRevealName {
  background: linear-gradient(90deg, #ff4fd8, #ffe27a, #7fe8ff, #ff4fd8); background-size: 300% 100%;
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  animation: secretRainbowShift 1.4s linear infinite;
}
canvas.cfxShake { animation: cfxShake .8s ease-in-out; }
@keyframes cfxShake {
  0%, 100% { transform: translate(0, 0) scale(1.04); }
  15% { transform: translate(-9px, 5px) scale(1.04); }
  30% { transform: translate(8px, -6px) scale(1.04); }
  45% { transform: translate(-7px, -4px) scale(1.04); }
  60% { transform: translate(6px, 5px) scale(1.04); }
  80% { transform: translate(-3px, 2px) scale(1.04); }
}

</style>
<style>
/* PM_V39 reveal ikan lebih kecil */
#catchReveal { top: 26% !important; transform: translate(-50%, -50%) scale(.7) !important; }
#catchRevealCard { padding: 9px 16px 9px 11px !important; gap: 10px !important; }
#catchReveal.tier-legendary #catchRevealCard, #catchReveal.tier-mythical #catchRevealCard { padding: 10px 18px 10px 12px !important; }
#catchRevealImg, #catchReveal.tier-legendary #catchRevealImg, #catchReveal.tier-mythical #catchRevealImg { width: 56px !important; height: 56px !important; }
#catchRevealName { font-size: 16px !important; }
#catchReveal.tier-mythical #catchRevealName { font-size: 18px !important; }
</style>
</head>
<body>

<svg style="position:absolute;width:0;height:0;overflow:hidden;" aria-hidden="true">
  <defs>
    <symbol id="ico-coin" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.2"/></symbol>
    <symbol id="ico-star" viewBox="0 0 24 24"><path d="M12 2.3l2.97 6.28 6.83.86-5.05 4.77 1.34 6.79L12 17.6l-6.09 3.4 1.34-6.79-5.05-4.77 6.83-.86L12 2.3z"/></symbol>
    <symbol id="ico-rod" viewBox="0 0 24 24"><path d="M3.5 20.5L17 7"/><path d="M17 7c1.8.6 2.8 2.4 2 4.3"/><circle cx="19.4" cy="11.6" r="1.3"/></symbol>
    <symbol id="ico-backpack" viewBox="0 0 24 24"><path d="M9 8.2V6.2a3 3 0 0 1 6 0v2"/><rect x="5" y="8" width="14" height="13" rx="3"/><rect x="9.2" y="12" width="5.6" height="4" rx="1"/></symbol>
    <symbol id="ico-cart" viewBox="0 0 24 24"><path d="M3 4h2.2l2.35 12.1a2 2 0 0 0 2 1.65h7.2a2 2 0 0 0 1.96-1.6L20 8.3H6.3"/><circle cx="9.5" cy="20" r="1.3" fill="currentColor" stroke="none"/><circle cx="17" cy="20" r="1.3" fill="currentColor" stroke="none"/></symbol>
  </defs>
</svg>

<div id="loadingScreen">
  <div id="loadingLogo"><img src="data:image/webp;base64," alt="Pancing Mania" style="display:block;margin:0 auto;height:min(30vh,200px);width:auto;max-width:86vw;"></div>
  <div id="loadingBarTrack"><div id="loadingBarFill"></div></div>
  <div id="loadingLabel">Memuat...</div>
</div>

<div id="versionBadge">v4.5</div>

<div id="startScreen" style="display:none;">
  <div id="startTitle"><img src="data:image/webp;base64," alt="Pancing Mania" style="display:block;margin:0 auto;height:min(34vh,230px);width:auto;max-width:86vw;"></div>
  <div id="startSub">Jalan-jalan di pulau, lempar kail, tarik ikan, jual buat naik level!</div>
  <button id="startBtn">▶ MULAI MANCING</button>
  <div id="startTips">Joystick kiri: jalan &nbsp;•&nbsp; Geser layar kanan: lihat sekitar<br>Deket air, tekan PANCING, lepas di zona Perfect, lalu TAP TAP TAP sampai ikan naik!</div>
</div>

<div id="hud">
  <div class="hudPanel">
    <div id="coinsRow">
      <div class="coinBadge"><svg class="ico" style="width:12px;height:12px;color:#7a4a00;"><use href="#ico-coin"/></svg></div>
      <span id="coinsVal">0</span>
      <div id="levelRow">
        <div id="levelVal">1</div>
        <div id="xpMini">
          <div id="xpTrack"><div id="xpFill"></div></div>
          <span id="xpText">0/40</span>
        </div>
      </div>
    </div>
    <div id="gearRow"><span class="gearChip" id="rodChip"><svg class="ico"><use href="#ico-rod"/></svg><b id="rodVal">Starter Rod</b></span><span class="gearChip" id="baitChip"><span class="baitDot"></span><b id="baitVal">Starter</b></span></div>
    <div id="statsRow"></div>
  </div>
  <div id="hudPills">
    <button class="hudPill" id="btnSellHud">Jual Semua</button>
    <button class="hudPill" id="btnIndex">Indeks Ikan</button>
    <button class="hudPill" id="btnAuto">Auto: OFF</button>
    <button class="hudPill" id="btnSound">Suara: ON</button>
  </div>
</div>

<div id="topRightBW">
  <div id="fpsFish">-- FPS</div>
  <div class="iconBtn" id="btnInventory">
    <div class="iconCircle"><svg class="ico" style="width:23px;height:23px;"><use href="#ico-backpack"/></svg><span class="notifBadge" id="invBadge">0</span></div>
    <span class="iconLabel">Tas</span>
  </div>
  <div class="iconBtn" id="btnShop">
    <div class="iconCircle"><svg class="ico" style="width:23px;height:23px;"><use href="#ico-cart"/></svg><span class="notifBadge" id="shopDot">!</span></div>
    <span class="iconLabel">Toko</span>
  </div>
</div>

<div id="camDragZone"></div>
<div id="joystickZone"><div id="joystickBase"></div><div id="joystickThumb"></div></div>

<div id="fishActionWrap">
  <div id="fishHint" style="display:none;"></div>
  <div id="fishBtn"><svg class="ico"><use href="#ico-rod"/></svg><span id="fishBtnLabel">PANCING</span></div>
</div>

<button class="hudPill" id="interactBtn"></button>

<div id="powerWrap">
  <div class="barEndIcon">↺</div>
  <div id="powerTrack"><div id="powerFill"></div><div id="powerZones"></div><div id="powerMarker"></div></div>
  <div class="barEndIcon">▶</div>
</div>

<div id="castRating"></div>

<div id="reelWrap">
  <div id="reelLabelRow">
    <div id="reelLabel">Klik Cepat!</div>
    <div id="reelTapHint">(000)</div>
  </div>
  <div id="reelTrackRow">
    <div class="barEndIcon">⏪</div>
    <div id="reelTrack"><div id="reelZone"></div><div id="reelIndicator"></div></div>
    <div class="barEndIcon">▶</div>
  </div>
  <div id="reelProgressTrack"><div id="reelProgressFill"></div></div>
</div>

<div id="toastWrap"></div>

<div id="catchReveal">
  <div id="catchRevealCard">
    <img id="catchRevealImg" alt="">
    <div>
      <div id="catchRevealTier"></div>
      <div id="catchRevealName"></div>
      <div id="catchRevealVal"></div>
    </div>
  </div>
</div>

<div id="secretFxOverlay">
  <div id="secretFxBanner">
    <div id="secretFxTitle">✨ IKAN RAHASIA! ✨</div>
    <div id="secretFxSub"></div>
  </div>
</div>

<div class="modalOverlay" id="modalInventory">
  <div class="modalBox">
    <div class="modalHead"><h2><svg class="ico" style="width:17px;height:17px;"><use href="#ico-backpack"/></svg> Tas Ikan</h2><button class="modalClose" data-close="modalInventory">✕</button></div>
    <div class="modalBody" id="invList"></div>
    <div class="modalFoot"><span id="invTotalCount">0 ikan</span><button class="rowBtn" id="btnSellAll">Jual Semua</button></div>
  </div>
</div>

<div class="modalOverlay" id="modalIndex">
  <style>
    #modalIndex .modalBox.fxBox{width:min(96vw,800px);max-height:90vh;max-height:90dvh;background:#0d1c27;border:4px solid #05090d;border-radius:14px;overflow:hidden;padding:0}
    .fxTop{display:flex;align-items:center;gap:12px;padding:10px 14px;background:#0a1620;border-bottom:3px solid #05090d}
    .fxTitle{font-size:26px;font-weight:900;color:#fff;text-shadow:0 3px 0 #000,0 0 10px rgba(0,0,0,.6);white-space:nowrap}
    .fxProg{flex:1;min-width:0;background:rgba(0,0,0,.45);border:2px solid #05090d;border-radius:8px;padding:4px 10px 6px}
    .fxProg span{display:block;font-size:13px;font-weight:800;color:#fff;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .fxBar{height:10px;border-radius:5px;background:#111;overflow:hidden}
    .fxBar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#17e6a5,#3df08b);box-shadow:0 0 8px rgba(40,240,160,.6);transition:width .25s}
    .fxMain{display:flex;min-height:0;flex:1;overflow:hidden}
    .fxLoc{flex:none;width:170px;background:#070f16;border-right:3px solid #05090d;overflow-y:auto;padding:0 0 6px}
    .fxLocH{padding:8px 10px;font-size:15px;font-weight:900;color:#fff;background:#111c26;border-bottom:3px solid #05090d}
    .fxLocI{position:relative;display:flex;flex-direction:column;justify-content:center;align-items:center;height:76px;border:0;border-bottom:3px solid #05090d;color:#fff;font-weight:900;font-size:17px;text-shadow:0 2px 0 #000,0 0 6px #000;cursor:pointer;width:100%;opacity:.7}
    .fxLocI small{font-size:11px;font-weight:800;opacity:.95}
    .fxLocI.on{opacity:1;box-shadow:inset 0 0 0 3px #fff}
    .fxRight{flex:1;min-width:0;overflow-y:auto;padding:10px 12px 14px}
    .fxZone{font-size:34px;font-weight:900;color:#fff;text-shadow:0 3px 0 #000;padding:6px 14px;margin-bottom:12px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,.28),rgba(255,255,255,.1))}
    .fxGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:10px}
    .fxCard{position:relative;aspect-ratio:1/1.02;border:3px solid #fff;border-radius:6px;background:linear-gradient(180deg,#2c3f4d,#16222c);box-shadow:inset 0 0 0 3px #05090d,0 3px 8px rgba(0,0,0,.5);overflow:hidden;display:flex;align-items:center;justify-content:center}
    .fxCard img{width:82%;height:82%;object-fit:contain;image-rendering:auto;margin-top:12%;filter:drop-shadow(0 4px 4px rgba(0,0,0,.5))}
    .fxCard .fxN{position:absolute;top:4px;left:4px;right:4px;text-align:center;font-size:13px;font-weight:900;line-height:1.1;color:#fff;-webkit-text-stroke:2.5px #000;paint-order:stroke fill;text-shadow:0 2px 0 #000}
    .fxCard .fxR{position:absolute;left:0;right:0;bottom:0;padding:2px 0;text-align:center;font-size:10px;font-weight:900;color:#fff;text-shadow:0 1px 0 #000;background:rgba(0,0,0,.45)}
    .fxCard.un{border-color:#9aa7ae}
    .fxCard.un .fxN{color:#d0dae0}
    @media (max-width:560px){
      .fxMain{flex-direction:column}
      .fxLoc{width:auto;display:flex;border-right:0;border-bottom:3px solid #05090d;overflow-x:auto;overflow-y:hidden;padding:0}
      .fxLocH{display:none}
      .fxLocI{flex:none;width:132px;height:58px;border-bottom:0;border-right:3px solid #05090d}
      .fxZone{font-size:24px}.fxTitle{font-size:19px}
    }
  </style>
  <div class="modalBox fxBox">
    <div class="fxTop"><div class="fxTitle">Indeks Ikan</div><div class="fxProg"><span id="fxProgTxt"></span><div class="fxBar"><i id="fxBarFill"></i></div></div><button class="modalClose" data-close="modalIndex">✕</button></div>
    <div class="fxMain"><div class="fxLoc" id="fxLoc"></div><div class="fxRight"><div class="fxZone" id="fxZone"></div><div class="fxGrid" id="indexList"></div></div></div>
    <div class="modalFoot"><span id="indexCount">0/0</span><span></span></div>
  </div>
</div>

<div class="modalOverlay" id="modalShop">
  <div class="modalBox">
    <div class="modalHead"><h2><svg class="ico" style="width:17px;height:17px;"><use href="#ico-cart"/></svg> Toko</h2><button class="modalClose" data-close="modalShop">✕</button></div>
    <div class="tabBar">
      <button class="tabBtn active" data-tab="rod">Rod</button>
      <button class="tabBtn" data-tab="bait">Bait</button>
      <button class="tabBtn" data-tab="item">Item</button>
    </div>
    <div class="modalBody" id="shopList"></div>
    <div class="modalFoot"><span><svg class="ico" style="width:15px;height:15px;color:var(--gold);"><use href="#ico-coin"/></svg> <b id="shopCoins">0</b></span><span></span></div>
  </div>
</div>

<!-- pm-ext -->
<style>
#evBadge{position:fixed;top:calc(104px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);z-index:11;display:none;padding:3px 12px;border-radius:999px;font-size:11px;font-weight:900;color:#fff;border:2px solid #fff;text-shadow:1px 1px 2px #000;white-space:nowrap;pointer-events:none}
#menuPanel{max-height:calc(100dvh - 70px);overflow-y:auto}
@media (orientation:landscape) and (max-height:520px){#evBadge{top:calc(8px + env(safe-area-inset-top,0px))}}
</style>
<script>
window.PMExt = function (C) {
  var T = THREE, $ = function (i) { return document.getElementById(i); }, S = function () { return C.save; };
  function hash(s) { var h = 2166136261; for (var i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }
  function mkModal(id, title) {
    var ov = document.createElement('div'); ov.className = 'modalOverlay'; ov.id = id;
    ov.innerHTML = '<div class="modalBox"><div class="modalHead"><h2>' + title + '</h2><button class="modalClose">✕</button></div><div class="modalBody"></div><div class="modalFoot"><span></span><span></span></div></div>';
    document.body.appendChild(ov);
    ov.querySelector('.modalClose').onclick = function () { ov.classList.remove('show'); };
    return { ov: ov, body: ov.querySelector('.modalBody'), foot: ov.querySelector('.modalFoot span'), open: function () { ov.classList.add('show'); } };
  }
  function row(icon, name, sub, btn) { return '<div class="rowItem">' + icon + '<div class="rowInfo"><div class="rowName">' + name + '</div><div class="rowSub">' + sub + '</div></div>' + (btn || '') + '</div>'; }
  function lbl(e) { return (e.mutation.name ? e.mutation.name + ' ' : '') + e.fish.name; }

  /* ===== TROFI + REKOR ===== */
  function st() { var s = S(); if (!s.stats) s.stats = { catches: 0, byR: {}, mut: 0, shiny: 0, deep: 0, heavy: 0, secret: 0 }; if (!s.ach) s.ach = {}; return s.stats; }
  function rc(min) { var b = st().byR, n = 0; C.RARITY_ORDER.forEach(function (r, i) { if (i >= min) n += b[r] || 0; }); return n; }
  var D = function () { return Object.keys(S().discovered || {}).length; };
  var ACH = [
    ['Pemancing Pemula', 'Tangkap 1 ikan', 1, 50, function () { return st().catches; }],
    ['Tukang Pancing', 'Tangkap 100 ikan', 100, 300, function () { return st().catches; }],
    ['Legenda Dermaga', 'Tangkap 500 ikan', 500, 1500, function () { return st().catches; }],
    ['Mata Jeli', '10 ikan Langka atau lebih', 10, 200, function () { return rc(2); }],
    ['Epik!', 'Tangkap ikan Epik', 1, 400, function () { return rc(3); }],
    ['Legendaris', 'Tangkap ikan Legendaris', 1, 1200, function () { return rc(4); }],
    ['Mitos Hidup', 'Tangkap ikan Mitos', 1, 4000, function () { return rc(5); }],
    ['Rahasia Terbongkar', 'Tangkap ikan Rahasia', 1, 15000, function () { return st().secret; }],
    ['Ilmuwan Mutasi', 'Tangkap 20 ikan mutasi', 20, 600, function () { return st().mut; }],
    ['Berkilau', 'Tangkap ikan Shiny', 1, 800, function () { return st().shiny; }],
    ['Kolektor', 'Temukan 15 jenis ikan', 15, 500, D],
    ['Ensiklopedia', 'Lengkapi Koleksi', C.FISH_TABLE.length, 8000, D],
    ['Raksasa', 'Tangkap ikan 1.000 kg+', 1, 1000, function () { return st().heavy; }],
    ['Master Level', 'Capai Level 20', 20, 1500, function () { return S().level; }],
    ['Sultan Joran', 'Miliki Astral Rod', 1, 2000, function () { return (S().ownedRods || []).indexOf('legendaris') >= 0 ? 1 : 0; }],
    ['Penarik Gacha', 'Lakukan 50 kali Gacha Rod', 50, 600, function () { return (S().gacha || {}).total || 0; }],
    ['Veteran Dermaga', 'Tangkap 1.000 ikan', 1000, 3000, function () { return st().catches; }],
    ['Raja Pancing', 'Tangkap 5.000 ikan', 5000, 12000, function () { return st().catches; }],
    ['Pemburu Epik', 'Tangkap 25 ikan Epik atau lebih', 25, 2500, function () { return rc(3); }],
    ['Pemburu Legenda', 'Tangkap 10 ikan Legendaris atau lebih', 10, 6000, function () { return rc(4); }],
    ['Kolektor Mitos', 'Tangkap 5 ikan Mitos', 5, 10000, function () { return rc(5); }],
    ['Pemburu Rahasia', 'Tangkap 3 ikan Rahasia', 3, 40000, function () { return st().secret; }],
    ['Ahli Mutasi', 'Tangkap 100 ikan mutasi', 100, 5000, function () { return st().mut; }],
    ['Level 40', 'Capai Level 40', 40, 5000, function () { return S().level; }],
    ['Level 60', 'Capai Level 60', 60, 12000, function () { return S().level; }],
    ['Kaya Raya', 'Punya 100.000 koin', 100000, 5000, function () { return S().coins; }],
    ['Sultan', 'Punya 1.000.000 koin', 1000000, 25000, function () { return S().coins; }],
    ['Terlahir Kembali', 'Lakukan 1 Rebirth', 1, 5000, function () { return S().rebirth || 0; }],
    ['Reinkarnasi', 'Lakukan 5 Rebirth', 5, 25000, function () { return S().rebirth || 0; }],
    ['Pecinta Hewan', 'Kumpulkan 3 jenis Pet', 3, 3000, function () { return Object.keys(S().pets || {}).length; }],
    ['Kolektor Skin', 'Kumpulkan 8 skin rod', 8, 4000, function () { return Object.keys(S().skins || {}).length; }]
  ];
  function checkAch() {
    st(); var s = S(), hit = false;
    ACH.forEach(function (a, i) {
      if (s.ach[i] || a[4]() < a[2]) return;
      s.ach[i] = 1; s.coins += a[3]; C.addXp(Math.round(a[3] / 10)); hit = true;
      C.toast('Trofi: ' + a[0] + ' (+' + a[3] + ' koin)'); C.Sfx.levelUp(); C.vibe([40, 30, 40]);
    });
    if (hit) { C.persist(); C.refresh(); }
  }
  function addRecord(c) {
    var s = S(); s.rec = s.rec || []; s.recV = s.recV || [];
    var e = { n: lbl(c), w: c.weight || 0, v: c.value, r: c.fish.rarity };
    s.rec.push(e); s.rec.sort(function (a, b) { return b.w - a.w; }); s.rec.length = Math.min(10, s.rec.length);
    s.recV.push(e); s.recV.sort(function (a, b) { return b.v - a.v; }); s.recV.length = Math.min(5, s.recV.length);
  }
  C.hookFinish(function (ok, c) {
    if (!ok || !c) return;
    var s = st(), f = c.fish;
    s.catches++; s.byR[f.rarity] = (s.byR[f.rarity] || 0) + 1;
    if (c.mutation && c.mutation.id !== 'normal') s.mut++;
    if (c.mutation && c.mutation.shiny) s.shiny++;
    if (f.rarity === 'secret') s.secret++;
    if ((c.weight || 0) >= 1000) s.heavy++;
    addRecord(c); checkAch(); C.persist(); C.refresh();
  });
  /* PM_V41 gelar trofi */
  var GELAR = [[0, 'Pemancing Baru'], [5, 'Pemancing Handal'], [10, 'Ahli Pancing'], [16, 'Pakar Laut'], [22, 'Legenda Pancing'], [28, 'Penguasa Samudra']];
  function achTitle(n) { var t = GELAR[0][1]; GELAR.forEach(function (g) { if (n >= g[0]) t = g[1]; }); if (n >= ACH.length) t = 'Maestro Samudra'; return t; }
  window.PMTitle = function () { var s = S(), n = 0; Object.keys(s.ach || {}).forEach(function (k) { if (s.ach[k]) n++; }); return achTitle(n); };
  var mT = mkModal('modalTrofi', 'Trofi');
  function renderT() {
    st(); var s = S(), n = 0;
    mT.body.innerHTML = ACH.map(function (a, i) {
      var done = !!s.ach[i]; if (done) n++;
      return row('', a[0], a[1] + ' • ' + Math.min(a[2], a[4]()) + '/' + a[2] + ' • Hadiah ' + a[3] + ' koin', '<button class="rowBtn' + (done ? ' owned' : '') + '" disabled>' + (done ? 'Selesai' : 'Berjalan') + '</button>');
    }).join('');
    mT.foot.textContent = n + '/' + ACH.length + ' trofi • Gelar: ' + achTitle(n);
  }
  var mR = mkModal('modalRekor', 'Papan Rekor');
  function renderR() {
    var s = S(), h = '';
    if (!(s.rec || []).length) h = '<div class="rowSub" style="text-align:center;padding:16px">Belum ada rekor. Yuk mancing!</div>';
    else {
      h = '<div class="rowName">Ikan Terberat</div>';
      s.rec.forEach(function (e, i) { h += row('', (i + 1) + '. ' + e.n, C.fmtKg(e.w) + ' • ' + C.RARITY_LABEL[e.r]); });
      h += '<div class="rowName" style="margin-top:6px">Ikan Termahal</div>';
      (s.recV || []).forEach(function (e, i) { h += row('', (i + 1) + '. ' + e.n, e.v + ' koin • ' + C.RARITY_LABEL[e.r]); });
    }
    mR.body.innerHTML = h; mR.foot.textContent = 'Rekor lokal • Total ' + st().catches + ' tangkapan';
  }

  /* ===== HARGA PASAR HARIAN ===== */
  function dk() { var d = new Date(); return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); }
  window.PMP = function (id) { return Math.round((0.7 + (hash(dk() + id) % 1000) / 1000 * 0.9) * 100) / 100; };
  function mkt() { return C.FISH_TABLE.map(function (f) { return { f: f, m: window.PMP(f.id) }; }).sort(function (a, b) { return b.m - a.m; }); }
  var mP = mkModal('modalPasar', 'Pasar Hari Ini');
  function renderP() {
    var l = mkt(), list = l.slice(0, 8).concat(l.slice(-3));
    mP.body.innerHTML = '<div class="rowSub">Harga jual berubah tiap hari. Jual yang lagi naik!</div>' + list.map(function (o) {
      var col = o.m >= 1.3 ? '#4ce88a' : o.m <= 0.85 ? '#ff5a6a' : '#f2fbfc';
      return row('', o.f.name, 'Dasar ' + o.f.value + ' • Hari ini ' + Math.round(o.f.value * o.m) + ' koin', '<b style="color:' + col + '">' + (o.m >= 1 ? '▲' : '▼') + ' x' + o.m.toFixed(2) + '</b>');
    }).join('');
    mP.foot.textContent = 'Reset tiap ganti hari';
  }
  var sb = $('startBtn');
  if (sb) sb.addEventListener('click', function () { setTimeout(function () { var t = mkt()[0]; C.toast('Pasar hari ini: ' + t.f.name + ' x' + t.m.toFixed(2)); }, 2200); });

  /* ===== JORAN PER TIER ===== */
  var rodMat = C.rodMesh.material, lastRod = '';
  function applyRod(t) {
    if (window.pmRodTick) { window.pmRodTick(t); return; }
    var id = S().rod, idx = C.ROD_TIERS.findIndex(function (r) { return r.id === id; });
    if (id !== lastRod) { lastRod = id; var col = id === 'bambu' ? new T.Color(0x8a5a2b) : new T.Color(C.GEAR_COLORS.rod[id] || '#9fb4bd'); rodMat.color.copy(col); rodMat.emissive.copy(col); }
    if (idx >= 5) rodMat.emissive.setHSL((t * 0.2) % 1, 0.9, 0.55);
    rodMat.emissiveIntensity = idx >= 5 ? 0.7 : idx >= 3 ? 0.3 + 0.15 * Math.sin(t * 3) : idx >= 2 ? 0.12 : 0;
  }

  /* ===== KARAKTER ===== */
  var SHIRTS = { biru: ['Biru', 0x4ac0e0, 0], merah: ['Merah', 0xd8483a, 150], hijau: ['Hijau', 0x4cbf6a, 150], ungu: ['Ungu', 0x9b5be0, 300], hitam: ['Hitam', 0x22262c, 300], emas: ['Emas', 0xffc233, 1500] };
  var PANTS = { navy: ['Navy', 0x33485f, 0], krem: ['Krem', 0xcdb98a, 100], hitam: ['Hitam', 0x1d2126, 150], merah: ['Merah', 0x8a2b2b, 200], putih: ['Putih', 0xe6e9ee, 250] };
  var HATS = { jerami: ['Jerami', 0xf2e4b8, 0xd8483a, 0], hitam: ['Hitam', 0x2a2d33, 0xffc233, 200], merah: ['Merah', 0xd8483a, 0xffffff, 300], emas: ['Emas', 0xffc233, 0x8a4a00, 1500], none: ['Tanpa Topi', 0, 0, 0] };
  var GRP = { shirt: SHIRTS, pants: PANTS, hat: HATS };
  var hatM = [], strawMat = null, bandMat = null;
  C.player.children.forEach(function (m) {
    if (!m.material || !m.material.color) return;
    var h = m.material.color.getHex();
    if (h === 0xf2e4b8) { hatM.push(m); strawMat = m.material; }
    else if (h === 0xd8483a && m.geometry && m.geometry.type === 'CylinderGeometry') { hatM.push(m); bandMat = m.material; }
  });
  function cos() { var s = S(); if (!s.cos) s.cos = { shirt: 'biru', pants: 'navy', hat: 'jerami', own: {} }; return s.cos; }
  var lastCos = '';
  function applyCos() {
    var c = cos(), key = c.shirt + c.pants + c.hat; if (key === lastCos) return; lastCos = key;
    var sh = SHIRTS[c.shirt] || SHIRTS.biru, pa = PANTS[c.pants] || PANTS.navy, ha = HATS[c.hat] || HATS.jerami;
    C.body.material.color.setHex(sh[1]); C.legL.material.color.setHex(pa[1]);
    hatM.forEach(function (m) { m.visible = c.hat !== 'none'; });
    if (c.hat !== 'none') { if (strawMat) strawMat.color.setHex(ha[1]); if (bandMat) bandMat.color.setHex(ha[2]); }
  }
  var mC = mkModal('modalChar', 'Karakter');
  function renderChar() {
    var c = cos(), h = '';
    [['shirt', 'Baju'], ['pants', 'Celana'], ['hat', 'Topi']].forEach(function (g) {
      h += '<div class="rowName" style="margin-top:4px">' + g[1] + '</div>';
      Object.keys(GRP[g[0]]).forEach(function (k) {
        var it = GRP[g[0]][k], price = g[0] === 'hat' ? it[3] : it[2], own = price === 0 || c.own[g[0] + ':' + k], on = c[g[0]] === k;
        var bg = it[1] ? '#' + ('000000' + it[1].toString(16)).slice(-6) : '#33434c';
        h += row('<div class="rowIcon" style="background:' + bg + ';border:2px solid #fff"></div>', it[0], own ? 'Dimiliki' : price + ' koin',
          '<button class="rowBtn' + (on ? ' owned' : '') + '" data-c="' + g[0] + '|' + k + '"' + (on || (!own && S().coins < price) ? ' disabled' : '') + '>' + (on ? 'Dipakai' : own ? 'Pakai' : 'Beli') + '</button>');
      });
    });
    mC.body.innerHTML = h; mC.foot.textContent = 'Koin: ' + S().coins;
  }
  mC.body.addEventListener('click', function (ev) {
    var b = ev.target.closest('button'); if (!b || b.disabled) return;
    var p = b.dataset.c.split('|'), g = p[0], k = p[1], c = cos(), it = GRP[g][k], price = g === 'hat' ? it[3] : it[2];
    if (price > 0 && !c.own[g + ':' + k]) { if (S().coins < price) return; S().coins -= price; c.own[g + ':' + k] = 1; C.Sfx.sell(); C.toast('Beli ' + it[0] + '!'); }
    c[g] = k; C.persist(); C.refresh(); renderChar();
  });

  /* ===== AKUARIUM DIHAPUS (v4.12): diganti Mesin Gacha 3D, lihat PM-GACHA ===== */
  var AQ = { x: 4.5, z: 19 };
  function icon(e) { return '<img class="rowIcon" src="' + C.fishIconCanvas(e.fish, e.mutation) + '">'; }
  (function () { /* ikan yang dulu dipajang balik ke tas */
    var done = false;
    C.hookAnim(function () {
      if (done) return;
      var s = S(); if (!s || !s.inventory) return;
      done = true;
      var a = s.aqua; if (!a || !a.length) { delete s.aqua; return; }
      var n = 0;
      a.forEach(function (e) {
        if (!e || !e.fish || !e.mutation) return;
        var k = e.fish.id + '|' + e.mutation.id;
        s.inventory[k] = s.inventory[k] || { fish: e.fish, mutation: e.mutation, count: 0 };
        s.inventory[k].count++; n++;
      });
      delete s.aqua; C.persist(); C.refresh();
      if (n) C.toast('Akuarium dihapus: ' + n + ' ikan dikembalikan ke tas');
    });
  })();

  /* === BOAT MODELS v4.6 (builder murni THREE, tanpa asset) === */
function pmBuildBoat(id) {
  var T = THREE;
  function M(c, o) { o = o || {}; o.color = c; if (o.roughness === undefined) o.roughness = 0.65; return new T.MeshStandardMaterial(o); }
  var G = new T.Group();
