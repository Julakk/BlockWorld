    win.position.set(1.0, 1.35, 1.62); g.add(win);
    const sill = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.12, 0.3), new THREE.MeshLambertMaterial({ color: 0x4a3420 }));
    sill.position.set(1.0, 0.85, 1.72); g.add(sill);
    for (let i = 0; i < 7; i++) {
