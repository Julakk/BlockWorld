    g.fillStyle = '#111'; g.beginPath(); g.arc(ex - er * 0.12, ey, er * 0.6, 0, 7); g.fill();
    g.fillStyle = '#fff'; g.beginPath(); g.arc(ex - er * 0.3, ey - er * 0.25, er * 0.22, 0, 7); g.fill();
    if (o.lamp) { g.strokeStyle = c1; g.lineWidth = 2; g.beginPath(); g.moveTo(hx + L * 0.4, cy - H); g.quadraticCurveTo(hx + L * 0.2, cy - H * 2, hx - 4, cy - H * 1.4); g.stroke();
      var gl = g.createRadialGradient(hx - 4, cy - H * 1.4, 0, hx - 4, cy - H * 1.4, 14); gl.addColorStop(0, '#fff8b0'); gl.addColorStop(1, 'rgba(255,240,120,0)'); g.fillStyle = gl; g.fillRect(hx - 20, cy - H * 1.4 - 16, 36, 36); }
    if (o.pearl) { var pg = g.createRadialGradient(hx + 4, cy + H * 0.2, 1, hx + 6, cy + H * 0.25, 9); pg.addColorStop(0, '#fff'); pg.addColorStop(1, '#c9b8e8'); g.fillStyle = pg; g.beginPath(); g.arc(hx + 6, cy + H * 0.25, 8, 0, 7); g.fill(); }
  }
  function hdEyes(g, pts, r) { pts.forEach(function (p) { g.fillStyle = '#fff'; g.beginPath(); g.arc(p[0], p[1], r, 0, 7); g.fill(); g.fillStyle = '#111'; g.beginPath(); g.arc(p[0], p[1], r * 0.6, 0, 7); g.fill(); }); }
  function hdJelly(g, c1, c2) {
    var cx = 96, cy = 84, gr = g.createRadialGradient(cx - 10, cy - 20, 4, cx, cy, 50); gr.addColorStop(0, 'rgba(255,255,255,.95)'); gr.addColorStop(1, c1);
    g.globalAlpha = 0.85; g.fillStyle = gr; g.beginPath(); g.moveTo(cx - 48, cy + 10); g.bezierCurveTo(cx - 50, cy - 60, cx + 50, cy - 60, cx + 48, cy + 10); g.quadraticCurveTo(cx, cy + 22, cx - 48, cy + 10); g.fill(); g.globalAlpha = 1;
    g.strokeStyle = c2; g.lineWidth = 3; g.lineCap = 'round';
    for (var i = -3; i <= 3; i++) { g.beginPath(); g.moveTo(cx + i * 13, cy + 14); g.bezierCurveTo(cx + i * 13 + 8, cy + 40, cx + i * 13 - 8, cy + 60, cx + i * 13 + 4, cy + 84); g.stroke(); }
  }
  function hdSquid(g, c1, c2, big) {
    var cx = 96, gr = g.createLinearGradient(0, 20, 0, 110); gr.addColorStop(0, c1); gr.addColorStop(1, c2);
    g.fillStyle = gr; g.beginPath(); g.moveTo(cx, 14); g.bezierCurveTo(cx + 38, 40, cx + 30, 90, cx + 14, 108); g.lineTo(cx - 14, 108); g.bezierCurveTo(cx - 30, 90, cx - 38, 40, cx, 14); g.fill();
    g.strokeStyle = c1; g.lineWidth = big ? 6 : 5; g.lineCap = 'round';
    for (var i = -4; i <= 4; i++) { g.beginPath(); g.moveTo(cx + i * 3.5, 106); g.bezierCurveTo(cx + i * 9, 130, cx + i * 15 - 6, 140, cx + i * 17, 170); g.stroke(); }
    hdEyes(g, [[cx - 15, 98], [cx + 15, 98]], 6);
  }
  function hdRay(g, c1, c2) {
    var cx = 96, cy = 96, gr = g.createLinearGradient(0, 50, 0, 140); gr.addColorStop(0, c1); gr.addColorStop(1, c2);
    g.strokeStyle = c1; g.lineWidth = 4; g.beginPath(); g.moveTo(cx, 138); g.lineTo(cx, 184); g.stroke();
    g.fillStyle = gr; g.beginPath(); g.moveTo(cx, 60); g.bezierCurveTo(cx + 30, 50, cx + 70, 70, cx + 88, 96); g.bezierCurveTo(cx + 60, 104, cx + 40, 130, cx, 138);
    g.bezierCurveTo(cx - 40, 130, cx - 60, 104, cx - 88, 96); g.bezierCurveTo(cx - 70, 70, cx - 30, 50, cx, 60); g.fill();
    hdEyes(g, [[cx - 10, 72], [cx + 10, 72]], 4);
  }
  function hdTurtle(g, c1, c2) {
    var cx = 96, cy = 100; g.fillStyle = c2;
    [[-46, -26], [46, -26], [-40, 34], [40, 34]].forEach(function (p) { g.beginPath(); g.ellipse(cx + p[0], cy + p[1], 20, 11, p[0] < 0 ? -0.6 : 0.6, 0, 7); g.fill(); });
    g.beginPath(); g.arc(cx, cy - 56, 16, 0, 7); g.fill();
    var gr = g.createRadialGradient(cx - 14, cy - 14, 6, cx, cy, 56); gr.addColorStop(0, c2); gr.addColorStop(1, c1);
    g.fillStyle = gr; g.beginPath(); g.ellipse(cx, cy, 44, 52, 0, 0, 7); g.fill();
    g.strokeStyle = 'rgba(0,0,0,.3)'; g.lineWidth = 2; for (var i = -1; i <= 1; i++) { g.beginPath(); g.ellipse(cx + i * 22, cy, 12, 16, 0, 0, 7); g.stroke(); }
    hdEyes(g, [[cx - 7, cy - 60], [cx + 7, cy - 60]], 3.5);
  }
  function hdSerp(g, c1, c2, dragon) {
    var gr = g.createLinearGradient(0, 40, 192, 150); gr.addColorStop(0, c1); gr.addColorStop(1, c2);
    g.strokeStyle = gr; g.lineWidth = dragon ? 22 : 20; g.lineCap = 'round'; g.beginPath();
    if (dragon) { g.moveTo(20, 130); g.bezierCurveTo(50, 60, 80, 160, 110, 100); g.bezierCurveTo(130, 60, 150, 70, 160, 80); }
    else { g.moveTo(108, 40); g.quadraticCurveTo(70, 50, 80, 100); g.quadraticCurveTo(90, 150, 120, 150); g.quadraticCurveTo(142, 150, 136, 128); }
    g.stroke();
    g.lineWidth = 8; g.beginPath(); if (dragon) { g.moveTo(160, 80); g.lineTo(182, 74); } else { g.moveTo(108, 40); g.lineTo(86, 34); } g.stroke();
    hdEyes(g, [dragon ? [162, 74] : [106, 38]], 4);
  }
  function fishIconCanvas(fish, mutation, silhouette) {
    var key = fish.id + '|' + (mutation ? mutation.id : '') + '|' + (silhouette ? 1 : 0); if (IC[key]) return IC[key];
    var S = 192, out = mkC(S, S), g = out.getContext('2d'), f = mkC(S, S), fg = f.getContext('2d');
    var m = FM[fish.id] || ['f', '#9fb4bd', '#f0f6f8', {L: 55, H: 22}], t = m[0], o = m[3] || {};
    if (t === 'f' || t === 's' || t === 'w') {
      var d = t === 's' ? {L: 72, H: 23, shark: 1, dors: 1.3} : t === 'w' ? {L: 78, H: 32, whale: 1} : {};
      hdBody(fg, Object.assign({L: 55, H: 22}, d, o), m[1], m[2]);
    } else if (t === 'j') hdJelly(fg, m[1], m[2]); else if (t === 'q') hdSquid(fg, m[1], m[2], o.big);
    else if (t === 'r') hdRay(fg, m[1], m[2]); else if (t === 't') hdTurtle(fg, m[1], m[2]); else hdSerp(fg, m[1], m[2], t === 'g');
    var mt = mutation && mutation.tint;
    if (silhouette) { fg.globalCompositeOperation = 'source-in'; fg.fillStyle = '#0a1520'; fg.fillRect(0, 0, S, S); }
    else if (mt) {
      fg.globalCompositeOperation = 'source-atop';
      if (mt === 'rainbow') { var rg = fg.createLinearGradient(0, 0, S, S); ['#ff5a5a', '#ffd45a', '#5affb0', '#5ab4ff', '#c05aff'].forEach(function (c, i) { rg.addColorStop(i / 4, c); }); fg.globalAlpha = 0.6; fg.fillStyle = rg; }
      else { fg.globalAlpha = 0.5; fg.fillStyle = 'rgb(' + mt.join(',') + ')'; }
      fg.fillRect(0, 0, S, S); fg.globalAlpha = 1;
    }
    var col = fish.rarity === 'secret' ? '#ffd54f' : RARITY_COLOR[fish.rarity];
    var bg = g.createRadialGradient(S / 2, S / 2, 10, S / 2, S / 2, S * 0.62); bg.addColorStop(0, 'rgba(255,255,255,.14)'); bg.addColorStop(1, 'rgba(255,255,255,0)'); g.fillStyle = bg; g.fillRect(0, 0, S, S);
    if (!silhouette) { g.shadowColor = col; g.shadowBlur = 16; }
    g.drawImage(f, 0, 0); g.shadowBlur = 0;
    if (mutation && mutation.shiny && !silhouette) { g.strokeStyle = '#fff'; g.lineWidth = 3; g.lineCap = 'round'; [[150, 34, 11], [34, 150, 8], [158, 146, 9]].forEach(function (q) { g.beginPath(); g.moveTo(q[0] - q[2], q[1]); g.lineTo(q[0] + q[2], q[1]); g.moveTo(q[0], q[1] - q[2]); g.lineTo(q[0], q[1] + q[2]); g.stroke(); }); }
    return (IC[key] = out.toDataURL());
  }
  function fishIconCanvasOld(fish, mutation, silhouette) {
    const c = document.createElement('canvas'); c.width = c.height = 80; // 2x resolusi biar tajam pas dizoom di kartu reveal
    const g = c.getContext('2d');
    let col = RARITY_COLOR[fish.rarity];
    if (fish.rarity === 'secret') {
      const gsec = g.createLinearGradient(0, 0, 80, 80);
      gsec.addColorStop(0, '#fff6c9'); gsec.addColorStop(0.5, '#ffd54f'); gsec.addColorStop(1, '#ff5ad1');
      col = gsec;
    }
    if (mutation && mutation.tint === 'rainbow') {
      const grad = g.createLinearGradient(0, 0, 80, 80);
      grad.addColorStop(0, '#ff5a5a'); grad.addColorStop(0.5, '#5affd0'); grad.addColorStop(1, '#c05aff');
      col = grad;
    } else if (mutation && mutation.tint) {
      col = 'rgb(' + mutation.tint.join(',') + ')';
    }
    if (silhouette) col = '#0d1b24';
    g.fillStyle = 'rgba(255,255,255,0.06)'; g.fillRect(0, 0, 80, 80);
    g.fillStyle = col;
    g.beginPath();
    g.ellipse(36, 40, 26, 16, 0, 0, Math.PI * 2); g.fill();
    g.beginPath();
    g.moveTo(60, 40); g.lineTo(76, 24); g.lineTo(76, 56); g.closePath(); g.fill();
    g.fillStyle = 'rgba(0,0,0,0.55)';
    g.beginPath(); g.arc(20, 36, 3.2, 0, Math.PI * 2); g.fill();
    if (mutation && mutation.shiny) {
      g.fillStyle = '#fff';
      [[58, 16, 6], [16, 62, 4.5], [68, 60, 5]].forEach(function (q) {
        const x = q[0], y = q[1], r = q[2], k = r * 0.3;
        g.beginPath(); g.moveTo(x, y - r); g.lineTo(x + k, y - k); g.lineTo(x + r, y); g.lineTo(x + k, y + k);
        g.lineTo(x, y + r); g.lineTo(x - k, y + k); g.lineTo(x - r, y); g.lineTo(x - k, y - k); g.closePath(); g.fill();
      });
    }
    return c.toDataURL();
  }

  // ================= SETUP THREE.JS =================
  const canvas = document.createElement('canvas');
  document.body.appendChild(canvas);
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 2 : 2.5));
  renderer.setSize(window.innerWidth, window.innerHeight);

  const scene = new THREE.Scene();
  scene.background = makeSkyTexture();
  scene.fog = new THREE.Fog(0xf3cfae, isMobile ? 40 : 70, isMobile ? 110 : 180);

  const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 500);

  const hemiLight = new THREE.HemisphereLight(0xfff0dd, 0x3a4a5a, 0.9);
  scene.add(hemiLight);
  const sunLight = new THREE.DirectionalLight(0xffc890, 1.0);
  sunLight.position.set(-45, 38, 30);
  scene.add(sunLight);

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  // ================= PULAU =================
  const ISLAND_RADIUS = 34;
  const islandGeo = new THREE.CircleGeometry(ISLAND_RADIUS, 48, 0);
  islandGeo.rotateX(-Math.PI / 2);
  // sedikit gelombang lembut biar gak flat banget
  const posAttr = islandGeo.attributes.position;
  for (let i = 0; i < posAttr.count; i++) {
    const x = posAttr.getX(i), z = posAttr.getZ(i);
    const d = Math.sqrt(x * x + z * z) / ISLAND_RADIUS;
    const h = Math.sin(x * 0.15) * Math.cos(z * 0.15) * 0.7 * (1 - d);
    posAttr.setY(i, h);
  }
  islandGeo.computeVertexNormals();
  const islandMat = new THREE.MeshLambertMaterial({ map: makeIslandTexture() });
  const island = new THREE.Mesh(islandGeo, islandMat);
  scene.add(island);
  function islandHeightAt(x, z) {
    const d = Math.sqrt(x * x + z * z) / ISLAND_RADIUS;
    return Math.sin(x * 0.15) * Math.cos(z * 0.15) * 0.7 * (1 - Math.min(1, d));
  }

  // ================= AIR =================
  const waterGeo = new THREE.CircleGeometry(300, 48);
  waterGeo.rotateX(-Math.PI / 2);
  const waterTex = makeWaterTexture();
  const waterMat = new THREE.MeshLambertMaterial({ map: waterTex, transparent: true, opacity: 0.88 });
  const water = new THREE.Mesh(waterGeo, waterMat);
  water.position.y = -0.35;
  scene.add(water);

  // ================= POHON KELAPA (dekorasi) =================
  const trunkGeo = new THREE.CylinderGeometry(0.18, 0.26, 3.2, 10);
  const trunkMat = new THREE.MeshLambertMaterial({ color: 0x7a5a34 });
  const frondGeo = new THREE.BoxGeometry(1.9, 0.05, 0.42);
  const frondMats = [new THREE.MeshLambertMaterial({ color: 0x3d9a4a }), new THREE.MeshLambertMaterial({ color: 0x2f8640 })];
  const nutGeo = new THREE.SphereGeometry(0.13, 10, 8);
  const nutMat = new THREE.MeshLambertMaterial({ color: 0x5a3b1e });
  const treeRng = makeRng(2024);
  const trees = new THREE.Group();
  function addPalm(x, z, lean) {
    const y = islandHeightAt(x, z);
    const trunk = new THREE.Mesh(trunkGeo, trunkMat);
    trunk.position.set(x, y + 1.6, z);
    trunk.rotation.z = lean;
    trees.add(trunk);
    const cx = x - Math.sin(lean) * 1.6, cy = y + 3.1;
    for (let k = 0; k < 6; k++) {
      const a2 = (k / 6) * Math.PI * 2 + lean;
      const f = new THREE.Mesh(frondGeo, frondMats[k % 2]);
      f.position.set(cx + Math.cos(a2) * 0.8, cy - 0.12, z + Math.sin(a2) * 0.8);
      f.rotation.y = -a2; f.rotation.z = -0.42;
      trees.add(f);
    }
    for (let k = 0; k < 2; k++) { const n = new THREE.Mesh(nutGeo, nutMat); n.position.set(cx + (k ? 0.14 : -0.14), cy - 0.2, z + 0.1); trees.add(n); }
  }
  for (let i = 0; i < 14; i++) {
    const ang = treeRng() * Math.PI * 2;
    const rad = ISLAND_RADIUS * (0.35 + treeRng() * 0.5);
    const lean = (treeRng() - 0.5) * 0.15;
    const x = Math.cos(ang) * rad, z = Math.sin(ang) * rad;
    if (x > -17 && x < 17 && z > 13 && z < 48) continue; // zona kota dermaga
    addPalm(x, z, lean);
  }
  // palem tambahan buat suasana pelabuhan
  [[-15.5, 29.5, 0.08], [15.5, 29.5, -0.08], [-16, 21, 0.06], [16, 22, -0.06], [-5.5, 15.5, 0.05], [6, 15, -0.05]].forEach(t => addPalm(t[0], t[1], t[2]));
  scene.add(trees);

  // rumah/gudang kecil dekat spawn (dekorasi + acuan arah)
  const hutBase = new THREE.Mesh(new THREE.BoxGeometry(2.6, 1.8, 2.2), new THREE.MeshLambertMaterial({ color: 0xc9a876 }));
  hutBase.position.set(-6, islandHeightAt(-6, -6) + 0.9, -6);
  scene.add(hutBase);
  const hutRoof = new THREE.Mesh(new THREE.ConeGeometry(2.1, 1.4, 4), new THREE.MeshLambertMaterial({ color: 0x8a4a3a }));
  hutRoof.position.set(-6, islandHeightAt(-6, -6) + 2.4, -6);
  hutRoof.rotation.y = Math.PI / 4;
  scene.add(hutRoof);


  // ================= KOTA DERMAGA (plaza, dermaga, toko, lampu) =================
  const PLAZA = { x0: -14, x1: 14, z0: 17.5, z1: 28.5 };
  const PIER = { z0: 28.5, z1: 47 };
  const DECK_Y = 0.36; // di atas puncak gelombang pulau (maks ~0.25) biar rumput gak nembus papan
  function onPlaza(x, z) { return x >= PLAZA.x0 && x <= PLAZA.x1 && z >= PLAZA.z0 && z <= PLAZA.z1; }
  /* PM_PIERS_V417 */
  const PIER_ARM = 11.5;
  function onPierWalk(x, z) {
    if (x >= -1.95 && x <= 1.95 && z >= 27 && z <= PIER.z1 - 0.4) return true;
    if (x >= -5.2 && x <= 5.2 && z >= 46.2 && z <= 50.4) return true;
    for (let i = -1; i <= 1; i += 2) {
      const cx = i * PIER_ARM;
      if (x >= cx - 1.95 && x <= cx + 1.95 && z >= 27 && z <= 42.6) return true;
      if (x >= cx - 3.7 && x <= cx + 3.7 && z >= 38.8 && z <= 42.6) return true;
    }
    return false;
  }
  const TOWN_COLLIDERS = [];
  function inIsland(x, z) { return Math.hypot(x, z) < ISLAND_RADIUS - 0.6; }
  function blockedByTown(x, z) { for (const c of TOWN_COLLIDERS) if (Math.hypot(x - c.x, z - c.z) < c.r) return true; return false; }
  function walkable(x, z) { return (inIsland(x, z) || onPierWalk(x, z)) && !blockedByTown(x, z); }
  function groundHeightAt(x, z) { return (onPlaza(x, z) || onPierWalk(x, z)) ? DECK_Y : islandHeightAt(x, z); }

  function makePlankTexture(repX, repZ) {
    const SZ = 256, ROWH = 32;
    const c = document.createElement('canvas'); c.width = c.height = SZ;
    const g = c.getContext('2d');
    const rnd = makeRng(4242);
    for (let i = 0; i < 8; i++) {
      const v = 108 + Math.floor(rnd() * 34);
      g.fillStyle = 'rgb(' + v + ',' + Math.floor(v * 0.72) + ',' + Math.floor(v * 0.45) + ')';
      g.fillRect(0, i * ROWH, SZ, ROWH);
      g.fillStyle = 'rgba(40,22,10,0.55)'; g.fillRect(0, i * ROWH, SZ, 4);
      for (let k = 0; k < 20; k++) { g.fillStyle = 'rgba(40,22,10,0.16)'; g.fillRect(Math.floor(rnd() * SZ), i * ROWH + 6 + Math.floor(rnd() * 20), 20 + Math.floor(rnd() * 44), 2); }
    }
    const t = new THREE.CanvasTexture(c);
    t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(repX, repZ);
    t.anisotropy = renderer.capabilities.getMaxAnisotropy();
    return t;
  }
  function makeSignTexture(text, bg) {
    const c = document.createElement('canvas'); c.width = 384; c.height = 96;
    const g = c.getContext('2d');
    g.fillStyle = bg; g.fillRect(0, 0, 384, 96);
    g.strokeStyle = '#fff'; g.lineWidth = 7; g.strokeRect(6, 6, 372, 84);
    g.fillStyle = '#fff'; g.font = 'bold 45px sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';
    g.shadowColor = 'rgba(0,0,0,0.5)'; g.shadowBlur = 6;
    g.fillText(text, 192, 51);
    return new THREE.CanvasTexture(c);
  }
  function makeGlowTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 96;
    const g = c.getContext('2d');
    const grad = g.createRadialGradient(48, 48, 0, 48, 48, 48);
