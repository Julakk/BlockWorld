<script>
(function () {
  var C = window.__PMC; if (!C || !C.player) return;
  var P = C.player, rod = C.rodMesh, V = THREE.Vector3, Q = THREE.Quaternion, DOWN = new V(0, -1, 0);
  P.rotation.order = 'YXZ';
  function std(c, r, m) { return new THREE.MeshStandardMaterial({ color: c, roughness: r === undefined ? 0.7 : r, metalness: m || 0 }); }
  function put(par, geo, mat, x, y, z) { var m = new THREE.Mesh(geo, mat); m.position.set(x, y, z); m.castShadow = true; par.add(m); return m; }
  var kids = P.children.slice(), arms = {}, legs = {}, headM = null;
  kids.forEach(function (m) {
    var p = m.geometry && m.geometry.parameters; if (!m.isMesh || !p) return;
    if (p.radiusTop === 0.08 && p.radiusBottom === 0.07 && m.position.y > 1.1) arms[m.position.x < 0 ? 'L' : 'R'] = m;
    if (p.radiusTop === 0.105) legs[m.position.x < 0 ? 'L' : 'R'] = m;
    if (p.radius === 0.2 && p.widthSegments === 24) headM = m;
  });
  if (!arms.L || !arms.R || !legs.L || !legs.R || !headM) { console.warn('Karakter HD: bagian tidak ketemu'); return; }

  // kepala jadi grup sendiri biar bisa menunduk / menoleh
  var HG = new THREE.Group(); HG.position.set(0, 1.3, 0); P.add(HG);
  kids.forEach(function (m) { if (m.isMesh && m.position.y > 1.29) HG.attach(m); });

  // wajah
  var skin = headM.material, hairM = std(0x3a2a1a, 0.9), white = std(0xffffff, 0.3), brass = std(0xc9a24a, 0.3, 0.8);
  var eyes = HG.children.filter(function (m) { return m.geometry && m.geometry.parameters && m.geometry.parameters.radius === 0.024; });
  [-1, 1].forEach(function (s) {
    eyes.push(put(HG, new THREE.SphereGeometry(0.036, 12, 10), white, s * 0.075, 0.2, 0.16));
    eyes.push(put(HG, new THREE.SphereGeometry(0.007, 8, 6), white, s * 0.068, 0.212, 0.204));
    var br = put(HG, new THREE.BoxGeometry(0.06, 0.011, 0.012), hairM, s * 0.075, 0.255, 0.178); br.rotation.z = -s * 0.12;
    var ear = put(HG, new THREE.SphereGeometry(0.042, 10, 8), skin, s * 0.198, 0.19, 0); ear.scale.set(0.5, 1, 0.8);
  });
  var mouth = put(HG, new THREE.TorusGeometry(0.032, 0.005, 6, 12, Math.PI), std(0x8a3b32, 0.6), 0, 0.11, 0.186); mouth.rotation.z = Math.PI;

  // pakaian: kerah, kantong rompi, gesper, kantong umpan
  var kh = std(0x8a7a52, 0.9);
  var collar = put(P, new THREE.TorusGeometry(0.14, 0.03, 8, 20), std(0xeeeeee, 0.8), 0, 1.275, 0); collar.rotation.x = Math.PI / 2; collar.scale.y = 0.9;
  [-1, 1].forEach(function (s) { put(P, new THREE.BoxGeometry(0.13, 0.13, 0.035), kh, s * 0.1, 0.86, 0.168); });
  put(P, new THREE.BoxGeometry(0.06, 0.05, 0.02), brass, 0, 0.7, 0.166);
  put(P, new THREE.BoxGeometry(0.11, 0.14, 0.09), std(0x5a3a1e, 0.9), 0.27, 0.64, 0.02);

  // tangan: pisah lengan atas + lengan bawah (siku)
  function prep(arm) {
    var k = arm.children.slice(), el = new THREE.Group(); el.position.set(0, -0.27, 0); arm.add(el);
    if (k[1]) el.attach(k[1]); if (k[2]) el.attach(k[2]); return el;
  }
  var eL = prep(arms.L), eR = prep(arms.R);
  var watch = put(eL, new THREE.TorusGeometry(0.052, 0.011, 6, 16), brass, 0, -0.22, 0); watch.rotation.x = Math.PI / 2;

  var tmp = new V(), pv = new V(), up = new V(), ep = new V(), lo = new V(), tg = new V(), qa = new Q(), qe = new Q(), qi = new Q();
  function gp(x, y, z) { rod.updateMatrix(); return tg.set(x, y, z).applyMatrix4(rod.matrix); }
  function ik(arm, el, target, side, wt) {
    var s = arm.position, d = tmp.copy(target).sub(s), len = d.length() || 1e-3, a = 0.27, b = 0.29;
    var D = Math.min(len, a + b - 0.004); d.multiplyScalar(1 / len);
    var cA = Math.max(-1, Math.min(1, (a * a + D * D - b * b) / (2 * a * D))), sA = Math.sqrt(1 - cA * cA);
    pv.set(side * 0.5, -0.6, -0.6); pv.addScaledVector(d, -pv.dot(d));
    if (pv.lengthSq() < 1e-6) pv.set(side, 0, 0); pv.normalize();
    up.copy(d).multiplyScalar(cA).addScaledVector(pv, sA);
    qa.setFromUnitVectors(DOWN, up);
    ep.copy(up).multiplyScalar(a).add(s);
    lo.copy(target).sub(ep).normalize().applyQuaternion(qi.copy(qa).invert());
    qe.setFromUnitVectors(DOWN, lo);
    arm.quaternion.slerp(qa, wt); el.quaternion.slerp(qe, wt);
  }

  var t0 = 0, w = 0, theta = 0, lastTap = 0, spin = 0, blinkAt = 3, blinkT = -1, lean = 0, kick = 0, prevSt = 'idle';
  C.hookAnim(function (t) {
    var dt = Math.min(0.1, Math.max(0.001, t - t0)); t0 = t;
    var st = C.fishState, fishing = st !== 'idle';
    w += ((fishing ? 1 : 0) - w) * Math.min(1, dt * 9);
    if (st === 'strike' && prevSt !== 'strike') kick = 1;
    prevSt = st; kick = Math.max(0, kick - dt * 2.2);
    var tc = C.tapCount; if (tc !== lastTap) { spin = 1; lastTap = tc; }
    spin = Math.max(0, spin - dt * 2.5);
    if (st === 'reeling') theta += dt * (3 + spin * 16);

    // joran dipegang di depan dada saat mancing
    rod.position.x = 0.42 - 0.32 * w; rod.position.z = 0.2 + 0.08 * w;

    // tangan kanan selalu pegang gagang joran
    eR.rotation.set(-0.3, 0, 0);
    ik(arms.R, eR, gp(0, -0.4, 0), 1, 1);
    // tangan kiri: bebas saat jalan, pegang joran / putar reel saat mancing
    eL.rotation.set(-0.3 - Math.abs(arms.L.rotation.x) * 0.6, 0, 0);
    if (w > 0.01) {
      var tgt = st === 'reeling' ? gp(-0.03, -0.2 + 0.045 * Math.cos(theta), 0.045 * Math.sin(theta)) : gp(0, -0.12, 0);
      ik(arms.L, eL, tgt, -1, w);
    }

    // kaki membuka saat mancing
    legs.L.rotation.z = -0.09 * w; legs.R.rotation.z = 0.09 * w;

    // badan condong + kepala
    var tl = 0, th = 0.03 * Math.sin(t * 0.8);
    if (st === 'charging') tl = -0.12;
    else if (st === 'flying') tl = 0.2;
    else if (st === 'waiting') { tl = 0.04; th = 0.2; }
    else if (st === 'strike') { tl = -0.1; th = 0.05; }
    else if (st === 'reeling') { tl = -0.1 - 0.04 * Math.sin(theta); th = 0.12; }
    tl -= 0.22 * kick;
    lean += (tl - lean) * Math.min(1, dt * 10); P.rotation.x = lean;
    HG.rotation.x += (th - HG.rotation.x) * Math.min(1, dt * 8);
    HG.rotation.z = kick > 0 ? Math.sin(t * 50) * 0.03 * kick : 0;
    HG.rotation.y = fishing ? 0 : 0.05 * Math.sin(t * 0.5);

    // napas + kedip
    C.body.scale.y = 1 + 0.012 * Math.sin(t * 2.2); HG.position.y = 1.3 + 0.005 * Math.sin(t * 2.2);
    var bl = 1;
    if (blinkT < 0 && t > blinkAt) blinkT = t;
    if (blinkT >= 0) { var u = (t - blinkT) / 0.14; if (u >= 1) { blinkT = -1; blinkAt = t + 2.5 + Math.random() * 3.5; } else bl = 1 - 0.9 * Math.sin(u * Math.PI); }
    eyes.forEach(function (e) { e.scale.y = bl; });
  });
})();
</script>
<script>
