  function makeShop(cfg) {
    const g = new THREE.Group();
    const body = new THREE.Mesh(new THREE.BoxGeometry(4.2, 2.6, 3.2), new THREE.MeshLambertMaterial({ color: cfg.wall }));
    body.position.y = 1.3; g.add(body);
