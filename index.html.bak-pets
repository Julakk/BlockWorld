    bx(0.1, 1.55, 0.1, trim, -1.25, B + 0.78, 0.95); bx(0.1, 1.55, 0.1, trim, -0.25, B + 0.78, 0.95);
    mesh(H, new T.SphereGeometry(0.045, 8, 6), brass, -0.45, B + 0.75, 1.0);
    /* jendela */
