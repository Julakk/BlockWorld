  const _uta = updateTownAnim;
  updateTownAnim = function (t) {
    _uta(t);
    crystal.rotation.y = t * 0.9;
    crystal.position.y = 1.65 + Math.sin(t * 1.6) * 0.12;
    altGlow.position.y = crystal.position.y;
  };

  const TIER_NAME = { 1: 'Common', 2: 'Rare', 3: 'Epic', 4: 'Legendary', 5: 'Mythic' };
  const TIER_COLOR = { 1: '#9fb4bd', 2: '#4aa8ff', 3: '#b56bff', 4: '#ffc233', 5: '#ff4d6d' };
  const ENCHANTS = [
    { id: 'luck1', name: 'Luck I', luck: 0.10, speed: 0, w: 26, t: 1, c: '#9fb4bd' },
    { id: 'swift1', name: 'Swift I', luck: 0, speed: 0.10, w: 26, t: 1, c: '#9fb4bd' },
    { id: 'luck2', name: 'Luck II', luck: 0.20, speed: 0, w: 14, t: 2, c: '#4aa8ff' },
    { id: 'swift2', name: 'Swift II', luck: 0, speed: 0.20, w: 14, t: 2, c: '#4aa8ff' },
    { id: 'merchant', name: 'Merchant', sell: 0.15, w: 9, t: 2, c: '#4aa8ff' },
    { id: 'scholar', name: 'Scholar', xp: 0.25, w: 9, t: 2, c: '#4aa8ff' },
    { id: 'fortune', name: 'Fortune', luck: 0.15, speed: 0.15, w: 10, t: 3, c: '#b56bff' },
    { id: 'prosper', name: 'Prosperity', luck: 0.20, sell: 0.20, w: 4, t: 3, c: '#b56bff' },
    { id: 'sage', name: 'Sage', speed: 0.20, xp: 0.40, w: 4, t: 3, c: '#b56bff' },
    { id: 'luck3', name: 'Luck III', luck: 0.35, speed: 0, w: 5, t: 4, c: '#ffc233' },
    { id: 'swift3', name: 'Swift III', luck: 0, speed: 0.35, w: 5, t: 4, c: '#ffc233' },
    { id: 'tycoon', name: 'Tycoon', luck: 0.20, sell: 0.50, w: 1.5, t: 5, c: '#ff4d6d' },
    { id: 'godhand', name: 'Godhand', luck: 0.50, speed: 0.50, w: 1, t: 5, c: '#ff4d6d' },
    { id: 'omni', name: 'Omniscient', luck: 0.30, speed: 0.30, sell: 0.30, xp: 0.50, w: 0.5, t: 5, c: '#ff4d6d' }
  ];
  const PITY_MAX = 20; // tiap 20 roll tanpa Epic+ , roll berikutnya dijamin Epic ke atas
  function enchDesc(e) {
    const q = [];
    if (e.luck) q.push('Luck +' + Math.round(e.luck * 100) + '%');
    if (e.speed) q.push('Speed +' + Math.round(e.speed * 100) + '%');
    if (e.sell) q.push('Harga Jual +' + Math.round(e.sell * 100) + '%');
    if (e.xp) q.push('XP +' + Math.round(e.xp * 100) + '%');
    return q.join(' • ');
  }
  function enchColor(id) { const e = ENCHANTS.find(x => x.id === id); return e ? e.c : '#9fb4bd'; }
  function enchTier(id) { const e = ENCHANTS.find(x => x.id === id); return e ? e.t : 0; }
  function rollEnchant(minTier) {
    minTier = minTier || 1;
    const pool = ENCHANTS.filter(e => e.t >= minTier);
    let tot = 0; pool.forEach(e => { tot += e.w; });
    let r = Math.random() * tot;
    for (const e of pool) { if (r < e.w) return e; r -= e.w; }
    return pool[0];
  }
  function getPendingEnchant() {
    const pp = save.pendingEnchant; if (!pp) return null;
    const e = ENCHANTS.find(x => x.id === pp.id);
    return e ? { rodId: pp.rodId, ench: e } : null;
  }
  function enchantCost(rod) { return 200 * (1 + ROD_TIERS.indexOf(rod)); }
  function enchRatesHtml() {
    let tot = 0; ENCHANTS.forEach(e => { tot += e.w; });
    let h = '<div class="rowSub" style="text-align:center;line-height:1.7;">';
    for (let t = 1; t <= 5; t++) {
      let sum = 0; ENCHANTS.forEach(e => { if (e.t === t) sum += e.w; });
      h += '<span style="color:' + TIER_COLOR[t] + ';font-weight:800;">' + TIER_NAME[t] + ' ' + (sum / tot * 100).toFixed(1) + '%</span>' + (t < 5 ? ' • ' : '');
    }
    return h + '</div>';
  }

  /* efek visual roll */
  (function () {
    const st = document.createElement('style');
    st.textContent =
      '@keyframes enPop{0%{transform:scale(.6);opacity:0}60%{transform:scale(1.12);opacity:1}100%{transform:scale(1)}}' +
      '@keyframes enShake{0%,100%{transform:translateX(0)}20%{transform:translateX(-5px)}40%{transform:translateX(5px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}' +
      '@keyframes enGlow{0%,100%{box-shadow:0 0 10px var(--ec)}50%{box-shadow:0 0 26px var(--ec),0 0 44px var(--ec)}}' +
      '#enSlot{font-size:26px;font-weight:900;text-align:center;padding:22px 8px;border:3px solid #fff;border-radius:18px;background:rgba(0,0,0,.35);letter-spacing:.5px;}' +
      '.enReveal{animation:enPop .55s ease-out,enGlow 1.2s ease-in-out 2;border-color:var(--ec)!important;}' +
      '.enMythic{animation:enPop .55s ease-out,enShake .5s ease-in-out .3s,enGlow .8s ease-in-out 4;}';
    document.head.appendChild(st);
  })();
  let enAnimTimer = null, enAnimating = false, enJustRevealed = false;
  function startEnchantAnim() {
    enAnimating = true; renderEnchant();
    const end = Date.now() + 1700;
    clearInterval(enAnimTimer);
    enAnimTimer = setInterval(() => {
      const el = document.getElementById('enSlot');
      if (!el || Date.now() >= end) {
        clearInterval(enAnimTimer); enAnimating = false; enJustRevealed = true;
        const pend = getPendingEnchant();
        renderEnchant();
        if (pend) {
          if (pend.ench.t >= 4) { Sfx.levelUp(); vibe([60, 40, 60, 40, 90]); }
          else if (pend.ench.t >= 3) { Sfx.levelUp(); vibe([40, 30, 40]); }
          else vibe(30);
          if (pend.ench.t === 5) showToast('MYTHIC! ' + pend.ench.name + '!');
        }
        enJustRevealed = false;
        return;
      }
      const e = ENCHANTS[Math.floor(Math.random() * ENCHANTS.length)];
      el.textContent = e.name; el.style.color = e.c; el.style.setProperty('--ec', e.c);
      vibe(6);
    }, 85);
  }

  const ovE = document.createElement('div');
  ovE.className = 'modalOverlay'; ovE.id = 'modalEnchant';
  ovE.innerHTML = '<div class="modalBox"><div class="modalHead"><h2>Altar Enchant</h2><button class="modalClose" data-close="modalEnchant">✕</button></div><div class="modalBody" id="enBody"></div><div class="modalFoot"><span>Koin: <b id="enCoins">0</b></span><span></span></div></div>';
  document.body.appendChild(ovE);

  function renderEnchant() {
    save.enchants = save.enchants || {};
    save.enPity = save.enPity || 0;
    const rod = ROD_TIERS.find(r => r.id === save.rod) || ROD_TIERS[0];
    const cur = save.enchants[rod.id];
    const cost = enchantCost(rod);
    const lockCost = cost * 2;
    const pend = getPendingEnchant();
    let h = '<div class="rowItem"><div class="rowIcon" style="' + gearIconStyle('rod', rod.id) + '"></div><div class="rowInfo"><div class="rowName">' + rod.name + '</div><div class="rowSub">' +
      (cur ? 'Enchant: <b style="color:' + enchColor(cur.id) + '">' + cur.name + '</b> • ' + enchDesc(cur) : 'Belum di-enchant') + '</div></div></div>';
    if (enAnimating) {
      h += '<div id="enSlot">...</div>';
      h += '<div class="rowSub" style="text-align:center;">Mengundi enchant...</div>';
    } else if (pend) {
      const pr = ROD_TIERS.find(r => r.id === pend.rodId);
      const cls = pend.ench.t === 5 ? 'enReveal enMythic' : (pend.ench.t >= 3 && enJustRevealed ? 'enReveal' : '');
      h += '<div class="rowItem ' + cls + '" style="--ec:' + pend.ench.c + ';border-color:' + pend.ench.c + ';"><div class="rowInfo"><div class="rowName" style="color:' + pend.ench.c + '">Hasil: ' + pend.ench.name + ' <span style="font-size:10px;opacity:.85;">[' + TIER_NAME[pend.ench.t] + ']</span></div><div class="rowSub">' + enchDesc(pend.ench) + ' • untuk ' + (pr ? pr.name : '?') + '</div></div><div class="rowBtns"><button class="rowBtn" data-en="accept">Pakai</button><button class="rowBtn" data-en="reject">Buang</button></div></div>';
    }
    const busy = !!(pend || enAnimating);
    h += '<button class="rowBtn" data-en="roll" ' + ((busy || save.coins < cost) ? 'disabled' : '') + ' style="width:100%;">Enchant ' + rod.name + ' (' + cost + ' koin)</button>';
    if (cur) {
      h += '<button class="rowBtn" data-en="lock" ' + ((busy || save.coins < lockCost) ? 'disabled' : '') + ' style="width:100%;margin-top:8px;background:linear-gradient(90deg,#ffc233,#ff8a3d);">Roll Kunci Tier (' + lockCost + ' koin) - minimal ' + TIER_NAME[enchTier(cur.id)] + '</button>';
    }
    h += '<div class="rowSub" style="text-align:center;margin-top:8px;">Pity: <b>' + save.enPity + '/' + PITY_MAX + '</b> - di roll ke-' + (PITY_MAX + 1) + ' tanpa Epic, dijamin Epic ke atas.</div>';
    h += enchRatesHtml();
    h += '<div class="rowSub" style="text-align:center;">Pilih Pakai buat ganti enchant lama. Roll Kunci Tier dijamin tidak lebih rendah dari tier enchant sekarang.</div>';
    document.getElementById('enBody').innerHTML = h;
    document.getElementById('enCoins').textContent = save.coins;
  }
  function doEnchantRoll(locked) {
    const rod = ROD_TIERS.find(r => r.id === save.rod) || ROD_TIERS[0];
    const cur = save.enchants && save.enchants[rod.id];
    const cost = enchantCost(rod) * (locked ? 2 : 1);
    if (getPendingEnchant() || enAnimating || save.coins < cost) return;
    if (locked && !cur) return;
    save.coins -= cost;
    save.enPity = save.enPity || 0;
    let minTier = locked ? enchTier(cur.id) : 1;
    if (save.enPity >= PITY_MAX) minTier = Math.max(minTier, 3);
    const got = rollEnchant(minTier);
    save.enPity = got.t >= 3 ? 0 : save.enPity + 1;
    save.pendingEnchant = { rodId: rod.id, id: got.id };
    Sfx.sell(); vibe(30);
    persistSave(); refreshHud();
    startEnchantAnim();
  }
  document.getElementById('enBody').addEventListener('click', function (ev) {
    const b = ev.target.closest('[data-en]'); if (!b || b.disabled) return;
    const act = b.dataset.en;
    save.enchants = save.enchants || {};
    const pend = getPendingEnchant();
    if (act === 'roll') { doEnchantRoll(false); return; }
    if (act === 'lock') { doEnchantRoll(true); return; }
    if (enAnimating) return;
    if (act === 'accept' && pend) {
      save.enchants[pend.rodId] = { id: pend.ench.id, name: pend.ench.name, luck: pend.ench.luck || 0, speed: pend.ench.speed || 0, sell: pend.ench.sell || 0, xp: pend.ench.xp || 0 };
      save.pendingEnchant = null;
      showToast('Enchant ' + pend.ench.name + ' terpasang!'); Sfx.levelUp(); vibe([40, 30, 40]);
    } else if (act === 'reject' && pend) {
      save.pendingEnchant = null; showToast('Hasil enchant dibuang');
    }
    persistSave(); refreshHud(); renderEnchant();
  });
  function openEnchant() { renderEnchant(); ovE.classList.add('show'); }
  TOWN_SHOPS.push({ id: 'altar', name: 'ALTAR', label: 'Buka Altar Enchant', x: -10.5, z: 19.5, action: openEnchant });

  // perahu kecil di samping dermaga
  const boatMesh = new THREE.Group();
  const hull = new THREE.Mesh(new THREE.BoxGeometry(1.8, 0.55, 4.2), new THREE.MeshLambertMaterial({ color: 0x8a4a2b })); boatMesh.add(hull);
  const hullTop = new THREE.Mesh(new THREE.BoxGeometry(1.84, 0.12, 4.24), new THREE.MeshLambertMaterial({ color: 0xf2efe6 })); hullTop.position.y = 0.3; boatMesh.add(hullTop);
  const cabin = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.75, 1.1), new THREE.MeshLambertMaterial({ color: 0xf2efe6 })); cabin.position.set(0, 0.7, -0.7); boatMesh.add(cabin);
  const mast = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 2.2, 5), postMat); mast.position.set(0, 1.4, 0.6); boatMesh.add(mast);
  boatMesh.position.set(-6.2, -0.2, 38); boatMesh.rotation.y = -0.35;
  town.add(boatMesh);
  function updateTownAnim(t) {
    boatMesh.position.y = -0.2 + Math.sin(t * 1.3) * 0.05;
    boatMesh.rotation.z = Math.sin(t * 1.1) * 0.04;
  }

  // tombol interaksi toko (muncul kalau dekat toko)
  let interactTarget = null;
  function updateInteract() {
    const btn = document.getElementById('interactBtn');
    let best = null, bd = 99;
    if (gameStarted && fishState === 'idle' && !document.querySelector('.modalOverlay.show')) {
      for (const sh of TOWN_SHOPS) {
        const d = Math.hypot(player.position.x - sh.x, player.position.z - sh.z);
        if (d < 4.9 && d < bd) { bd = d; best = sh; }
      }
    }
    if (best !== interactTarget) {
      interactTarget = best;
      btn.style.display = best ? 'block' : 'none';
      if (best) btn.textContent = best.label;
    }
  }

  // ================= KARAKTER PEMAIN =================
  const player = new THREE.Group();
  const skinMat = new THREE.MeshLambertMaterial({ color: 0xf0c299 });
  const shirtMat = new THREE.MeshLambertMaterial({ color: 0x4ac0e0 });
  const pantsMat = new THREE.MeshLambertMaterial({ color: 0x3a5068 });
  const body = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.65, 0.3), shirtMat);
  body.position.y = 0.95; player.add(body);
  const head = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.36, 0.36), skinMat);
  head.position.y = 1.48; player.add(head);
  const legL = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.6, 0.24), pantsMat);
  legL.position.set(-0.14, 0.32, 0); player.add(legL);
  const legR = legL.clone(); legR.position.x = 0.14; player.add(legR);
  const armL = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.55, 0.18), shirtMat);
  armL.position.set(-0.34, 0.95, 0); player.add(armL);
  const armR = armL.clone(); armR.position.x = 0.34; player.add(armR);
  // joran kecil di tangan kanan
  const rodMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.03, 1.1, 5), new THREE.MeshLambertMaterial({ color: 0x8a5a2b }));
  rodMesh.position.set(0.42, 1.05, 0.2); rodMesh.rotation.z = -0.5; rodMesh.rotation.x = 0.3;
  player.add(rodMesh);
  const SPAWN_Z = 21.5; // muncul di plaza, dermaga lurus di depan, laut di ujungnya
  player.position.set(0, groundHeightAt(0, SPAWN_Z), SPAWN_Z);
  scene.add(player);

  // ================= HD GRAFIS + KARAKTER + WAKTU/CUACA (v1.7) =================
  (function () {
    const std = (c, r) => new THREE.MeshStandardMaterial({ color: c, roughness: r === undefined ? 0.75 : r, metalness: 0 });
    const skin = std(0xf0c299, 0.6), shirt = std(0x4ac0e0, 0.8), pants = std(0x33485f, 0.85),
          shoe = std(0x2b2118, 0.7), hair = std(0x3a2a1a, 0.9), straw = std(0xf2e4b8, 0.9),
          band = std(0xd8483a, 0.8), dark = std(0x222a30, 0.5), wood = std(0x8a5a2b, 0.7), grip = std(0x4a3420, 0.9);
    const add = (parent, geo, mat, x, y, z) => { const m = new THREE.Mesh(geo, mat); m.position.set(x, y, z); parent.add(m); return m; };
  
    body.geometry = new THREE.CylinderGeometry(0.25, 0.22, 0.65, 20); body.material = shirt; body.scale.set(1, 1, 0.66);
    const belt = add(player, new THREE.TorusGeometry(0.235, 0.025, 8, 24), dark, 0, 0.7, 0); belt.rotation.x = Math.PI / 2; belt.scale.y = 0.66;
  
    head.geometry = new THREE.SphereGeometry(0.2, 24, 18); head.material = skin; head.scale.y = 1.05;
    add(player, new THREE.CylinderGeometry(0.075, 0.085, 0.12, 12), skin, 0, 1.31, 0);
    add(player, new THREE.SphereGeometry(0.212, 24, 16), hair, 0, 1.515, -0.045);
    add(player, new THREE.SphereGeometry(0.024, 10, 8), dark, -0.075, 1.5, 0.181);
    add(player, new THREE.SphereGeometry(0.024, 10, 8), dark, 0.075, 1.5, 0.181);
    add(player, new THREE.SphereGeometry(0.028, 10, 8), skin, 0, 1.465, 0.195);
    add(player, new THREE.CylinderGeometry(0.3, 0.3, 0.03, 28), straw, 0, 1.655, 0);
    add(player, new THREE.CylinderGeometry(0.165, 0.19, 0.14, 28), straw, 0, 1.72, 0);
    add(player, new THREE.CylinderGeometry(0.192, 0.192, 0.045, 28), band, 0, 1.675, 0);
  
    function buildArm(arm, sx) {
      arm.geometry = new THREE.CylinderGeometry(0.08, 0.07, 0.27, 12).translate(0, -0.135, 0);
      arm.material = shirt; arm.position.set(sx * 0.32, 1.22, 0);
      add(arm, new THREE.SphereGeometry(0.085, 12, 10), shirt, 0, 0, 0);
      add(arm, new THREE.CylinderGeometry(0.06, 0.05, 0.27, 12), skin, 0, -0.4, 0);
      add(arm, new THREE.SphereGeometry(0.065, 12, 10), skin, 0, -0.56, 0);
    }
    buildArm(armL, -1); buildArm(armR, 1);
  
    function buildLeg(leg, sx) {
      leg.geometry = new THREE.CylinderGeometry(0.105, 0.09, 0.54, 12).translate(0, -0.27, 0);
      leg.material = pants; leg.position.set(sx * 0.13, 0.62, 0);
      const s = add(leg, new THREE.SphereGeometry(0.1, 12, 10), shoe, 0, -0.56, 0.05); s.scale.set(1, 0.62, 1.55);
    }
    buildLeg(legL, -1); buildLeg(legR, 1);
  
    rodMesh.geometry = new THREE.CylinderGeometry(0.014, 0.03, 1.1, 10); rodMesh.material = wood;
    add(rodMesh, new THREE.CylinderGeometry(0.038, 0.038, 0.24, 10), grip, 0, -0.4, 0);
    const reel = add(rodMesh, new THREE.CylinderGeometry(0.055, 0.055, 0.06, 14), dark, 0.05, -0.2, 0); reel.rotation.z = Math.PI / 2;
  })();
  
  /* PM_V39 resolusi adaptif */
  const PMQ = {
    base: 1, now: 1, acc: 0, frames: 0, t: 0, upOk: 0, floor: 1.25,
    adapt(raw) {
      if (raw > 0.5) return;
      if (!PMHD.isHD()) return;
      this.t += raw; if (this.t < 3) return;
      this.acc += raw; this.frames++;
      if (this.acc < 2) return;
      const fps = this.frames / this.acc;
      this.acc = 0; this.frames = 0;
      if (fps < 38 && this.now > this.floor) {
        this.now = Math.max(this.floor, this.now - 0.15); this.upOk = 0; this.applyNow();
      } else if (fps >= 58 && this.now < this.base) {
        if (++this.upOk >= 4) { this.now = Math.min(this.base, this.now + 0.1); this.upOk = 0; this.applyNow(); }
      } else { this.upOk = 0; }
    },
    applyNow() { renderer.setPixelRatio(this.now); renderer.setSize(window.innerWidth, window.innerHeight); }
  };
  const PMHD = (function () {
    let hd = true; // v4.8: tombol Grafis dihapus, HD selalu aktif
    const maxAniso = Math.min(renderer.capabilities.getMaxAnisotropy(), 8);
    const islandTex = islandMat.map;
    scene.traverse(o => { if (o.isMesh && o !== water) { o.castShadow = true; o.receiveShadow = true; } });
    renderer.shadowMap.type = isMobile ? THREE.PCFShadowMap : THREE.PCFSoftShadowMap;
    sunLight.shadow.mapSize.set(2048, 2048);
    const sc = sunLight.shadow.camera; sc.left = -22; sc.right = 22; sc.top = 22; sc.bottom = -22; sc.near = 1; sc.far = 160;
    sunLight.shadow.bias = -0.0004; sunLight.shadow.normalBias = 0.03;
    scene.add(sunLight.target);
  
    const btn = document.createElement('button');
    btn.className = 'hudPill';
  
    function apply(on) {
      hd = on;
      const dpr = window.devicePixelRatio || 1;
      PMQ.base = Math.min(dpr, isMobile ? 2.5 : 3); PMQ.now = PMQ.base; renderer.setPixelRatio(PMQ.now);
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.shadowMap.enabled = on;
      sunLight.castShadow = on;
      islandTex.magFilter = on ? THREE.LinearFilter : THREE.NearestFilter;
      islandTex.minFilter = on ? THREE.LinearMipmapLinearFilter : THREE.NearestFilter;
      islandTex.needsUpdate = true;
      scene.traverse(o => {
        const ms = o.material ? (Array.isArray(o.material) ? o.material : [o.material]) : [];
        ms.forEach(m => { if (m.map) m.map.anisotropy = on ? maxAniso : 1; m.needsUpdate = true; });
      });
      btn.textContent = 'Grafis: ' + (on ? 'HD' : 'Normal');
      if (window.PMReal) window.PMReal.set(on);
    }
    btn.onclick = () => {
      apply(!hd);
      try { localStorage.setItem('pm_hd', hd ? '1' : '0'); } catch (e) {}
      showToast('Grafis ' + (hd ? 'HD' : 'Normal'));
    };
    apply(hd);
  
    let acc = 0, frames = 0, elapsed = 0, done = false;
    return {
      isHD: () => hd,
      tick(dt) {
        if (!hd || done || dt > 1) return;
        elapsed += dt; if (elapsed < 10) return;
        acc += dt; frames++;
        if (acc >= 5) {
          if (frames / acc < 30) {
            done = true; apply(false);
            showToast('FPS drop, grafis diturunin otomatis biar tetap lancar');
          }
          acc = 0; frames = 0;
        }
      }
    };
  })();
  
  // ===== PMReal: grafis realistis (cuma aktif di mode HD) =====
  // Setelan yang bisa diubah:
  //   EXPOSURE   = terang/gelap keseluruhan (1.0 - 1.4)
  //   WATER_BUMP = kuat gelombang kecil di air (1 - 5)
  //   GLINT      = kilau matahari di air (20 - 120, makin besar makin tajam)
  window.PMReal = (function () {
    var EXPOSURE = 1.15, WATER_BUMP = 2.5, GLINT = 60;
    var TAU = Math.PI * 2, big = true;
    var on = false, raf = 0, timer = 0, ready = false, building = false, waterReady = false;
    var origImg = islandMat.map.image, origIslandMat = island.material, origWaterMat = water.material;
    var hiColor = null, realIslandMat = null, realWaterMat = null, shallows = null, foam = null;
    var maxAniso = renderer.capabilities.getMaxAnisotropy();

    function hash(x, y) {
      var h = (Math.imul(x, 374761393) + Math.imul(y, 668265263)) | 0;
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
    }
    function vnoise(x, y) {
      var xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
      var u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
      var a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    }
    function fbm(x, y) { return (vnoise(x, y) * 0.5 + vnoise(x * 2, y * 2) * 0.25 + vnoise(x * 4, y * 4) * 0.125 + vnoise(x * 8, y * 8) * 0.0625) / 0.9375; }
    function clamp01(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
    function mix(a, b, t) { return a + (b - a) * t; }

    // noise frekuensi rendah dihitung di grid kecil lalu diinterpolasi (jauh lebih cepat)
    function field(freq, off, N) {
      var W = N + 1, G = new Float32Array(W * W);
      for (var j = 0; j <= N; j++) for (var i = 0; i <= N; i++) G[j * W + i] = fbm(i / N * freq + off, j / N * freq + off);
      return function (fx, fy) {
        var x = fx * N, y = fy * N, i = Math.min(N - 1, x | 0), j = Math.min(N - 1, y | 0), u = x - i, v = y - j;
        var a = G[j * W + i], b = G[j * W + i + 1], c = G[(j + 1) * W + i], d = G[(j + 1) * W + i + 1];
        return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
      };
    }

    // tekstur pulau resolusi tinggi: rumput berbercak, pasir berombak, pantai basah + peta bump
    // dikerjakan bertahap (per ~10ms) supaya game gak nge-freeze
    function paintIsland(SZ, cb) {
      var c = document.createElement('canvas'); c.width = c.height = SZ;
      var b = document.createElement('canvas'); b.width = b.height = SZ;
      var g = c.getContext('2d'), bg = b.getContext('2d');
      var img = g.createImageData(SZ, SZ), d = img.data;
      var bimg = bg.createImageData(SZ, SZ), bd = bimg.data;
      var HALF = SZ / 2, wobF = field(6, 10, 128), patchF = field(5, 30, 128), n1F = field(14, 0, 256);
      var y = 0;
      function row(y) {
        var fy = y / SZ, cy = y - HALF;
        for (var x = 0; x < SZ; x++) {
          var cx = x - HALF, fx = x / SZ;
          var dist = Math.sqrt(cx * cx + cy * cy) / HALF;
          var wob = (wobF(fx, fy) - 0.5) * 0.10;
          var s = clamp01((dist + wob - 0.80) / 0.05); s = s * s * (3 - 2 * s);
          var n1 = n1F(fx, fy), fine = hash(x, y);
          var n2 = vnoise(fx * 60 + 50, fy * 60 + 50) * 0.6 + vnoise(fx * 120 + 50, fy * 120 + 50) * 0.4;
          var patch = clamp01((patchF(fx, fy) - 0.5) * 2.2);
          var gr = 62 + n1 * 40 + n2 * 10 + (fine - 0.5) * 16 - patch * 14;
          var gg = 135 + n1 * 70 + n2 * 15 + (fine - 0.5) * 22 - patch * 22;
          var gb = 54 + n1 * 30 + n2 * 8 + (fine - 0.5) * 10 - patch * 10;
          var sn = vnoise(fx * 40 + 90, fy * 40 + 90) * 0.6 + vnoise(fx * 80 + 90, fy * 80 + 90) * 0.4;
          var rip = 0.5 + 0.5 * Math.sin((x + y * 0.4) / SZ * 180 + sn * 6);
          var wet = clamp01((dist + wob - 0.92) / 0.07);
          var k = 1 - 0.28 * wet;
          var sr = (222 + sn * 16 + (fine - 0.5) * 14 - rip * 6) * k;
          var sg = (201 + sn * 18 + (fine - 0.5) * 14 - rip * 7) * k;
          var sb = (152 + sn * 16 + (fine - 0.5) * 12 - rip * 8) * k;
          var i = (y * SZ + x) * 4;
          d[i] = mix(gr, sr, s); d[i + 1] = mix(gg, sg, s); d[i + 2] = mix(gb, sb, s); d[i + 3] = 255;
          var hv = mix(0.55 * n1 + 0.30 * n2 + 0.15 * fine, 0.50 * sn + 0.30 * rip + 0.20 * fine, s) * 255;
          bd[i] = bd[i + 1] = bd[i + 2] = hv; bd[i + 3] = 255;
        }
      }
      function step() {
        var t0 = performance.now();
        while (y < SZ && performance.now() - t0 < 10) { row(y); y++; }
        if (y < SZ) { setTimeout(step, 0); return; }
        g.putImageData(img, 0, 0); bg.putImageData(bimg, 0, 0);
        cb({ color: c, bump: b });
      }
      step();
    }

    // gelombang kecil buat bump air (bisa di-tile)
    function paintWaterBump() {
      var SZ = 256, c = document.createElement('canvas'); c.width = c.height = SZ;
      var g = c.getContext('2d'), img = g.createImageData(SZ, SZ), d = img.data;
      for (var y = 0; y < SZ; y++) for (var x = 0; x < SZ; x++) {
        var u = x / SZ, v = y / SZ;
        var h = 0.5 + 0.22 * Math.sin(TAU * (3 * u + 2 * v)) + 0.16 * Math.cos(TAU * (5 * u - 4 * v)) +
                0.10 * Math.sin(TAU * (9 * u + 7 * v)) + 0.06 * Math.cos(TAU * (14 * u - 11 * v));
        var i = (y * SZ + x) * 4; d[i] = d[i + 1] = d[i + 2] = clamp01(h) * 255; d[i + 3] = 255;
      }
      g.putImageData(img, 0, 0);
      var t = new THREE.CanvasTexture(c);
      t.wrapS = t.wrapT = THREE.RepeatWrapping; t.anisotropy = maxAniso;
      return t;
    }

    function radialTex(inner, outer, stops) {
      var c = document.createElement('canvas'); c.width = c.height = 512;
      var g = c.getContext('2d');
      var gr = g.createRadialGradient(256, 256, 256 * inner / outer, 256, 256, 256);
      stops.forEach(function (s) { gr.addColorStop(s[0], s[1]); });
      g.fillStyle = gr; g.fillRect(0, 0, 512, 512);
      return new THREE.CanvasTexture(c);
    }
    function ringMesh(rIn, rOut, tex, y) {
      var m = new THREE.Mesh(new THREE.RingGeometry(rIn, rOut, 128, 1), new THREE.MeshLambertMaterial({
        map: tex, transparent: true, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2
      }));
      m.rotation.x = -Math.PI / 2; m.position.y = y; m.renderOrder = 1;
      m.castShadow = false; m.receiveShadow = false;
      scene.add(m); return m;
    }

    function buildWater() {
      if (waterReady) return; waterReady = true;
      realWaterMat = new THREE.MeshPhongMaterial({
        map: waterTex, bumpMap: paintWaterBump(), bumpScale: WATER_BUMP,
        specular: 0xbfd8ee, shininess: GLINT, transparent: true, opacity: 0.88
      });
      // air dangkal tosca di sekitar pulau + buih ombak
      shallows = ringMesh(33, 58, radialTex(33, 58, [[0, 'rgba(70,215,205,0.65)'], [0.35, 'rgba(60,190,200,0.35)'], [1, 'rgba(40,150,190,0)']]), -0.32);
      foam = ringMesh(33.5, 37, radialTex(33.5, 37, [[0, 'rgba(255,255,255,0)'], [0.18, 'rgba(255,255,255,0.95)'], [0.45, 'rgba(255,255,255,0.45)'], [1, 'rgba(255,255,255,0)']]), -0.30);
      foam.position.y = -0.30;
    }

    function buildIsland() {
      if (ready || building || !on) return; building = true;
      paintIsland(big ? 1024 : 512, function (r) {
        hiColor = r.color;
        var bump = new THREE.CanvasTexture(r.bump); bump.anisotropy = maxAniso;
        realIslandMat = new THREE.MeshStandardMaterial({ map: islandMat.map, bumpMap: bump, bumpScale: 1.5, roughness: 0.95, metalness: 0 });
        building = false; ready = true;
        if (on) applyIsland(true);
      });
    }
    function applyIsland(v) {
      islandMat.map.image = v ? hiColor : origImg;
      islandMat.map.needsUpdate = true;
      island.material = v ? realIslandMat : origIslandMat;
    }

    function refreshMats() {
      scene.traverse(function (o) {
        var ms = o.material ? (Array.isArray(o.material) ? o.material : [o.material]) : [];
        ms.forEach(function (m) { m.needsUpdate = true; });
      });
    }

    function loop(ts) {
      if (!on) { raf = 0; return; }
      raf = requestAnimationFrame(loop);
      var t = ts / 1000;
      waterTex.offset.set(t * 0.012, t * 0.007);
      if (foam) {
        foam.scale.setScalar(1 + 0.012 * Math.sin(t * 1.1));
        foam.material.opacity = 0.7 + 0.3 * Math.sin(t * 1.6);
      }
    }

    return {
      set: function (v) {
        on = !!v;
        renderer.toneMapping = on ? THREE.ACESFilmicToneMapping : THREE.NoToneMapping;
        renderer.toneMappingExposure = EXPOSURE;
        buildWater();
        water.material = on ? realWaterMat : origWaterMat;
        shallows.visible = foam.visible = on;
        if (on) {
          if (ready) applyIsland(true);
          else if (!timer) timer = setTimeout(function () { timer = 0; buildIsland(); }, 400);
          if (!raf) raf = requestAnimationFrame(loop);
        } else if (ready) applyIsland(false);
        refreshMats();
      }
    };
  })();
  window.PMReal.set(PMHD.isHD());

  const PMEnv = (function () {
    const CYCLE = 600;
    const RAW = [
      { t: 0.00, top: '#2a5db5', mid: '#9dc3e6', hor: '#ffcf9e', fog: '#f3cfae', sun: '#ffc890', hs: '#fff0dd', hg: '#3a4a5a', si: 1.0, hi: 0.9 },
      { t: 0.15, top: '#3b3a7a', mid: '#c9738a', hor: '#ff9a5a', fog: '#c98a7a', sun: '#ff8a5a', hs: '#ffc4a0', hg: '#2a3040', si: 0.6, hi: 0.6 },
      { t: 0.30, top: '#050a1e', mid: '#0b1836', hor: '#1a2a4a', fog: '#0b1830', sun: '#5a70c0', hs: '#5a6aa8', hg: '#141a28', si: 0.28, hi: 0.4 },
      { t: 0.58, top: '#03060f', mid: '#08122a', hor: '#121e3a', fog: '#08122a', sun: '#4a60b0', hs: '#4a5a98', hg: '#0e121c', si: 0.22, hi: 0.34 },
      { t: 0.72, top: '#24386a', mid: '#9a86a8', hor: '#ffb890', fog: '#d8a890', sun: '#ffb078', hs: '#ffd8c0', hg: '#2a3444', si: 0.6, hi: 0.6 },
      { t: 0.85, top: '#1e6fd6', mid: '#8ec8f2', hor: '#d8ecff', fog: '#cfe6f5', sun: '#fff4e0', hs: '#ffffff', hg: '#5a6a7a', si: 1.15, hi: 1.0 },
      { t: 1.00, top: '#2a5db5', mid: '#9dc3e6', hor: '#ffcf9e', fog: '#f3cfae', sun: '#ffc890', hs: '#fff0dd', hg: '#3a4a5a', si: 1.0, hi: 0.9 }
    ];
    const KEYS = ['top', 'mid', 'hor', 'fog', 'sun', 'hs', 'hg'];
    const K = RAW.map(r => { const o = { t: r.t, si: r.si, hi: r.hi }; KEYS.forEach(k => { o[k] = new THREE.Color(r[k]); }); return o; });
    const cur = {}; KEYS.forEach(k => { cur[k] = new THREE.Color(); });
    let si = 1, hi = 0.9;
  
    function sample(t) {
      let i = 0; while (i < K.length - 2 && t > K[i + 1].t) i++;
      const a = K[i], b = K[i + 1]; let f = (t - a.t) / (b.t - a.t); f = f * f * (3 - 2 * f);
      KEYS.forEach(k => { cur[k].copy(a[k]).lerp(b[k], f); });
      si = a.si + (b.si - a.si) * f; hi = a.hi + (b.hi - a.hi) * f;
    }
    function wet(c, r) {
      const l = c.r * 0.3 + c.g * 0.59 + c.b * 0.11;
      c.r += (l - c.r) * 0.6 * r; c.g += (l - c.g) * 0.6 * r; c.b += (l - c.b) * 0.6 * r;
      c.multiplyScalar(1 - 0.28 * r);
    }
  
    const skyC = document.createElement('canvas'); skyC.width = 2; skyC.height = 256;
    const skyG = skyC.getContext('2d');
    const skyTex = new THREE.CanvasTexture(skyC);
    scene.background = skyTex;
    function drawSky() {
      const g = skyG.createLinearGradient(0, 0, 0, 256);
      g.addColorStop(0, '#' + cur.top.getHexString());
      g.addColorStop(0.18, '#' + cur.mid.getHexString());
      g.addColorStop(0.3, '#' + cur.hor.getHexString());
      g.addColorStop(1, '#' + cur.hor.getHexString());
      skyG.fillStyle = g; skyG.fillRect(0, 0, 2, 256);
      skyTex.needsUpdate = true;
    }
  
    const NS = 260, sp = new Float32Array(NS * 3);
    for (let i = 0; i < NS; i++) {
      const az = Math.random() * Math.PI * 2, el = 0.08 + Math.random() * 1.3, r = 400;
      sp[i * 3] = Math.cos(el) * Math.cos(az) * r; sp[i * 3 + 1] = Math.sin(el) * r; sp[i * 3 + 2] = Math.cos(el) * Math.sin(az) * r;
    }
    const starGeo = new THREE.BufferGeometry(); starGeo.setAttribute('position', new THREE.BufferAttribute(sp, 3));
    const starMat = new THREE.PointsMaterial({ color: 0xffffff, size: 1.8, sizeAttenuation: false, transparent: true, opacity: 0, depthWrite: false, fog: false });
    const stars = new THREE.Points(starGeo, starMat); stars.frustumCulled = false; stars.visible = false; scene.add(stars);
  
    const NR = isMobile ? 450 : 800;
    const rp = new Float32Array(NR * 6), off = new Float32Array(NR * 3);
    for (let i = 0; i < NR; i++) { off[i * 3] = (Math.random() - 0.5) * 30; off[i * 3 + 1] = Math.random() * 24 - 12; off[i * 3 + 2] = (Math.random() - 0.5) * 30; }
    const rainGeo = new THREE.BufferGeometry(); rainGeo.setAttribute('position', new THREE.BufferAttribute(rp, 3));
    const rainMat = new THREE.LineBasicMaterial({ color: 0xbcd0ea, transparent: true, opacity: 0, fog: false, depthWrite: false });
    const rain = new THREE.LineSegments(rainGeo, rainMat); rain.frustumCulled = false; rain.visible = false; scene.add(rain);
    function updateRain(dt, lvl) {
      rain.visible = lvl > 0.02; if (!rain.visible) return;
      rainMat.opacity = 0.55 * lvl;
      const cp = camera.position;
      for (let i = 0; i < NR; i++) {
        let y = off[i * 3 + 1] - 22 * dt; if (y < -12) y += 24; off[i * 3 + 1] = y;
        const x = cp.x + off[i * 3], yy = cp.y + y, z = cp.z + off[i * 3 + 2], j = i * 6;
        rp[j] = x; rp[j + 1] = yy; rp[j + 2] = z; rp[j + 3] = x - 0.04; rp[j + 4] = yy - 0.55; rp[j + 5] = z;
      }
      rainGeo.attributes.position.needsUpdate = true;
    }
  
    const lbl = document.createElement('div');
    lbl.style.cssText = 'position:fixed;top:calc(74px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);z-index:9;font-size:10px;font-weight:700;color:rgba(255,255,255,0.8);text-shadow:1px 1px 2px rgba(0,0,0,0.8);pointer-events:none;white-space:nowrap;';
    lbl.id = 'envLabel'; document.body.appendChild(lbl);
  
    let last = performance.now(), tDay = 0, rainLevel = 0, rainTarget = 0, skyAcc = 9, lblAcc = 9;
    let nextWx = last / 1000 + 80 + Math.random() * 60;
    const fogNear = scene.fog.near, fogFar = scene.fog.far;
    const SUNOFF = new THREE.Vector3(-45, 38, 30);
  
    function phaseName(t) { return t < 0.08 ? 'Sore' : t < 0.22 ? 'Senja' : t < 0.66 ? 'Malam' : t < 0.8 ? 'Subuh' : t < 0.96 ? 'Siang' : 'Sore'; }
    function boost() {
      const p = phaseName(tDay);
      let m = p === 'Malam' ? 1.15 : (p === 'Senja' || p === 'Subuh') ? 1.08 : 1;
      if (rainLevel > 0.5) m *= 1.25;
      return m;
    }
  
    function update() {
      const now = performance.now(), raw = (now - last) / 1000; last = now;
      const dt = Math.min(0.1, raw);
      PMHD.tick(raw); PMQ.adapt(raw);
      /* PM_V39B cahaya bulan */
      if (!window.PM_MOON) {
        window.PM_MOON = new THREE.AmbientLight(0x7a92d8, 0);
        window.PM_MOONFOG = new THREE.Color(0x2a3b63);
        scene.add(window.PM_MOON);
      }
      tDay = (tDay + dt / CYCLE) % 1;
  
      const ns = now / 1000;
      if (ns >= nextWx) {
        if (rainTarget === 0) { rainTarget = 1; nextWx = ns + 45 + Math.random() * 55; showToast('Hujan turun! Ikan langka lebih gampang nyangkut'); }
        else { rainTarget = 0; nextWx = ns + 100 + Math.random() * 80; showToast('Hujan reda'); }
      }
      rainLevel += (rainTarget - rainLevel) * Math.min(1, dt * 0.6);
  
      sample(tDay);
      ['top', 'mid', 'hor', 'fog', 'sun', 'hs'].forEach(k => wet(cur[k], rainLevel));
      sunLight.color.copy(cur.sun); sunLight.intensity = si * (1 - 0.25 * rainLevel);
      hemiLight.color.copy(cur.hs); hemiLight.groundColor.copy(cur.hg); hemiLight.intensity = hi * (1 - 0.08 * rainLevel);
      scene.fog.color.copy(cur.fog);
      scene.fog.near = fogNear * (1 - 0.4 * rainLevel); scene.fog.far = fogFar * (1 - 0.35 * rainLevel);
  
      const night = Math.max(0, Math.min(1, (0.75 - hi) / 0.4));
      glowMat.opacity = 0.35 + 0.65 * night;
      starMat.opacity = night * (1 - rainLevel); stars.visible = starMat.opacity > 0.02;
      window.PM_MOON.intensity = night * (1.0 + 0.3 * rainLevel);
      scene.fog.color.lerp(window.PM_MOONFOG, night * 0.3);
      stars.position.copy(camera.position);
  
      skyAcc += dt; if (skyAcc > 0.4) { skyAcc = 0; drawSky(); }
      if (renderer.shadowMap.enabled) {
        sunLight.target.position.copy(player.position);
        sunLight.position.copy(player.position).add(SUNOFF);
      }
      updateRain(dt, rainLevel);
  
      lblAcc += dt;
      if (lblAcc > 1) {
        lblAcc = 0;
        const m = boost(), pct = Math.round((m - 1) * 100);
        lbl.textContent = phaseName(tDay) + (rainLevel > 0.5 ? ' • Hujan' : '') + (pct > 0 ? ' • Ikan langka +' + pct + '%' : '');
      }
    }
  
    const _render = renderer.render.bind(renderer);
    renderer.render = function (s, c) { update(); _render(s, c); };
    return { boost: boost };
  })();
  

  // ================= KAMERA ORBIT PIHAK KETIGA =================
  let camYaw = Math.PI, camPitch = 0.35;
  const CAM_DIST = 5.2;
  function updateCamera() {
    const cy = Math.max(0.12, Math.min(0.9, camPitch));
    const dist = CAM_DIST;
    const ox = Math.sin(camYaw) * Math.cos(cy) * dist;
    const oz = Math.cos(camYaw) * Math.cos(cy) * dist;
    const oy = Math.sin(cy) * dist + 1.1;
    camera.position.set(player.position.x + ox, player.position.y + oy, player.position.z + oz);
    camera.lookAt(player.position.x, player.position.y + 1.1, player.position.z);
  }

  // ================= JOYSTICK (gerak) =================
  const joyZone = document.getElementById('joystickZone');
  const joyThumb = document.getElementById('joystickThumb');
  let joyActive = false, joyId = null, joyVec = { x: 0, y: 0 };
  function joyReset() { joyVec.x = 0; joyVec.y = 0; joyThumb.style.transform = 'translate(-50%, -50%)'; }
  joyZone.addEventListener('pointerdown', (e) => { joyActive = true; joyId = e.pointerId; joyZone.setPointerCapture(joyId); handleJoy(e); });
  joyZone.addEventListener('pointermove', (e) => { if (joyActive && e.pointerId === joyId) handleJoy(e); });
  window.addEventListener('pointerup', (e) => { if (e.pointerId === joyId) { joyActive = false; joyReset(); } });
  function handleJoy(e) {
    const rect = joyZone.getBoundingClientRect();
    const cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
    let dx = e.clientX - cx, dy = e.clientY - cy;
    const max = rect.width / 2;
    const len = Math.min(max, Math.hypot(dx, dy));
    const ang = Math.atan2(dy, dx);
    dx = Math.cos(ang) * len; dy = Math.sin(ang) * len;
    joyVec.x = dx / max; joyVec.y = dy / max;
    joyThumb.style.transform = `translate(${dx - 23}px, ${dy - 23}px)`;
  }

  // ================= DRAG KAMERA (layar kanan) =================
  const camZone = document.getElementById('camDragZone');
  let camDragId = null, camLastX = 0, camLastY = 0;
  camZone.addEventListener('pointerdown', (e) => { camDragId = e.pointerId; camLastX = e.clientX; camLastY = e.clientY; camZone.setPointerCapture(camDragId); });
  camZone.addEventListener('pointermove', (e) => {
    if (e.pointerId !== camDragId) return;
    const dx = e.clientX - camLastX, dy = e.clientY - camLastY;
    camLastX = e.clientX; camLastY = e.clientY;
    camYaw -= dx * 0.006; camPitch += dy * 0.004;
  });
  window.addEventListener('pointerup', (e) => { if (e.pointerId === camDragId) camDragId = null; });

  // ================= BOBBER (pelampung kail) =================
  const bobber = new THREE.Mesh(new THREE.SphereGeometry(0.12, 12, 10), new THREE.MeshLambertMaterial({ color: 0xe04a3a }));
  bobber.visible = false;
  scene.add(bobber);
  let bobberTarget = new THREE.Vector3();
  let bobberStart = new THREE.Vector3();
  let bobberT = 0;

  function distToWaterEdge(pos) {
    return ISLAND_RADIUS - Math.sqrt(pos.x * pos.x + pos.z * pos.z);
  }
  function nearWater() {
    const d = distToWaterEdge(player.position);
    return (d < 6 && d > -2) || (onPierWalk(player.position.x, player.position.z) && player.position.z > 30);
  }

  // ================= STATE MACHINE MANCING =================
  // idle -> charging (nahan tombol, isi power) -> flying (bobber melesat) -> waiting (nunggu gigitan)
  // -> strike (harus tap cepat) -> reeling (minigame tarik) -> (balik ke idle)
  let fishState = 'idle';
  let chargeT = 0, chargeDir = 1, lockedPower = 0;
  let waitTimer = 0, waitTarget = 0;
  let strikeTimer = 0;
  let reelDanger = 0, reelExpandRate = 12, reelLastTapTime = -999, reelTapCount = 0;
  let currentCatch = null;
  let castBoost = 1;
  // makin langka ikannya, makin cepet bar bahaya naik = makin susah narik
  const RARITY_REEL_RATE = { common: 9, uncommon: 12, rare: 15, epic: 19, legendary: 24, mythical: 30, secret: 44 };

  const fishBtn = document.getElementById('fishBtn');
  const fishHint = document.getElementById('fishHint');
  const powerWrap = document.getElementById('powerWrap');
  const powerFill = document.getElementById('powerFill');
  const powerMarker = document.getElementById('powerMarker');
  const reelWrap = document.getElementById('reelWrap');
  const reelZoneEl = document.getElementById('reelZone');
  const reelIndicatorEl = document.getElementById('reelIndicator');
  const reelProgressFill = document.getElementById('reelProgressFill');
  const reelTapHint = document.getElementById('reelTapHint');

  const fishBtnLabel = document.getElementById('fishBtnLabel');
  function setFishBtnLabel(text, strikeMode) {
    fishBtnLabel.textContent = text;
    fishBtn.classList.toggle('strike', !!strikeMode);
  }

  function resetFishing() {
    fishState = 'idle';
    powerWrap.style.display = 'none';
    reelWrap.style.display = 'none';
    bobber.visible = false;
    setFishBtnLabel('PANCING', false);
    fishHint.style.display = 'none';
  }

  function consumeBait() { return; /* bait permanen ala Fish It */
    const id = save.bait;
    if (id === 'biasa') return;
    save.baitStock[id] = Math.max(0, (save.baitStock[id] || 0) - 1);
    if (save.baitStock[id] <= 0) { save.bait = 'biasa'; showToast('Bait habis, balik ke Starter Bait'); }
    persistSave(); refreshHud();
  }

  function startCharging() {
    if (!nearWater()) { showToast('Deket air dulu buat mancing!'); return; }
    fishState = 'charging'; chargeT = 0; chargeDir = 1;
    powerWrap.style.display = 'block';
    setFishBtnLabel('LEPAS!', false);
  }

  function releaseCast() {
    lockedPower = chargeT; // 0..1
    fishState = 'flying';
    castBoost = totalBoost() + castLuckBonus(); consumeBait(); if (window.PMNet && window.PMNet.cast) { try { window.PMNet.cast(); } catch (e) {} }
    Sfx.cast(); vibe(15);
    powerWrap.style.display = 'none';
    const rod = currentRod();
    const dist = 2.5 + lockedPower * rod.castRange;
    const ang = camYaw + Math.PI; // arah hadap pemain kira-kira berlawanan sama arah kamera
    bobberStart.copy(player.position); bobberStart.y += 1.2;
    bobberTarget.set(player.position.x + Math.sin(ang) * dist, water.position.y + 0.02, player.position.z + Math.cos(ang) * dist);
    bobberT = 0;
    bobber.visible = true;
    setFishBtnLabel('...', false);
  }

  function beginWaiting() {
    fishState = 'waiting';
    const rod = currentRod();
    waitTarget = (1.4 + Math.random() * 2.6) / rod.biteSpeed;
    waitTimer = 0;
    setFishBtnLabel('Nunggu...', false);
  }

  function beginStrikeWindow() {
    fishState = 'strike';
    strikeTimer = 0;
    setFishBtnLabel('STRIKE!', true);
    Sfx.bite(); vibe([60, 40, 60]);
    fishHint.textContent = 'IKAN NYAMBER! TAP CEPET!';
    fishHint.style.display = 'block';
  }

  function beginReeling() {
    fishState = 'reeling';
    currentCatch = rollFish(castBoost * PMEnv.boost()); assignWeight(currentCatch);
    reelExpandRate = RARITY_REEL_RATE[currentCatch.fish.rarity] || 12;
    reelDanger = 25; // buffer awal biar gak langsung kalah
    reelLastTapTime = -999;
    reelTapCount = 0;
    reelZoneEl.style.width = Math.max(0, 100 - reelDanger) + '%';
    reelZoneEl.className = '';
    reelTapHint.textContent = '(000)';
    reelWrap.style.display = 'flex';
    fishHint.style.display = 'none';
    setFishBtnLabel('TAP!', true);
  }

  function handleReelTap() {
    if (fishState !== 'reeling') return;
    const now = performance.now();
    if (now - reelLastTapTime < 60) return; // cegah spam ngaco
    reelLastTapTime = now;
    Sfx.tap();
    reelDanger = Math.max(0, reelDanger - 7);
    reelTapCount++;
    reelTapHint.textContent = '(' + String(Math.min(999, reelTapCount)).padStart(3, '0') + ')';
    if (reelDanger <= 0) finishReel(true);
  }

  // ================= MISI HARIAN =================
  const Quest = (() => {
    function dstr(d) { return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); }
    function today() { return dstr(new Date()); }
    function yesterday() { return dstr(new Date(Date.now() - 86400000)); }
    function ensure() {
      let q = save.quests;
      if (!q || q.v !== 2 || q.day !== today() || !q.list) {
        const lv = save.level || 1;
        const st = save.questStreak;
        if (!st || !st.day) save.questStreak = { day: today(), n: 1 };
        else if (st.day !== today()) save.questStreak = { day: today(), n: st.day === yesterday() ? st.n + 1 : 1 };
        const cg = 12 + 2 * lv, rg = 1 + Math.floor(lv / 5), sg = 250 + 60 * lv;
        q = save.quests = { v: 2, day: today(), bonus: false, list: [
          { id: 'catch', t: 'Tangkap ' + cg + ' ikan', n: 0, goal: cg, coins: 60 + 15 * lv, xp: 30 + 8 * lv, done: false },
          { id: 'rare', t: 'Tangkap ' + rg + ' ikan Langka atau lebih', n: 0, goal: rg, coins: 100 + 25 * lv, xp: 50 + 10 * lv, done: false },
          { id: 'mut', t: 'Tangkap 1 ikan mutasi (Emas/Pelangi)', n: 0, goal: 1, coins: 120 + 30 * lv, xp: 60 + 12 * lv, done: false },
          { id: 'sell', t: 'Jual ikan senilai ' + sg + ' koin', n: 0, goal: sg, coins: 70 + 20 * lv, xp: 35 + 8 * lv, done: false }
        ] };
      }
      return q;
    }
    function on(type, v) {
      const q = ensure(); let hit = false;
      q.list.forEach(m => {
        if (m.done) return;
        if (type === 'catch') {
          if (m.id === 'catch') m.n++;
          else if (m.id === 'rare' && RARITY_ORDER.indexOf(v.fish.rarity) >= 2) m.n++;
          else if (m.id === 'mut' && v.mutation && v.mutation.id !== 'normal') m.n++;
        } else if (type === 'sell' && m.id === 'sell') m.n += v;
        if (m.n >= m.goal) {
          m.n = m.goal; m.done = true; save.coins += m.coins; addXp(m.xp);
          showToast('Misi selesai! +' + m.coins + ' koin'); Sfx.sell(); hit = true;
        }
      });
      if (!q.bonus && q.list.every(m => m.done)) {
        q.bonus = true;
        const n = save.questStreak.n, b = 50 * Math.min(n, 7);
        save.coins += b; hit = true;
        showToast('Semua misi beres! Bonus streak ' + n + ' hari: +' + b + ' koin');
      }
      persistSave(); if (hit) refreshHud();
    }
    const ov = document.createElement('div');
    ov.className = 'modalOverlay'; ov.id = 'modalQuest';
    ov.innerHTML = '<div class="modalBox"><div class="modalHead"><h2>Misi Harian</h2><button class="modalClose" id="qClose">✕</button></div><div class="modalBody" id="qList"></div><div class="modalFoot"><span id="qFoot"></span><span></span></div></div>';
    document.body.appendChild(ov);
    ov.querySelector('#qClose').onclick = () => ov.classList.remove('show');
    function render() {
      const q = ensure(), n = save.questStreak.n;
      document.getElementById('qList').innerHTML = q.list.map(m =>
        '<div class="rowItem"><div class="rowInfo"><div class="rowName">' + m.t + '</div><div class="rowSub">' + m.n + '/' + m.goal + ' • Hadiah ' + m.coins + ' koin + ' + m.xp + ' XP</div></div><button class="rowBtn' + (m.done ? ' owned' : '') + '" disabled>' + (m.done ? 'Selesai' : 'Berjalan') + '</button></div>'
      ).join('');
      document.getElementById('qFoot').textContent = 'Streak ' + n + ' hari • Bonus ' + (q.bonus ? 'sudah diambil' : '+' + (50 * Math.min(n, 7)) + ' koin');
    }
    const pills = document.getElementById('hudPills');
    if (pills) {
      const b = document.createElement('button');
      b.className = 'hudPill'; b.textContent = 'Misi';
      b.onclick = () => { render(); ov.classList.add('show'); };
      pills.appendChild(b);
    }
    return { on: on };
  })();

  // ===== PMSecretCine: animasi sinematik tangkap ikan Secret (v3.3) =====
  // Alur: IKAN MELAWAN (kamera samping) -> IKAN MELOMPAT (slow, kamera belakang) -> PAMER (kamera ngorbit) -> balik normal.
  // Ketuk layar buat lewati. Semua objek sementara dibuang lagi pas selesai.
  const PMSecretCine = (function () {
    const V3 = THREE.Vector3;
    const T_FIGHT = 2.6, T_LEAP = 4.8, T_REVEAL = 5.7, T_HOLD = 7.0, T_END = 7.6;
    const ease = u => u * u * (3 - 2 * u), c01 = u => u < 0 ? 0 : u > 1 ? 1 : u, lerp = (a, b, k) => a + (b - a) * k;
    const bl = (x, a, b) => ease(c01((x - a) / (b - a)));
    const PN = 240;
    let active = false, t = 0, last = 0, root = null, fish = null, inner = null, kind = 'shark', parts = {};
    let revealed = false, erupted = false, finished = false, onReveal = null, onDone = null, failTimer = 0, uiReady = false;
    let wy = 0, fov0 = 65, Lleap = 5, Lhold = 2.6, rippleT = 0, pTick = 0;
    let fin = null, splashT = 0, wig = 1, finPx = 0, finPz = 0, finHead = 0;
    let shadow = null, beam = null, line = null, linePos = null, tipObj = null, ptsGeo = null, ptsPos, ptsCol, ptsVel, ptsLife, ptsMax, ptsBase;
    const LN = 14, rings = [];
    const S = new V3(), A = new V3(), H = new V3(), F = new V3(), R = new V3(), fp = new V3(), fpPrev = new V3(), tmp = new V3(), tipV = new V3();
    const base = { x: 0, y: 0, z: 0, order: 'XYZ' };
    const qLeap = new THREE.Quaternion(), qHold = new THREE.Quaternion(), cinQ = new THREE.Quaternion(), homeQ = new THREE.Quaternion(), eu = new THREE.Euler(0, 0, 0, 'YXZ');
    const posA = new V3(), posB = new V3(), posC = new V3(), lkA = new V3(), lkB = new V3(), lkC = new V3(), homeP = new V3(), cp = new V3(), cl = new V3();
    const ringGeo = new THREE.RingGeometry(0.88, 1, 48).rotateX(-Math.PI / 2);

    function ui() {
      if (uiReady) return; uiReady = true;
      const st = document.createElement('style');
      st.textContent = '#cineBarT,#cineBarB{position:fixed;left:0;right:0;height:0;background:#000;z-index:49;pointer-events:none;transition:height .5s ease}#cineBarT{top:0}#cineBarB{bottom:0}body.cine #cineBarT,body.cine #cineBarB{height:11vh}#cineBlock{position:fixed;left:0;top:0;right:0;bottom:0;z-index:48;display:none;touch-action:none}body.cine #cineBlock{display:block}#cineSkip{position:fixed;right:14px;bottom:calc(11vh + 10px);z-index:49;color:#fff;font-size:12px;opacity:0;transition:opacity .4s;pointer-events:none;text-shadow:0 1px 3px #000}body.cine.skipok #cineSkip{opacity:.85}';
      document.head.appendChild(st);
      ['cineBarT', 'cineBarB', 'cineBlock', 'cineSkip'].forEach(id => {
        const d = document.createElement('div'); d.id = id; if (id === 'cineSkip') d.textContent = 'Ketuk untuk lewati'; document.body.appendChild(d);
      });
      document.getElementById('cineBlock').addEventListener('pointerdown', function () { if (active && t > 2.4 && t < T_REVEAL - 0.1) t = T_REVEAL - 0.1; });
    }

    // ---------- model ikan ----------
    const M = (geo, color, rough) => new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ color: color, roughness: rough == null ? 0.55 : rough, metalness: 0.05 }));
    function put(parent, mesh, x, y, z) { mesh.position.set(x, y, z); parent.add(mesh); return mesh; }
    function buildShark(top, belly) { // panjang ~1 satuan, hidung ke +z
      const g = new THREE.Group();
      put(g, M(new THREE.SphereGeometry(0.5, 24, 16), top, 0.5), 0, 0, 0).scale.set(0.34, 0.34, 1);
      put(g, M(new THREE.SphereGeometry(0.5, 24, 12), belly, 0.6), 0, -0.07, 0.02).scale.set(0.3, 0.2, 0.94);
      const jawP = new THREE.Group(); jawP.position.set(0, -0.13, 0.1); g.add(jawP);
      put(jawP, M(new THREE.SphereGeometry(0.5, 16, 8), 0xd88a8a, 0.7), 0, -0.02, 0.22).scale.set(0.2, 0.07, 0.4);
      for (let i = 0; i < 8; i++) {
        const s = i % 2 ? 1 : -1, z = 0.2 + Math.floor(i / 2) * 0.05;
        put(g, M(new THREE.ConeGeometry(0.014, 0.06, 6), 0xffffff, 0.3), s * 0.06, -0.15, z).rotation.z = Math.PI;
      }
      [1, -1].forEach(s => {
        put(g, M(new THREE.SphereGeometry(0.03, 10, 8), 0x050505, 0.2), s * 0.135, 0.06, 0.3);
        const f = put(g, M(new THREE.ConeGeometry(0.07, 0.3, 10), top, 0.5), s * 0.17, -0.07, 0.1); f.rotation.z = -s * 2.0; f.scale.z = 0.3;
      });
      const dor = put(g, M(new THREE.ConeGeometry(0.1, 0.3, 12), top, 0.5), 0, 0.22, -0.02); dor.rotation.x = -0.35; dor.scale.z = 0.35;
      const tailP = new THREE.Group(); tailP.position.set(0, 0, -0.46); g.add(tailP);
      const up = put(tailP, M(new THREE.ConeGeometry(0.075, 0.34, 10), top, 0.5), 0, 0.1, -0.06); up.rotation.x = -0.9; up.scale.x = 0.3;
      const lo = put(tailP, M(new THREE.ConeGeometry(0.055, 0.22, 10), top, 0.5), 0, -0.06, -0.05); lo.rotation.x = -(Math.PI - 0.9); lo.scale.x = 0.3;
      parts.jaw = jawP; parts.tail = tailP; parts.tent = null;
      return g;
    }
    function buildKraken() { // mantel di depan (+z), tentakel menjuntai ke belakang
      const g = new THREE.Group(), body = 0x8e3b78, head = 0xa04688;
      put(g, M(new THREE.SphereGeometry(0.5, 24, 16), body, 0.45), 0, 0, 0.2).scale.set(0.42, 0.42, 0.9);
      [1, -1].forEach(s => { put(g, M(new THREE.SphereGeometry(0.5, 12, 8), head, 0.5), s * 0.22, 0, 0.55).scale.set(0.3, 0.05, 0.28); });
      put(g, M(new THREE.SphereGeometry(0.3, 20, 14), head, 0.45), 0, 0, -0.3);
      [1, -1].forEach(s => {
        put(g, M(new THREE.SphereGeometry(0.1, 12, 10), 0xfff4d6, 0.3), s * 0.24, 0.08, -0.32);
        put(g, M(new THREE.SphereGeometry(0.055, 10, 8), 0x000000, 0.2), s * 0.31, 0.08, -0.34);
      });
      const tm = new THREE.MeshStandardMaterial({ color: 0x9b3f84, roughness: 0.5, metalness: 0.05 });
      parts.tent = []; parts.jaw = null; parts.tail = null;
      for (let k = 0; k < 8; k++) {
        const a = k / 8 * Math.PI * 2, rt = new THREE.Group();
        rt.position.set(Math.cos(a) * 0.15, Math.sin(a) * 0.15, -0.5);
        rt.rotation.set(Math.sin(a) * 0.35, -Math.cos(a) * 0.35, 0);
        let cur = rt; const segs = [];
        for (let i = 0; i < 5; i++) {
          const L = 0.34, r1 = 0.07 * (1 - i * 0.17), r2 = 0.07 * (1 - (i + 1) * 0.17);
          const geo = new THREE.CylinderGeometry(r2, r1, L, 8); geo.rotateX(-Math.PI / 2); geo.translate(0, 0, -L / 2);
          const seg = new THREE.Mesh(geo, tm); seg.position.z = i ? -L : 0; cur.add(seg); segs.push(seg); cur = seg;
        }
        g.add(rt); parts.tent.push(segs);
      }
      return g;
    }
    function undulate(time) {
      if (!inner) return;
      if (parts.tent) { // kraken: mantel berdenyut kayak jet
        const s0 = parts.s0 || 0.36, p = Math.sin(time * 5.5) * wig;
        inner.scale.set(s0 * (1 + 0.07 * p), s0 * (1 + 0.07 * p), s0 * (1 - 0.1 * p)); return;
      }
      if (!parts.kids) parts.kids = inner.children.map(c => ({ c: c, x: c.position.x, ry: c.rotation.y, z: c.position.z }));
      for (let i = 0; i < parts.kids.length; i++) {
        const k = parts.kids[i], w = Math.min(1, Math.max(0, 0.5 - k.z)), w2 = w * w, ph = time * 11 - k.z * 6;
        k.c.position.x = k.x + Math.sin(ph) * wig * 0.07 * (0.15 + w2);
        if (k.c !== parts.tail) k.c.rotation.y = k.ry + Math.cos(ph) * wig * 0.35 * w;
      }
    }
    function animateModel(time, open) {
      if (parts.tail) parts.tail.rotation.y = Math.sin(time * 11 + 3.5) * (0.22 + 0.5 * wig);
      undulate(time);
      if (parts.jaw) parts.jaw.rotation.x = open;
      if (parts.tent) parts.tent.forEach((segs, k) => segs.forEach((s, i) => {
        s.rotation.x = Math.sin(time * 4 + k * 0.8 + i * 0.7) * 0.28 + 0.12; s.rotation.y = Math.cos(time * 3.2 + k + i * 0.6) * 0.22;
      }));
    }

    // ---------- percikan & cincin air ----------
    function dotTex() {
      const c = document.createElement('canvas'); c.width = c.height = 32; const g = c.getContext('2d');
      const gr = g.createRadialGradient(16, 16, 0, 16, 16, 16);
      gr.addColorStop(0, 'rgba(255,255,255,1)'); gr.addColorStop(0.5, 'rgba(255,255,255,0.6)'); gr.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = gr; g.fillRect(0, 0, 32, 32); return new THREE.CanvasTexture(c);
    }
    function initPts() {
      ptsPos = new Float32Array(PN * 3); ptsCol = new Float32Array(PN * 3); ptsVel = new Float32Array(PN * 3);
      ptsLife = new Float32Array(PN); ptsMax = new Float32Array(PN); ptsBase = new Float32Array(PN * 3);
      for (let i = 0; i < PN; i++) ptsPos[i * 3 + 1] = -999;
      ptsGeo = new THREE.BufferGeometry();
      ptsGeo.setAttribute('position', new THREE.BufferAttribute(ptsPos, 3));
      ptsGeo.setAttribute('color', new THREE.BufferAttribute(ptsCol, 3));
      const p = new THREE.Points(ptsGeo, new THREE.PointsMaterial({ size: 0.3, map: dotTex(), vertexColors: true, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending }));
      p.frustumCulled = false; root.add(p);
    }
    function emit(x, y, z, n, spd, up, r, g, b) {
      let c = 0;
      for (let i = 0; i < PN && c < n; i++) {
        if (ptsLife[i] > 0) continue;
        const a = Math.random() * 6.283, s = spd * (0.35 + Math.random() * 0.65), j = i * 3;
        ptsPos[j] = x; ptsPos[j + 1] = y; ptsPos[j + 2] = z;
        ptsVel[j] = Math.cos(a) * s; ptsVel[j + 1] = up * (0.5 + Math.random()); ptsVel[j + 2] = Math.sin(a) * s;
        ptsMax[i] = ptsLife[i] = 0.7 + Math.random() * 0.7;
        ptsBase[j] = r; ptsBase[j + 1] = g; ptsBase[j + 2] = b; c++;
      }
    }
    function stepPts(dt) {
      if (!ptsGeo) return;
      for (let i = 0; i < PN; i++) {
        if (ptsLife[i] <= 0) continue;
        const j = i * 3; ptsLife[i] -= dt;
        ptsVel[j + 1] -= 9 * dt;
        ptsPos[j] += ptsVel[j] * dt; ptsPos[j + 1] += ptsVel[j + 1] * dt; ptsPos[j + 2] += ptsVel[j + 2] * dt;
        if (ptsLife[i] <= 0 || (ptsPos[j + 1] < wy && ptsVel[j + 1] < 0)) { ptsLife[i] = 0; ptsPos[j + 1] = -999; ptsCol[j] = ptsCol[j + 1] = ptsCol[j + 2] = 0; continue; }
        const f = ptsLife[i] / ptsMax[i];
        ptsCol[j] = ptsBase[j] * f; ptsCol[j + 1] = ptsBase[j + 1] * f; ptsCol[j + 2] = ptsBase[j + 2] * f;
      }
      ptsGeo.attributes.position.needsUpdate = true; ptsGeo.attributes.color.needsUpdate = true;
    }
    function ring(x, z, maxR, dur, delay) {
      const m = new THREE.Mesh(ringGeo, new THREE.MeshBasicMaterial({ color: 0xe6fbff, transparent: true, opacity: 0, depthWrite: false, side: THREE.DoubleSide, blending: THREE.AdditiveBlending }));
      m.position.set(x, wy + 0.06, z); m.scale.setScalar(0.01); root.add(m);
      rings.push({ m: m, age: -(delay || 0), dur: dur, maxR: maxR });
    }
    function stepRings(dt) {
      for (let i = rings.length - 1; i >= 0; i--) {
        const r = rings[i]; r.age += dt; if (r.age < 0) continue;
        const u = r.age / r.dur;
        if (u >= 1) { root.remove(r.m); r.m.material.dispose(); rings.splice(i, 1); continue; }
        r.m.scale.setScalar(Math.max(0.01, r.maxR * (1 - (1 - u) * (1 - u)))); r.m.material.opacity = 0.75 * (1 - u);
      }
    }

    // ---------- tali pancing ----------
    function tipPos(out) {
      if (tipObj) { tipObj.updateWorldMatrix(true, false); return out.set(0, 0.42, 0).applyMatrix4(tipObj.matrixWorld); }
      return out.set(player.position.x, player.position.y + 1.7, player.position.z);
    }
    function drawLine(target, slack) {
      tipPos(tipV);
      for (let i = 0; i < LN; i++) {
        const u = i / (LN - 1), j = i * 3;
        linePos[j] = lerp(tipV.x, target.x, u); linePos[j + 1] = lerp(tipV.y, target.y, u) - slack * Math.sin(Math.PI * u); linePos[j + 2] = lerp(tipV.z, target.z, u);
      }
      line.geometry.attributes.position.needsUpdate = true;
    }

    // ---------- tahapan ----------
    function erupt() {
      erupted = true; fish.position.copy(A); fpPrev.copy(A); if (fin) fin.visible = false;
      emit(A.x, wy + 0.1, A.z, 90, 4.2, 7, 0.85, 0.97, 1);
      ring(A.x, A.z, 6.5, 1.1); ring(A.x, A.z, 4, 0.9, 0.12); ring(A.x, A.z, 9, 1.4, 0.25);
      if (typeof cfxShake === 'function') cfxShake(450);
      if (typeof vibe === 'function') vibe([40, 30, 90]);
    }
    function fightStep(dt) {
      const u = t / T_FIGHT, e = ease(u), tug = Math.sin(t * 11);
      fp.lerpVectors(S, A, e).addScaledVector(R, Math.sin(u * 15) * (1.5 * (1 - u) + 0.25)); fp.y = wy;
      fish.visible = false;
      const L = lerp(Lleap * 0.35, Lleap, e);
      shadow.visible = true; shadow.position.set(fp.x, wy + 0.04, fp.z); shadow.scale.set(L * 0.5, 1, L * 0.95); shadow.material.opacity = 0.2 + 0.4 * e;
      rippleT -= dt;
      if (rippleT <= 0) { rippleT = 0.32 - 0.12 * u; ring(fp.x, fp.z, 1.2 + 1.6 * u, 0.9); emit(fp.x, wy + 0.1, fp.z, 4, 1.6, 2.2, 0.8, 0.95, 1); }
      player.rotation.x = -(0.10 + 0.20 * e) - 0.05 * tug * e;
      player.position.set(base.x + F.x * 0.35 * e, base.y, base.z + F.z * 0.35 * e);
      armR.rotation.x = -1.05 - 0.12 * tug; armL.rotation.x = -0.8 - 0.1 * tug; armL.rotation.z = -0.12; armR.rotation.z = 0.12;
      legL.rotation.x = -0.25 * e; legR.rotation.x = 0.2 * e;
      rodMesh.rotation.x = 0.72;
      if (tipObj) tipObj.rotation.x = 0.85 + 0.25 * e + 0.08 * tug;
      line.visible = true; drawLine(fp, 0.05 + 0.25 * (1 - e));
      splashT -= dt;
      if (splashT <= 0) {
        splashT = 0.2 + Math.random() * 0.22 - 0.12 * u;
        emit(fp.x + (Math.random() - 0.5) * L * 0.4, wy + 0.1, fp.z + (Math.random() - 0.5) * L * 0.4, 10 + Math.floor(16 * u), 2.4 + 2.2 * u, 3.5 + 3 * u, 0.85, 0.97, 1);
        if (Math.random() < 0.55) ring(fp.x, fp.z, 1 + 2.2 * u, 0.9);
        if (u > 0.45 && typeof cfxShake === 'function' && Math.random() < 0.3) cfxShake(90);
      }
      if (fin) {
        const dx = fp.x - finPx, dz = fp.z - finPz;
        if (dx * dx + dz * dz > 1e-5) finHead = Math.atan2(dx, dz);
        finPx = fp.x; finPz = fp.z;
        const fs = L * (0.28 + 0.1 * e);
        fin.visible = true; fin.scale.set(fs * 0.5, fs, fs * 0.9); fin.position.set(fp.x, wy + 0.3 * fs, fp.z);
        fin.rotation.set(-0.3, finHead + Math.sin(t * 6) * 0.25, 0);
      }
    }
    function leapStep() {
      const u = (t - T_FIGHT) / (T_LEAP - T_FIGHT), e = ease(u);
      if (!erupted) erupt();
      fpPrev.copy(fish.position);
      fish.visible = true; shadow.visible = false;
      const wu = u + 0.5 * Math.sin(2 * Math.PI * u) / (2 * Math.PI); wig = 1;
      fish.position.set(lerp(A.x, H.x, wu), lerp(wy, H.y, wu) + 4 * (kind === 'kraken' ? 2.6 : 3.2) * wu * (1 - wu), lerp(A.z, H.z, wu));
      tmp.copy(fish.position).sub(fpPrev);
      if (tmp.lengthSq() > 1e-8) { tmp.normalize().multiplyScalar(2).add(fish.position); fish.lookAt(tmp); }
      fish.rotateZ(Math.sin(t * 9) * 0.28 * (1 - 0.4 * u) + (kind === 'kraken' ? 0 : Math.sin(t * 5.3) * 0.12));
      fish.scale.setScalar(lerp(Lleap, Lhold, bl(u, 0.55, 1)));
      qLeap.copy(fish.quaternion);
      animateModel(t, 0.55 * Math.sin(Math.PI * u));
      if (fish.position.y > wy) emit(fish.position.x, fish.position.y, fish.position.z, 4, 1.4, 0.2, 0.8, 0.95, 1);
      const k = bl(u, 0.15, 0.95);
      player.rotation.x = lerp(-0.3, -0.1, e);
      player.position.set(base.x + F.x * 0.35 * (1 - e), base.y, base.z + F.z * 0.35 * (1 - e));
      armR.rotation.x = lerp(-1.1, -2.9, k); armL.rotation.x = lerp(-0.9, -2.9, k); armL.rotation.z = lerp(-0.12, -0.3, k); armR.rotation.z = lerp(0.12, 0.3, k);
      legL.rotation.x *= 0.9; legR.rotation.x *= 0.9;
      if (tipObj) tipObj.rotation.x = lerp(1.1, 0.2, e);
      if (u < 0.85) { line.visible = true; drawLine(fish.position, 0.1 + u * 0.6); } else line.visible = false;
    }
    function holdStep(dt) {
      if (!erupted) erupt();
      const th = t - T_LEAP, u = c01(th / (T_HOLD - T_LEAP)), out = bl(t, T_HOLD, T_END);
      if (!fish.visible || th < dt * 1.5) { ring(base.x, base.z, 5.5, 1.2); emit(H.x, H.y, H.z, 60, 3.2, 3.5, 1, 0.85, 0.35); }
      fish.visible = true; shadow.visible = false; line.visible = false;
      fish.position.set(H.x, H.y + 0.18 * Math.sin(th * 2.4) + out * 1.5, H.z);
      fish.scale.setScalar(Math.max(0.001, Lhold * (1 + 0.03 * Math.sin(th * 5)) * (1 - out)));
      wig = 0.18 + 0.8 * Math.exp(-th * 0.9);
      eu.set((kind === 'kraken' ? -Math.PI / 2 : -1.0) + Math.sin(th * 2.1) * 0.12 * (1 - 0.5 * u), Math.sin(th * 0.9) * 1.0, Math.sin(th * 2.6) * 0.15 * (1 - u), 'YXZ'); qHold.setFromEuler(eu);
      fish.quaternion.copy(qLeap).slerp(qHold, bl(th, 0, 0.6)); fish.rotateZ(Math.sin(th * 9) * 0.22 * (1 - u));
      animateModel(t, 0.12 + 0.1 * Math.sin(th * 3));
      player.rotation.x = -0.05;
      player.position.set(base.x, base.y + Math.abs(Math.sin(th * 4.5)) * 0.12 * (1 - u * 0.5), base.z);
      armR.rotation.x = -2.9 + 0.1 * Math.sin(th * 7); armL.rotation.x = -2.9 - 0.1 * Math.sin(th * 7); armL.rotation.z = -0.3; armR.rotation.z = 0.3;
      legL.rotation.x *= 0.8; legR.rotation.x *= 0.8;
      pTick -= dt;
      if (pTick <= 0 && out < 0.9) {
        pTick = 0.035; if (Math.random() < 0.6) emit(fish.position.x + (Math.random() - 0.5) * 0.8, fish.position.y - 0.4, fish.position.z + (Math.random() - 0.5) * 0.8, 1, 0.25, 0, 0.7, 0.9, 1); const c = Math.random() < 0.5;
        emit(H.x + (Math.random() - 0.5) * 1.4, H.y + (Math.random() - 0.2) * 1.2, H.z + (Math.random() - 0.5) * 1.4, 2, 1.2, 1.6, c ? 1 : 0.4, c ? 0.85 : 0.95, c ? 0.35 : 1);
      }
      beam.visible = true; beam.material.opacity = 0.3 * bl(th, 0, 0.8) * (1 - out) * (0.85 + 0.15 * Math.sin(th * 9));
    }
    function cameraStep() {
      const py = base.y;
      posA.set(base.x + R.x * 3.3 + F.x * 1.1, py + 1.0 + 0.1 * Math.sin(t * 0.9), base.z + R.z * 3.3 + F.z * 1.1);
      tmp.set(fp.x, wy + 0.4, fp.z); lkA.set(base.x, py + 1.2, base.z).lerp(tmp, 0.55);
      posB.set(base.x - F.x * 2.1 + R.x * 1.0, py + 0.75 + 0.5 * c01((t - T_FIGHT) / 1.5), base.z - F.z * 2.1 + R.z * 1.0);
      lkB.copy(fish.visible ? fish.position : tmp); lkB.y = Math.max(lkB.y, py + 0.8);
      const ph = Math.PI - bl(t, T_LEAP, T_HOLD) * (Math.PI - 0.55);
      posC.set(base.x + (F.x * Math.cos(ph) + F.z * Math.sin(ph)) * 4.4, py + 1.7, base.z + (-F.x * Math.sin(ph) + F.z * Math.cos(ph)) * 4.4);
      lkC.set(base.x, py + 2.3, base.z);
      const kb = bl(t, T_FIGHT - 0.2, T_FIGHT + 0.5), kc = bl(t, T_LEAP - 0.1, T_LEAP + 0.8);
      cp.lerpVectors(posA, posB, kb).lerp(posC, kc); cl.lerpVectors(lkA, lkB, kb).lerp(lkC, kc);
      const sh = erupted ? 0.07 * (1 - c01((t - T_FIGHT) / 0.9)) : 0.012 + 0.03 * c01(t / T_FIGHT);
      cp.x += (Math.random() - 0.5) * sh; cp.y += (Math.random() - 0.5) * sh;
      const w = Math.min(bl(t, 0, 0.6), 1 - bl(t, T_HOLD, T_END));
      camera.position.copy(cp); camera.lookAt(cl); cinQ.copy(camera.quaternion);
      camera.position.lerpVectors(homeP, cp, w); camera.quaternion.copy(homeQ).slerp(cinQ, w);
      const fv = fov0 + 12 * Math.sin(Math.PI * c01((t - T_FIGHT) / 1.4)) * w - 6 * Math.sin(Math.PI * c01((t - T_FIGHT - 0.5) / (T_LEAP - T_FIGHT - 0.5))) * w;
      if (Math.abs(camera.fov - fv) > 0.01) { camera.fov = fv; camera.updateProjectionMatrix(); }
    }
    function frame() {
      const now = performance.now(), dt = Math.min(0.05, Math.max(0, (now - last) / 1000)); last = now;
      homeP.copy(camera.position); homeQ.copy(camera.quaternion);
      t += dt;
      if (t > 2.4) document.body.classList.add('skipok');
      if (t < T_FIGHT) fightStep(dt); else if (t < T_LEAP) leapStep(); else holdStep(dt);
      animateModel(t, parts.jaw ? parts.jaw.rotation.x : 0);
      stepPts(dt); stepRings(dt);
      if (!revealed && t >= T_REVEAL) { revealed = true; try { onReveal && onReveal(); } catch (e) { console.error(e); } }
      cameraStep();
      if (t >= T_END) finish();
    }

    function restore() {
      player.position.set(base.x, base.y, base.z); player.rotation.x = 0; player.rotation.order = base.order;
      [armL, armR, legL, legR].forEach(m => { m.rotation.x = 0; m.rotation.z = 0; });
      if (tipObj) tipObj.rotation.x = 0;
      if (camera.fov !== fov0) { camera.fov = fov0; camera.updateProjectionMatrix(); }
      if (root) {
        scene.remove(root);
        root.traverse(o => { if (o.geometry && o.geometry !== ringGeo) o.geometry.dispose(); if (o.material) { if (o.material.map) o.material.map.dispose(); o.material.dispose(); } });
        root = null;
      }
      rings.length = 0; ptsGeo = null; fish = null; line = null; shadow = null; beam = null; fin = null; parts = {};
    }
    function finish() {
      if (finished) return; finished = true; clearTimeout(failTimer);
      try { restore(); } catch (e) { console.error(e); }
      active = false;
      document.body.classList.remove('cine'); document.body.classList.remove('skipok');
      if (!revealed) { revealed = true; try { onReveal && onReveal(); } catch (e) { console.error(e); } }
      try { onDone && onDone(); } catch (e) { console.error(e); }
    }

    function play(cc, label, revealCb, doneCb) {
      if (active) { try { revealCb && revealCb(); doneCb && doneCb(); } catch (e) {} return; }
      onReveal = revealCb; onDone = doneCb; revealed = erupted = finished = false;
      try {
        ui(); active = true; t = 0; rippleT = 0; pTick = 0;
        const id = cc.fish.id, pp = player.position, ry = player.rotation.y;
        kind = id === 'kraken_purba' ? 'kraken' : 'shark';
        wy = water.position.y; fov0 = camera.fov;
        F.set(Math.sin(ry), 0, Math.cos(ry)); R.set(Math.cos(ry), 0, -Math.sin(ry));
        let d = Math.hypot(bobber.position.x - pp.x, bobber.position.z - pp.z); if (!(d > 4 && d < 16)) d = 8;
        S.set(pp.x + F.x * d, wy, pp.z + F.z * d);
        const da = Math.max(2.6, Math.min(4.2, d * 0.45)); A.set(pp.x + F.x * da, wy, pp.z + F.z * da);
        H.set(pp.x, pp.y + 3.2, pp.z);
        base.x = pp.x; base.y = pp.y; base.z = pp.z; base.order = player.rotation.order; player.rotation.order = 'YXZ';
        tipObj = rodMesh.children.find(c => c.geometry && c.geometry.parameters && c.geometry.parameters.radiusTop === 0.008) || null;
        root = new THREE.Group(); scene.add(root);
        inner = kind === 'kraken' ? buildKraken() : (id === 'megalodon' ? buildShark(0x56707f, 0xdfe8ee) : buildShark(0xd9a441, 0xfff1c4));
        inner.scale.setScalar(kind === 'kraken' ? 0.36 : 1); parts.s0 = inner.scale.x;
        fish = new THREE.Group(); fish.add(inner); fish.visible = false; root.add(fish);
        Lleap = kind === 'kraken' ? 5.4 : 5.0; Lhold = kind === 'kraken' ? 2.9 : 2.6;
        shadow = new THREE.Mesh(new THREE.CircleGeometry(0.5, 24).rotateX(-Math.PI / 2), new THREE.MeshBasicMaterial({ color: 0x021018, transparent: true, opacity: 0, depthWrite: false }));
        shadow.visible = false; root.add(shadow);
        fin = kind === 'kraken' ? null : new THREE.Mesh(new THREE.ConeGeometry(0.16, 0.8, 10), new THREE.MeshStandardMaterial({ color: id === 'megalodon' ? 0x56707f : 0xd9a441, roughness: 0.5 }));
        if (fin) { fin.rotation.order = 'YXZ'; fin.visible = false; root.add(fin); }
        finPx = S.x; finPz = S.z; finHead = Math.atan2(A.x - S.x, A.z - S.z); splashT = 0.3; wig = 1;
        beam = new THREE.Mesh(new THREE.CylinderGeometry(1.1, 1.6, 16, 24, 1, true), new THREE.MeshBasicMaterial({ color: 0xffe28a, transparent: true, opacity: 0, depthWrite: false, blending: THREE.AdditiveBlending, side: THREE.DoubleSide }));
        beam.position.set(pp.x, pp.y + 8, pp.z); beam.visible = false; root.add(beam);
        linePos = new Float32Array(LN * 3);
        const lg = new THREE.BufferGeometry(); lg.setAttribute('position', new THREE.BufferAttribute(linePos, 3));
        line = new THREE.Line(lg, new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.85 }));
        line.frustumCulled = false; line.visible = false; root.add(line);
        initPts();
        fp.copy(S); fpPrev.copy(S);
        document.body.classList.add('cine'); document.body.classList.remove('skipok');
        last = performance.now();
        failTimer = setTimeout(finish, 9500);
      } catch (e) { console.error(e); finish(); }
    }

    // ambil alih kamera, gerak karakter, dan auto-fish selama sinematik
    const _uc = updateCamera, _upm = updatePlayerMove, _uaf0 = updateAutoFish;
    updateCamera = function () { _uc(); if (active) { try { frame(); } catch (e) { console.error(e); finish(); } } };
    updatePlayerMove = function (dt) { if (active) return; _upm(dt); };
    updateAutoFish = function (dt) { if (active) return; _uaf0(dt); };

    return { play: play, get active() { return active; } };
  })();

  function finishReel(success) {
    resetFishing();
    if (success && currentCatch) {
      const key = currentCatch.fish.id + '|' + currentCatch.mutation.id;
      save.inventory[key] = save.inventory[key] || { fish: currentCatch.fish, mutation: currentCatch.mutation, count: 0 };
      save.inventory[key].count++; Quest.on('catch', currentCatch);
      save.inventory[key].maxW = Math.max(save.inventory[key].maxW || 0, currentCatch.weight || 0);
      addXp(Math.round((Math.round(currentCatch.value / 4) + 5) * (1 + enchBonus('xp') + (currentBait().xp || 0))));
      save.discovered = save.discovered || {}; save.discovered[currentCatch.fish.id] = true;
      const label = currentCatch.mutation.name ? currentCatch.mutation.name + ' ' + currentCatch.fish.name : currentCatch.fish.name;
      if (currentCatch.fish.rarity === 'secret') {
        const cc = currentCatch;
        const reveal = function () {
          triggerSecretCatchFX(label + ' — ' + cc.value + ' koin!');
          showToast('IKAN RAHASIA: ' + label + '!', 'secret');
          Sfx.catchFish('secret'); vibe(CATCH_VIBE.secret || [25]);
          if (window.PMNet) { try { window.PMNet.secret({ id: cc.fish.id, w: cc.weight, mut: cc.mutation && cc.mutation.name }); } catch (e) {} }
        };
        const done = function () { showCatchReveal(cc); };
        try { PMSecretCine.play(cc, label, reveal, done); } catch (e) { console.error(e); reveal(); done(); }
      } else {
        Sfx.catchFish(currentCatch.fish.rarity); vibe(CATCH_VIBE[currentCatch.fish.rarity] || [25]);
        showCatchReveal(currentCatch);
      }
      persistSave();
      refreshHud();
    } else if (currentCatch) {
      showToast('Ikannya kabur...'); Sfx.fail(); vibe(120);
    }
    currentCatch = null;
  }

  // ================= MANCING REALISTIS (v1.9) =================
const PMFish = (function () {
  const wy = () => water.position.y;
  const tipV = new THREE.Vector3();

  // ---- joran: ruas ujung yang bisa melengkung ----
  const tipSeg = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.014, 0.42, 8).translate(0, 0.21, 0), rodMesh.material);
  tipSeg.position.set(0, 0.55, 0);
  rodMesh.add(tipSeg);
  function rodTip(out) {
    tipSeg.updateWorldMatrix(true, false);
    return out.set(0, 0.42, 0).applyMatrix4(tipSeg.matrixWorld);
  }

  // ---- tali ----
  const LN = 20, linePos = new Float32Array(LN * 3);
  const lineGeo = new THREE.BufferGeometry();
  lineGeo.setAttribute('position', new THREE.BufferAttribute(linePos, 3));
  const lineMat = new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.85 });
  const line = new THREE.Line(lineGeo, lineMat);
  line.frustumCulled = false; line.visible = false; scene.add(line);
  function drawLine(sag, tens) {
    rodTip(tipV);
    const b = bobber.position;
    for (let i = 0; i < LN; i++) {
      const t = i / (LN - 1), j = i * 3;
      linePos[j] = tipV.x + (b.x - tipV.x) * t;
      linePos[j + 1] = tipV.y + (b.y - tipV.y) * t - sag * Math.sin(Math.PI * t);
      linePos[j + 2] = tipV.z + (b.z - tipV.z) * t;
    }
    lineGeo.attributes.position.needsUpdate = true;
    lineMat.color.setRGB(1, 1 - 0.7 * tens, 1 - 0.75 * tens);
    line.visible = true;
  }

  // ---- pelampung dua warna ----
  const cap = new THREE.Mesh(new THREE.SphereGeometry(0.075, 10, 8), new THREE.MeshLambertMaterial({ color: 0xffffff }));
  cap.position.y = 0.085; bobber.add(cap);

  // ---- riak air ----
  const RN = 6, ripples = [];
  for (let i = 0; i < RN; i++) {
    const g = new THREE.RingGeometry(0.82, 1, 28); g.rotateX(-Math.PI / 2);
    const m = new THREE.Mesh(g, new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0, side: THREE.DoubleSide, depthWrite: false }));
    m.visible = false; scene.add(m);
    ripples.push({ m: m, t: 1, max: 1 });
  }
  function spawnRipple(x, z, size) {
    let r = null;
    for (let i = 0; i < RN; i++) if (ripples[i].t >= 1) { r = ripples[i]; break; }
    if (!r) r = ripples[0];
    r.t = 0; r.max = size; r.m.position.set(x, wy() + 0.04, z); r.m.visible = true;
  }
  function updateRipples(dt) {
    for (let i = 0; i < RN; i++) {
      const r = ripples[i]; if (r.t >= 1) continue;
      r.t += dt / 1.1;
      if (r.t >= 1) { r.m.visible = false; continue; }
      const s = 0.12 + r.t * r.max;
      r.m.scale.set(s, 1, s);
      r.m.material.opacity = 0.6 * (1 - r.t);
    }
  }

  // ---- percikan ----
  const SPN = 44, spPos = new Float32Array(SPN * 3), spVel = new Float32Array(SPN * 3), spLife = new Float32Array(SPN);
  for (let i = 0; i < SPN; i++) spPos[i * 3 + 1] = -50;
  const spGeo = new THREE.BufferGeometry(); spGeo.setAttribute('position', new THREE.BufferAttribute(spPos, 3));
  const spPts = new THREE.Points(spGeo, new THREE.PointsMaterial({ color: 0xeaf6ff, size: 0.1, transparent: true, opacity: 0.9, depthWrite: false }));
  spPts.frustumCulled = false; scene.add(spPts);
  let spActive = false;
  function splash(x, z, n, pw) {
    let c = 0;
    for (let i = 0; i < SPN && c < n; i++) {
      if (spLife[i] > 0) continue;
      const a = Math.random() * Math.PI * 2, sp = (0.5 + Math.random() * 1.1) * pw, j = i * 3;
      spLife[i] = 0.55 + Math.random() * 0.35;
      spPos[j] = x; spPos[j + 1] = wy() + 0.05; spPos[j + 2] = z;
      spVel[j] = Math.cos(a) * sp * 0.6; spVel[j + 1] = 2.0 + Math.random() * 1.8 * pw; spVel[j + 2] = Math.sin(a) * sp * 0.6;
      c++;
    }
    spActive = true;
  }
  function updateSplash(dt) {
    if (!spActive) return;
    let any = false;
    for (let i = 0; i < SPN; i++) {
      if (spLife[i] <= 0) continue;
      const j = i * 3;
      spLife[i] -= dt;
      if (spLife[i] <= 0) { spPos[j + 1] = -50; continue; }
      spVel[j + 1] -= 9 * dt;
      spPos[j] += spVel[j] * dt; spPos[j + 1] += spVel[j + 1] * dt; spPos[j + 2] += spVel[j + 2] * dt;
      any = true;
    }
    spGeo.attributes.position.needsUpdate = true;
    spActive = any;
  }

  // ---- bayangan ikan ----
  const shGeo = new THREE.CircleGeometry(1, 20); shGeo.rotateX(-Math.PI / 2);
  const fishShadow = new THREE.Mesh(shGeo, new THREE.MeshBasicMaterial({ color: 0x082a3c, transparent: true, opacity: 0.5, depthWrite: false }));
  fishShadow.visible = false; scene.add(fishShadow);

  const reelLabelEl = document.getElementById('reelLabel');

  // ---- state ----
  let castAng = 0, castDist = 5, flightT = 0, flightDur = 0.8, arcH = 1.5;
  let reelProg = 0, reelDrain = 0.3, reelGain = 0.07, reelGrace = 0;
  let nibbles = [], nibbleIdx = 0, nibbleAnim = 0, wobPh = 0;
  let fStart = 6, fDist = 0, fMax = 0, fSp = 1, fTired = 1, fPhase = 'rest', fPhaseT = 0, fPhaseDur = 1;
  let tension = 0, lastTapT = -9, fWob = 0, fIdx = 0, warnT = 0, rippleT = 0;

  function autoOk() { return fishState === 'reeling' && fPhase === 'rest' && tension < 0.85; }

  function failReel(msg) {
    resetFishing(); showToast(msg); Sfx.fail(); vibe(120); currentCatch = null;
  }
  function win() {
    splash(bobber.position.x, bobber.position.z, 26, 1.4);
    spawnRipple(bobber.position.x, bobber.position.z, 1.8);
    finishReel(true);
  }
  function checkEnd() {
    if (fishState !== 'reeling') return;
    if (tension >= 1) failReel(currentCatch && currentCatch.tooHeavy ? 'Tali putus! Ikan ' + fmtKg(currentCatch.weight) + ' kelewat berat buat rod ini.' : 'Tali putus! Jangan tap terus pas ikan lari.');
    else if (fDist >= fMax) failReel('Ikannya kabur jauh...');
    else if (fDist <= 1.6 && !(currentCatch && currentCatch.tooHeavy)) win();
  }

  const _resetFishing = resetFishing;
  resetFishing = function () {
    _resetFishing();
    line.visible = false; fishShadow.visible = false; nibbleAnim = 0;
  };

  releaseCast = function () {
    lockedPower = chargeT;
    fishState = 'flying';
    castBoost = totalBoost() + castLuckBonus(); consumeBait(); if (window.PMNet && window.PMNet.cast) { try { window.PMNet.cast(); } catch (e) {} }
    Sfx.cast(); vibe(15);
    powerWrap.style.display = 'none';
    const rod = currentRod();
    castDist = 2.5 + lockedPower * rod.castRange;
    castAng = camYaw + Math.PI;
    rodTip(tipV); bobberStart.copy(tipV);
    bobberTarget.set(player.position.x + Math.sin(castAng) * castDist, wy() + 0.02, player.position.z + Math.cos(castAng) * castDist);
    castZone = 'umum';
    
    flightT = 0; flightDur = 0.55 + castDist * 0.045; arcH = 1.0 + castDist * 0.11;
    bobber.position.copy(bobberStart); bobber.visible = true;
    setFishBtnLabel('...', false);
  };

  beginWaiting = function () {
    fishState = 'waiting';
    const rod = currentRod();
    waitTarget = (2.0 + Math.random() * 3.5) / rod.biteSpeed;
    waitTimer = 0; nibbles = []; nibbleIdx = 0; nibbleAnim = 0; wobPh = Math.random() * 6.28;
    if (waitTarget > 1.7) {
      const cnt = 1 + Math.floor(Math.random() * 3);
      for (let i = 0; i < cnt; i++) nibbles.push(0.7 + Math.random() * (waitTarget - 1.5));
      nibbles.sort(function (a, b) { return a - b; });
    }
    setFishBtnLabel('Nunggu...', false);
  };

  beginStrikeWindow = function () {
    fishState = 'strike';
    strikeTimer = 0;
    setFishBtnLabel('TARIK!', true);
    Sfx.bite(); vibe([60, 40, 60]);
    fishHint.textContent = 'IKAN NYAMBER! TAP SEKARANG!';
    fishHint.style.display = 'block';
    spawnRipple(bobber.position.x, bobber.position.z, 1.1);
    splash(bobber.position.x, bobber.position.z, 8, 0.8);
    fishShadow.scale.set(0.15, 1, 0.4);
    fishShadow.position.set(bobber.position.x, wy() + 0.03, bobber.position.z);
    fishShadow.visible = true;
  };

  beginReeling = function () {
    fishState = 'reeling';
    currentCatch = rollFish(castBoost * PMEnv.boost()); assignWeight(currentCatch);
    fIdx = Math.max(0, RARITY_ORDER.indexOf(currentCatch.fish.rarity));
    fSp = (0.8 + 0.3 * fIdx) * (1 + 0.5 * Math.min(1, (currentCatch.weight || 0) / (ROD_WEIGHT[currentRod().id] || 10)));
    fDist = Math.max(2.5, Math.hypot(bobber.position.x - player.position.x, bobber.position.z - player.position.z));
    fMax = fDist + 5 + fIdx * 1.2;
    fStart = fDist; tension = 0.15; fTired = 1; fPhase = 'rest'; fPhaseT = 0; fPhaseDur = 1.0;
    lastTapT = -9; reelLastTapTime = -999; fWob = Math.random() * 6.28; rippleT = 0; warnT = 0; reelTapCount = 0;
    const s = 0.3 + fIdx * 0.07;
    fishShadow.scale.set(s * 0.5, 1, s * 1.25); fishShadow.visible = true;
    reelZoneEl.style.width = '0%'; reelZoneEl.className = '';
    reelTapHint.textContent = '(000)';
    reelLabelEl.textContent = 'Klik Cepat!';
    reelWrap.style.display = 'flex';
    fishHint.style.display = 'none';
    setFishBtnLabel('TARIK!', true);
  };

  handleReelTap = function () {
    if (fishState !== 'reeling') return;
    const nowMs = performance.now();
    if (nowMs - reelLastTapTime < 60) return;
    reelLastTapTime = nowMs; lastTapT = nowMs / 1000; reelTapCount++;
    Sfx.tap();
    if (fPhase === 'rest') { fDist -= 0.5; tension += 0.03; }
    else { fDist -= 0.12; tension += 0.045 * (0.6 + 0.4 * fSp); }
    checkEnd();
  };

  function updateRod(dt, now) {
    let tx = 0.3, bend = 0, k = 9;
    const st = fishState;
    if (st === 'charging') { tx = -0.15 - chargeT * 0.6; bend = -0.12; }
    else if (st === 'flying') { tx = 0.95; bend = 0.35 * (1 - flightT); k = 18; }
    else if (st === 'waiting') { tx = 0.8; bend = 0.1 + (nibbleAnim > 0 ? 0.22 : 0); }
    else if (st === 'strike') { tx = 0.55; bend = 0.55; k = 16; }
    else if (st === 'reeling') { tx = 0.72; bend = 0.25 + tension * 0.95; }
    rodMesh.rotation.x += (tx - rodMesh.rotation.x) * Math.min(1, dt * k);
    tipSeg.rotation.x += (bend - tipSeg.rotation.x) * Math.min(1, dt * 12);
    rodMesh.rotation.z = -0.5 + (st === 'reeling' ? Math.sin(now * 38) * 0.02 * tension : 0);
  }

  updateFishing = function (dt) {
    const now = performance.now() / 1000;
    if (fishState === 'charging') {
      chargeT += dt * 0.75 * chargeDir;
      if (chargeT >= 1) { chargeT = 1; chargeDir = -1; }
      if (chargeT <= 0) { chargeT = 0; chargeDir = 1; }
      powerFill.style.width = (chargeT * 100) + '%';
      powerFill.className = chargeT > 0.8 ? 'critical' : (chargeT > 0.55 ? 'warn' : '');
      powerMarker.style.left = (chargeT * 100) + '%';
    } else if (fishState === 'flying') {
      flightT += dt / flightDur;
      if (flightT >= 1) {
        bobber.position.copy(bobberTarget);
        splash(bobberTarget.x, bobberTarget.z, 16, 1);
        spawnRipple(bobberTarget.x, bobberTarget.z, 1.6);
        Sfx.tap();
        beginWaiting();
      } else {
        const u = flightT;
        bobber.position.set(
          bobberStart.x + (bobberTarget.x - bobberStart.x) * u,
          bobberStart.y + (bobberTarget.y - bobberStart.y) * u + 4 * arcH * u * (1 - u),
          bobberStart.z + (bobberTarget.z - bobberStart.z) * u);
        drawLine(0.25 * (1 - u), 0);
      }
    } else if (fishState === 'waiting') {
      waitTimer += dt;
      const bx = bobberTarget.x + Math.sin(now * 0.7 + wobPh) * 0.12;
      const bz = bobberTarget.z + Math.cos(now * 0.55 + wobPh) * 0.12;
      let by = bobberTarget.y + Math.sin(now * 2.1 + wobPh) * 0.035;
      if (nibbleIdx < nibbles.length && waitTimer >= nibbles[nibbleIdx]) {
        nibbleIdx++; nibbleAnim = 0.35; spawnRipple(bx, bz, 0.6); Sfx.tap(); vibe(10);
      }
      if (nibbleAnim > 0) {
        nibbleAnim -= dt;
        by -= Math.sin(Math.max(0, 1 - nibbleAnim / 0.35) * Math.PI) * 0.09;
      }
      bobber.position.set(bx, by, bz);
      drawLine(0.55 + Math.sin(now * 1.5) * 0.05, 0);
      if (waitTimer >= waitTarget) beginStrikeWindow();
    } else if (fishState === 'strike') {
      strikeTimer += dt;
      bobber.position.set(
        bobberTarget.x + Math.sin(now * 17) * 0.06,
        bobberTarget.y - 0.22 + Math.sin(now * 28) * 0.04,
        bobberTarget.z + Math.cos(now * 13) * 0.06);
      fishShadow.position.set(bobber.position.x, wy() + 0.03, bobber.position.z);
      if (Math.random() < dt * 6) spawnRipple(bobber.position.x, bobber.position.z, 0.7);
      drawLine(0.25, 0.35);
      if (strikeTimer > 1.3) { resetFishing(); showToast('Kelamaan, ikannya lepas.'); }
    } else if (fishState === 'reeling') {
      reelGrace = Math.max(0, reelGrace - dt);
      const tapping = (now - lastTapT) < 0.25;
      if (reelGrace <= 0) reelProg -= reelDrain * dt;
      reelProg = Math.min(1, reelProg);
      tension = 1 - Math.max(0, reelProg);
      fDist = fStart - (fStart - 1.6) * Math.max(0, reelProg);
      const a = castAng + Math.sin(now * 1.3 + fWob) * (tapping ? 0.1 : 0.22);
      const px = player.position.x + Math.sin(a) * fDist, pz = player.position.z + Math.cos(a) * fDist;
      bobber.position.set(px + Math.sin(now * 9) * 0.03,
        wy() + 0.02 - tension * 0.05 + Math.sin(now * (tapping ? 18 : 11)) * 0.025, pz);
      fishShadow.position.set(px, wy() + 0.03, pz); fishShadow.rotation.y = a;
      rippleT -= dt;
      if (tapping && rippleT <= 0) { rippleT = 0.2; spawnRipple(px, pz, 0.8 + fIdx * 0.1); }
      reelZoneEl.style.width = (Math.max(0, reelProg) * 100) + '%';
      reelZoneEl.className = reelProg < 0.25 ? 'critical' : (reelProg < 0.5 ? 'warn' : '');
      reelTapHint.textContent = '(' + String(Math.min(999, reelTapCount)).padStart(3, '0') + ')';
      reelLabelEl.textContent = reelProg < 0.25 ? 'CEPAT! Ikan mau lepas!' : 'Klik Cepat!';
      if (reelProg < 0.25) { warnT -= dt; if (warnT <= 0) { warnT = 0.35; vibe(25); } }
      drawLine(Math.max(0.05, 0.5 * (1 - tension)), tension);
      if (reelProg >= 1) win();
      else if (reelProg <= 0) failReel(currentCatch && currentCatch.tooHeavy ? 'Ikan ' + fmtKg(currentCatch.weight) + ' kelewat berat buat rod ini.' : 'Ikannya lepas! Tap lebih cepat.');
    }
    if (fishState === 'idle') {
      fishHint.style.display = nearWater() ? 'none' : 'block';
      if (!nearWater()) fishHint.textContent = 'Jalan ke tepi air dulu';
    } else {
      const target = fishState === 'charging' ? camYaw + Math.PI : castAng;
      let d = target - player.rotation.y; d = Math.atan2(Math.sin(d), Math.cos(d));
      player.rotation.y += d * Math.min(1, dt * 10);
    }
    updateRod(dt, now); updateRipples(dt); updateSplash(dt);
  };

  // auto-fish: cuma narik pas ikan lagi capek, jadi tali nggak putus
  const _uaf = updateAutoFish;
  updateAutoFish = function (dt) {
    if (fishState === 'reeling' && !autoOk()) {
      const real = handleReelTap;
      handleReelTap = function () {};
      try { _uaf(dt); } finally { handleReelTap = real; }
    } else _uaf(dt);
  };

    beginReeling = function () {
    fishState = 'reeling';
    currentCatch = rollFish(castBoost * PMEnv.boost()); assignWeight(currentCatch);
    fIdx = Math.max(0, RARITY_ORDER.indexOf(currentCatch.fish.rarity));
    const rod = currentRod();
    const h = Math.min(1, (currentCatch.weight || 0) / (ROD_WEIGHT[rod.id] || 10));
    reelGain = 0.07 * Math.sqrt(rod.biteSpeed) * (1.15 - 0.5 * h);
    reelDrain = (0.22 + 0.06 * fIdx) * (1 + 0.5 * h);
    if (currentCatch.tooHeavy) reelGain *= 0.25;
    reelProg = 0.25; reelGrace = 0.8;
    fStart = Math.max(2.5, Math.hypot(bobber.position.x - player.position.x, bobber.position.z - player.position.z));
    fDist = fStart; tension = 0.75; lastTapT = -9; reelLastTapTime = -999;
    fWob = Math.random() * 6.28; rippleT = 0; warnT = 0; reelTapCount = 0;
    const sz = 0.3 + fIdx * 0.07;
    fishShadow.scale.set(sz * 0.5, 1, sz * 1.25); fishShadow.visible = true;
    reelZoneEl.style.width = '25%'; reelZoneEl.className = '';
    reelTapHint.textContent = '(000)';
    reelLabelEl.textContent = 'Klik Cepat!';
    reelWrap.style.display = 'flex';
    fishHint.style.display = 'none';
    const rpt = document.getElementById('reelProgressTrack'); if (rpt) rpt.style.display = 'none';
    setFishBtnLabel('TAP!', true);
  };

  handleReelTap = function () {
    if (fishState !== 'reeling') return;
    const nowMs = performance.now();
    if (nowMs - reelLastTapTime < 50) return;
    reelLastTapTime = nowMs; lastTapT = nowMs / 1000; reelTapCount++;
    Sfx.tap();
    reelProg = Math.min(1, reelProg + reelGain);
    if (reelProg >= 1) win();
  };

  autoOk = function () { return true; };

  const _bsw = beginStrikeWindow;
  beginStrikeWindow = function () { _bsw(); setFishBtnLabel('TAP!', true); };

  return { autoOk: autoOk };
})();

  fishBtn.addEventListener('pointerdown', () => {
    Sfx.unlock();
    if (fishState === 'idle') startCharging();
    else if (fishState === 'strike') beginReeling();
    else if (fishState === 'reeling') handleReelTap();
  });
  fishBtn.addEventListener('pointerup', () => {
    if (fishState === 'charging') releaseCast();
  });
  reelWrap.addEventListener('pointerdown', handleReelTap);


  // ================= AUTO MANCING (item toko) =================
  // Cast, strike, dan tarik otomatis. Ikan Rahasia sengaja TIDAK ditarik otomatis: harus tap manual.
  let autoFishOn = false, autoTimer = 0, autoTapTimer = 0, autoPrevState = 'idle';
  function updateAutoFish(dt) {
    if (!autoFishOn || !save.autoFish) return;
    if (document.querySelector('.modalOverlay.show')) return;
    if (fishState !== autoPrevState) { autoPrevState = fishState; autoTimer = 0; autoTapTimer = 0; }
    if (fishState === 'idle') {
      if (!nearWater()) return;
      autoTimer += dt;
      if (autoTimer > 0.9) { autoTimer = 0; fishState = 'charging'; chargeT = 0.5 + Math.random() * 0.2; releaseCast(); }
    } else if (fishState === 'strike') {
      autoTimer += dt;
      if (autoTimer > 0.35) {
        autoTimer = 0; beginReeling();
        if (currentCatch && currentCatch.fish.rarity === 'secret') { showToast('IKAN RAHASIA nyangkut! Tap manual!', 'secret'); vibe([100, 60, 100]); }
      }
    } else if (fishState === 'reeling') {
      if (currentCatch && currentCatch.fish.rarity === 'secret') return;
      autoTapTimer += dt;
      if (autoTapTimer >= 0.2) { autoTapTimer = 0; handleReelTap(); }
    }
  }

  function updateFishing(dt) {
    if (fishState === 'charging') {
      chargeT += dt * 0.75 * chargeDir;
      if (chargeT >= 1) { chargeT = 1; chargeDir = -1; }
      if (chargeT <= 0) { chargeT = 0; chargeDir = 1; }
      powerFill.style.width = (chargeT * 100) + '%';
      powerFill.className = chargeT > 0.8 ? 'critical' : (chargeT > 0.55 ? 'warn' : '');
      powerMarker.style.left = (chargeT * 100) + '%';
    } else if (fishState === 'flying') {
      bobberT += dt * 1.8;
      if (bobberT >= 1) { bobberT = 1; bobber.position.copy(bobberTarget); beginWaiting(); }
      else {
        bobber.position.lerpVectors(bobberStart, bobberTarget, bobberT);
        bobber.position.y += Math.sin(bobberT * Math.PI) * 1.5;
      }
    } else if (fishState === 'waiting') {
      waitTimer += dt;
      bobber.position.y = bobberTarget.y + Math.sin(performance.now() * 0.003) * 0.05;
      if (waitTimer >= waitTarget) beginStrikeWindow();
    } else if (fishState === 'strike') {
      strikeTimer += dt;
      bobber.position.y = bobberTarget.y - 0.15 + Math.sin(performance.now() * 0.03) * 0.08;
      if (strikeTimer > 1.3) { resetFishing(); showToast('Kelamaan, ikannya lepas.'); }
    } else if (fishState === 'reeling') {
      reelDanger = Math.min(100, reelDanger + reelExpandRate * dt);
      reelZoneEl.style.width = Math.max(0, 100 - reelDanger) + '%';
      reelZoneEl.className = reelDanger > 80 ? 'critical' : (reelDanger > 55 ? 'warn' : '');
      if (reelDanger >= 100) finishReel(false);
    }
    // update hint tombol pancing sesuai jarak ke air pas idle
    if (fishState === 'idle') {
      fishHint.style.display = nearWater() ? 'none' : 'block';
      if (!nearWater()) fishHint.textContent = 'Jalan ke tepi air dulu';
    }
  }

  // ================= UI: INVENTORY =================
  const invList = document.getElementById('invList');
  const invTotalCount = document.getElementById('invTotalCount');
  function renderInventory() {
    invList.innerHTML = '';
    const entries = Object.values(save.inventory).filter(e => e.count > 0);
    let total = 0;
    if (entries.length === 0) invList.innerHTML = '<div class="rowSub" style="grid-column:1/-1;text-align:center;padding:20px 0;">Belum ada ikan. Yuk mancing!</div>';
    entries.sort((a, b) => RARITY_ORDER.indexOf(b.fish.rarity) - RARITY_ORDER.indexOf(a.fish.rarity));
    for (const e of entries) {
      total += e.count;
      const row = document.createElement('div'); row.className = 'rowItem';
      const label = (e.mutation.name ? e.mutation.name + ' ' : '') + e.fish.name;
      const val = Math.round(e.fish.value * (window.PMP ? window.PMP(e.fish.id) : 1) * e.mutation.mult * (1 + enchBonus('sell')));
      row.className = 'fishCard'; row.style.setProperty('--rc', RARITY_COLOR[e.fish.rarity]);
      row.innerHTML = `<span class="fcCount">x${e.count}</span>${e.mutation.name ? `<span class="fcMut">${e.mutation.name}</span>` : ''}<img class="fcImg" src="${fishIconCanvas(e.fish, e.mutation)}"><div class="fcName">${label}</div><div class="fcSub">${RARITY_LABEL[e.fish.rarity]} • ${e.maxW ? 'Terberat ' + fmtKg(e.maxW) : '-'}</div><button class="rowBtn" data-sell="${e.fish.id}|${e.mutation.id}">Jual ${val}</button>`;
      invList.appendChild(row);
    }
    invTotalCount.textContent = total + ' ikan';
    document.getElementById('coinsVal').textContent = save.coins;
  }
  invList.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-sell]'); if (!btn) return;
    const key = btn.dataset.sell; const entry = save.inventory[key];
    if (!entry || entry.count <= 0) return;
    const val = Math.round(entry.fish.value * (window.PMP ? window.PMP(entry.fish.id) : 1) * entry.mutation.mult * (1 + enchBonus('sell')));
    save.coins += val; entry.count--; Quest.on('sell', val);
    showToast('+' + val + ' koin'); Sfx.sell();
    persistSave(); renderInventory(); refreshHud();
  });
  function sellAllFish() {
    let sum = 0;
    for (const key in save.inventory) { const e = save.inventory[key]; sum += Math.round(e.fish.value * (window.PMP ? window.PMP(e.fish.id) : 1) * e.mutation.mult * (1 + enchBonus('sell'))) * e.count; e.count = 0; }
    if (sum > 0) { save.coins += sum; Quest.on('sell', sum); showToast('Jual semua! +' + sum + ' koin'); Sfx.sell(); vibe(30); persistSave(); }
    else showToast('Tas kosong');
    renderInventory(); refreshHud();
  }
  document.getElementById('btnSellAll').addEventListener('click', sellAllFish);
  document.getElementById('btnSellHud').addEventListener('click', sellAllFish);

  // ================= UI: INDEKS IKAN (PM_V44) =================
  const FX_LOC = [
    { k: 'umum', n: 'Perairan Umum', bg: 'linear-gradient(135deg,#e9c27a,#5fb3a6 55%,#2b7fb8)', t: f => !f.zone },
  ];
  let fxSel = 'umum';
  function renderIndex() {
    const list = document.getElementById('indexList'); list.innerHTML = '';
    const disc = save.discovered || {};
    const byRar = (a, b) => RARITY_ORDER.indexOf(a.rarity) - RARITY_ORDER.indexOf(b.rarity);
    let gotAll = 0;
    for (const f of FISH_TABLE) if (disc[f.id]) gotAll++;
    const loc = document.getElementById('fxLoc');
    let lh = '<div class="fxLocH">Lokasi</div>';
    for (const L of FX_LOC) {
      const fs = FISH_TABLE.filter(L.t), g = fs.filter(f => disc[f.id]).length;
      lh += '<button class="fxLocI' + (fxSel === L.k ? ' on' : '') + '" data-fx="' + L.k + '" style="background:' + L.bg + '">' + L.n + '<small>' + g + '/' + fs.length + '</small></button>';
    }
    loc.innerHTML = lh;
    const cur = FX_LOC.find(L => L.k === fxSel) || FX_LOC[0];
    const fish = FISH_TABLE.filter(cur.t).sort(byRar);
    let got = 0;
    for (const f of fish) {
      const known = !!disc[f.id]; if (known) got++;
      const c = document.createElement('div'); c.className = 'fxCard' + (known ? '' : ' un');
      c.innerHTML = `<div class="fxN">${known ? f.name : '???'}</div><img alt="" src="${fishIconCanvas(f, null, !known)}"><div class="fxR" style="color:${known ? RARITY_COLOR[f.rarity] : '#9aa7ae'}">${known ? RARITY_LABEL[f.rarity] + ' • ' + f.value + ' koin' : 'Belum ditemukan'}</div>`;
      list.appendChild(c);
    }
    document.getElementById('fxZone').textContent = cur.n;
    document.getElementById('fxProgTxt').textContent = cur.n + ' Ikan: ' + got + '/' + fish.length;
    document.getElementById('fxBarFill').style.width = (fish.length ? got / fish.length * 100 : 0) + '%';
    document.getElementById('indexCount').textContent = gotAll + '/' + FISH_TABLE.length + ' terkumpul';
  }
  document.getElementById('fxLoc').addEventListener('click', ev => {
    const b = ev.target.closest('[data-fx]'); if (!b) return; fxSel = b.dataset.fx; renderIndex();
  });
  document.getElementById('btnIndex').addEventListener('click', () => openModal('modalIndex'));
  document.getElementById('btnSound').addEventListener('click', () => {
    save.muted = !save.muted; saveQuiet(); refreshHud();
    if (!save.muted) { Sfx.unlock(); Sfx.sell(); }
  });
  document.getElementById('btnAuto').addEventListener('click', () => {
    autoFishOn = !autoFishOn; refreshHud();
    showToast(autoFishOn ? 'Auto Mancing aktif' : 'Auto Mancing mati');
  });

  // ================= UI: SHOP =================
  const shopList = document.getElementById('shopList');
  const shopCoins = document.getElementById('shopCoins');
  let shopTab = 'rod';
  function gearIconStyle(kind, id) {
    var key = 'g' + kind + id;
    var c = (GEAR_COLORS[kind] && GEAR_COLORS[kind][id]) || '#9fb4bd';
    if (!IC[key]) {
      var S = 96, cv = mkC(S * 2, S * 2), g = cv.getContext('2d'); g.scale(2, 2);
      var bg = g.createRadialGradient(48, 48, 4, 48, 48, 60); bg.addColorStop(0, c + '66'); bg.addColorStop(1, 'rgba(0,0,0,.45)'); g.fillStyle = bg; g.fillRect(0, 0, S, S);
      g.lineCap = 'round'; g.shadowColor = c; g.shadowBlur = 8;
      if (kind === 'rod') {
        var rg = g.createLinearGradient(14, 84, 84, 12); rg.addColorStop(0, '#3a2a1a'); rg.addColorStop(0.35, c); rg.addColorStop(1, '#ffffff');
        g.strokeStyle = rg; g.lineWidth = 5; g.beginPath(); g.moveTo(16, 82); g.quadraticCurveTo(54, 46, 84, 14); g.stroke();
        g.shadowBlur = 0; g.strokeStyle = '#6a4424'; g.lineWidth = 10; g.beginPath(); g.moveTo(12, 86); g.lineTo(27, 71); g.stroke();
        g.strokeStyle = 'rgba(0,0,0,.35)'; g.lineWidth = 2; for (var i = 0; i < 3; i++) { g.beginPath(); g.moveTo(14 + i * 5, 84 - i * 5 - 3); g.lineTo(18 + i * 5, 84 - i * 5 - 7); g.stroke(); }
        var rl = g.createRadialGradient(35, 60, 1, 36, 61, 10); rl.addColorStop(0, '#fff'); rl.addColorStop(0.6, '#b8c4cc'); rl.addColorStop(1, c);
        g.fillStyle = rl; g.beginPath(); g.arc(36, 61, 9, 0, 7); g.fill(); g.strokeStyle = '#333'; g.lineWidth = 1.5; g.stroke();
        g.fillStyle = '#333'; g.beginPath(); g.arc(36, 61, 2.5, 0, 7); g.fill();
        g.strokeStyle = '#e8eef2'; g.lineWidth = 2; [[46, 50], [60, 38], [72, 26]].forEach(function (p) { g.beginPath(); g.arc(p[0], p[1], 3.2, 0, 7); g.stroke(); });
        g.strokeStyle = 'rgba(255,255,255,.75)'; g.lineWidth = 1; g.beginPath(); g.moveTo(84, 14); g.quadraticCurveTo(92, 44, 84, 76); g.stroke();
        g.fillStyle = '#e04a3a'; g.beginPath(); g.arc(84, 78, 5, 0, 7); g.fill(); g.fillStyle = '#fff'; g.beginPath(); g.arc(84, 75, 3, 0, Math.PI, true); g.fill();
      } else {
        var bd = g.createLinearGradient(0, 30, 0, 66); bd.addColorStop(0, '#ffffff'); bd.addColorStop(0.3, c); bd.addColorStop(1, '#10161c');
        g.fillStyle = c; g.beginPath(); g.moveTo(66, 48); g.lineTo(86, 34); g.lineTo(86, 62); g.closePath(); g.fill();
        g.fillStyle = bd; g.beginPath(); g.ellipse(44, 48, 28, 16, -0.08, 0, 7); g.fill();
        g.strokeStyle = 'rgba(0,0,0,.3)'; g.lineWidth = 3; for (var k = 0; k < 4; k++) { g.beginPath(); g.moveTo(36 + k * 9, 34); g.quadraticCurveTo(40 + k * 9, 48, 36 + k * 9, 62); g.stroke(); }
        g.shadowBlur = 0; g.fillStyle = '#fff'; g.beginPath(); g.arc(24, 44, 5, 0, 7); g.fill(); g.fillStyle = '#111'; g.beginPath(); g.arc(23, 44, 3, 0, 7); g.fill();
        g.strokeStyle = '#c9d3da'; g.lineWidth = 2.4; g.beginPath(); g.moveTo(20, 40); g.lineTo(14, 22); g.arc(20, 22, 6, Math.PI, 0.4 * Math.PI, true); g.stroke();
        g.beginPath(); g.moveTo(50, 64); g.lineTo(50, 76); g.arc(56, 76, 6, Math.PI, 0.3 * Math.PI, true); g.stroke();
      }
      IC[key] = cv.toDataURL();
    }
    return 'background:#0b1c28 url(' + IC[key] + ') center/cover no-repeat;border:2px solid ' + c + ';box-shadow:0 0 10px ' + c + '88;';
  }
  function gearIconStyleOld(kind, id) {
    const c = (GEAR_COLORS[kind] && GEAR_COLORS[kind][id]) || '#9fb4bd';
    return `background:linear-gradient(135deg,${c},${c}99);border:2px solid ${c};box-shadow:0 0 8px ${c}88;`;
  }
  function renderShop() {
    shopCoins.textContent = save.coins;
    shopList.innerHTML = '';
    if (shopTab === 'rod') {
      for (const rod of ROD_TIERS) {
        const owned = save.ownedRods.includes(rod.id);
        const equipped = save.rod === rod.id;
        const canBuy = save.coins >= rod.price;
        const row = document.createElement('div'); row.className = 'rowItem';
        const btnLabel = equipped ? 'Terpasang' : (owned ? 'Pakai' : (rod.price + ' koin'));
        row.innerHTML = `<div class="rowIcon" style="${(window.pmRodIcon && window.pmRodIcon(rod.id, GEAR_COLORS.rod[rod.id] || '#9fb4bd')) || gearIconStyle('rod', rod.id)}"></div><div class="rowInfo"><div class="rowName">${rod.name}</div><div class="rowSub">Luck +${Math.round((rod.rarityBoost - 1) * 100)}% • Speed +${Math.round((rod.biteSpeed - 1) * 100)}% • Weight ${fmtKg(ROD_WEIGHT[rod.id])} • Range ${rod.castRange}m</div></div><button class="rowBtn ${equipped ? 'owned' : ''}" data-rod="${rod.id}" ${equipped ? 'disabled' : (!owned && !canBuy ? 'disabled' : '')}>${btnLabel}</button>`;
        shopList.appendChild(row);
      }
    } else if (shopTab === 'bait') {
      for (const bait of BAIT_TYPES) {
        const stock = save.baitStock[bait.id] || 0;
        const equipped = save.bait === bait.id;
        const canBuy = save.coins >= bait.price;
        const row = document.createElement('div'); row.className = 'rowItem';
        let btns;
        if (bait.id === 'biasa') btns = `<button class="rowBtn ${equipped ? 'owned' : ''}" data-usebait="biasa" ${equipped ? 'disabled' : ''}>${equipped ? 'Dipakai' : 'Pakai'}</button>`;
        else if (stock > 0) btns = `<button class="rowBtn ${equipped ? 'owned' : ''}" data-usebait="${bait.id}" ${equipped ? 'disabled' : ''}>${equipped ? 'Dipakai' : 'Pakai'}</button>`;
        else btns = `<button class="rowBtn" data-bait="${bait.id}" ${!canBuy ? 'disabled' : ''}>${bait.price} koin</button>`;
        row.innerHTML = `<div class="rowIcon" style="${gearIconStyle('bait', bait.id)}"></div><div class="rowInfo"><div class="rowName">${bait.name} ${equipped ? '(dipakai)' : ''}</div><div class="rowSub">Luck +${Math.round((bait.rarityBoost - 1) * 100)}%${baitExtra(bait)} • ${bait.id === 'biasa' || stock > 0 ? 'Dimiliki' : 'Belum dimiliki'}</div></div><div class="rowBtns">${btns}</div>`;
        shopList.appendChild(row);
      }
    } else {
      const row = document.createElement('div'); row.className = 'rowItem';
      const owned = !!save.autoFish;
      row.innerHTML = `<div class="rowIcon" style="background:linear-gradient(135deg,#6df0a0,#1fa85a);"></div><div class="rowInfo"><div class="rowName">Auto Mancing</div><div class="rowSub">Cast, strike & tarik otomatis. Ikan Rahasia tetap harus ditarik manual!</div></div><button class="rowBtn ${owned ? 'owned' : ''}" data-item="autofish" ${owned || save.coins < AUTOFISH_PRICE ? 'disabled' : ''}>${owned ? 'Dimiliki' : AUTOFISH_PRICE + ' koin'}</button>`;
      shopList.appendChild(row);
    }
  }
  document.querySelectorAll('.tabBtn').forEach(btn => btn.addEventListener('click', () => {
    document.querySelectorAll('.tabBtn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active'); shopTab = btn.dataset.tab; renderShop();
  }));
  shopList.addEventListener('click', (e) => {
    const rodBtn = e.target.closest('[data-rod]');
    if (rodBtn) {
      const id = rodBtn.dataset.rod; const rod = ROD_TIERS.find(r => r.id === id);
      if (save.ownedRods.includes(id)) { save.rod = id; showToast('Pakai ' + rod.name); }
      else if (save.coins >= rod.price) { save.coins -= rod.price; save.ownedRods.push(id); save.rod = id; showToast('Beli ' + rod.name + '!'); }
      persistSave(); renderShop(); refreshHud(); return;
    }
    const useBtn = e.target.closest('[data-usebait]');
    if (useBtn) {
      const id = useBtn.dataset.usebait;
      if ((save.baitStock[id] || 0) > 0) { save.bait = id; showToast('Pakai ' + BAIT_TYPES.find(b => b.id === id).name); persistSave(); renderShop(); refreshHud(); }
      return;
    }
    const itemBtn = e.target.closest('[data-item]');
    if (itemBtn) {
      if (!save.autoFish && save.coins >= AUTOFISH_PRICE) {
        save.coins -= AUTOFISH_PRICE; save.autoFish = true; Sfx.sell();
        showToast('Auto Mancing kebuka! Tombolnya di kiri atas.'); persistSave(); renderShop(); refreshHud();
      }
      return;
    }
    const baitBtn = e.target.closest('[data-bait]');
    if (baitBtn) {
      const id = baitBtn.dataset.bait; const bait = BAIT_TYPES.find(b => b.id === id);
      if (save.coins >= bait.price) {
        save.coins -= bait.price; save.baitStock[id] = Math.max(1, save.baitStock[id] || 0); save.bait = id;
        showToast('Beli ' + bait.name + '!');
      }
      persistSave(); renderShop(); refreshHud();
    }
  });

  // ================= MODAL OPEN/CLOSE =================
  function openModal(id) { document.getElementById(id).classList.add('show'); if (id === 'modalInventory') renderInventory(); if (id === 'modalShop') renderShop(); if (id === 'modalIndex') renderIndex(); }
  function closeModal(id) { document.getElementById(id).classList.remove('show'); }
  document.getElementById('btnInventory').addEventListener('click', () => openModal('modalInventory'));
  document.getElementById('btnShop').addEventListener('click', () => openModal('modalShop'));
  document.querySelectorAll('.modalClose').forEach(btn => btn.addEventListener('click', () => closeModal(btn.dataset.close)));

  function openShopTab(tab) {
    shopTab = tab;
    document.querySelectorAll('.tabBtn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
    openModal('modalShop');
  }
  document.getElementById('interactBtn').addEventListener('click', () => { Sfx.unlock(); if (interactTarget) interactTarget.action(); });

  let prevCoinsShown = null, prevLevelShown = null;
  function pulseEl(el) { if (!el) return; el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop'); }
  function refreshHud() {
    const coinBadgeEl = document.querySelector('.coinBadge');
    const levelValEl = document.getElementById('levelVal');
    if (prevCoinsShown !== null && save.coins !== prevCoinsShown) pulseEl(coinBadgeEl);
    if (prevLevelShown !== null && save.level !== prevLevelShown) pulseEl(levelValEl);
    prevCoinsShown = save.coins; prevLevelShown = save.level;
    document.getElementById('coinsVal').textContent = save.coins;
    document.getElementById('levelVal').textContent = save.level;
    document.getElementById('xpFill').style.width = Math.min(100, (save.xp / xpForLevel(save.level)) * 100) + '%';
    document.getElementById('rodVal').textContent = currentRod().name + (save.enchants && save.enchants[save.rod] ? ' ✦' : ''); document.getElementById('rodChip').style.setProperty('--rc', GEAR_COLORS.rod[save.rod] || '#9fb4bd');
    document.getElementById('xpText').textContent = save.xp + '/' + xpForLevel(save.level);
    const _rd = currentRod();
    document.getElementById('statsRow').innerHTML = '<span class="st stL" title="Luck">🍀 +' + hudAb(Math.round((totalBoost() - 1) * 100)) + '%</span><span class="st stS" title="Speed">⚡ +' + hudAb(Math.round((_rd.biteSpeed - 1) * 100)) + '%</span><span class="st stW" title="Weight">⚖️ ' + hudKg(ROD_WEIGHT[_rd.id] || 10) + '</span>';
    const b = currentBait();
    document.getElementById('baitVal').textContent = b.name.replace(' Bait', ''); document.getElementById('baitChip').style.setProperty('--rc', GEAR_COLORS.bait[b.id] || '#9fb4bd');
    const cnt = Object.values(save.inventory).reduce((a, e) => a + e.count, 0);
    const badge = document.getElementById('invBadge');
    badge.textContent = cnt > 99 ? '99+' : cnt; badge.classList.toggle('show', cnt > 0);
    const canShop = ROD_TIERS.some(r => !save.ownedRods.includes(r.id) && save.coins >= r.price) || (!save.autoFish && save.coins >= AUTOFISH_PRICE);
    document.getElementById('shopDot').classList.toggle('show', canShop);
    document.getElementById('btnSellHud').textContent = 'Jual Semua' + (cnt > 0 ? ' (' + cnt + ')' : '');
    const autoBtn = document.getElementById('btnAuto');
    autoBtn.style.display = save.autoFish ? 'inline-block' : 'none';
    autoBtn.classList.toggle('on', autoFishOn); autoBtn.textContent = 'Auto: ' + (autoFishOn ? 'ON' : 'OFF');
    document.getElementById('btnSound').textContent = 'Suara: ' + (save.muted ? 'OFF' : 'ON');
  }

  // ================= GERAK KARAKTER =================
  let MOVE_SPEED = 4.2;
  let walkT = 0;
  function updatePlayerMove(dt) {
    const mag = Math.hypot(joyVec.x, joyVec.y);
    if (mag > 0.08) {
      // gerak relatif arah kamera biar joystick "maju" = menjauh dari kamera
      const forward = { x: -Math.sin(camYaw), z: -Math.cos(camYaw) };
      const right = { x: Math.cos(camYaw), z: -Math.sin(camYaw) };
      const mx = (forward.x * -joyVec.y + right.x * joyVec.x);
      const mz = (forward.z * -joyVec.y + right.z * joyVec.x);
      const len = Math.hypot(mx, mz) || 1;
      const nx = mx / len, nz = mz / len;
      const nextX = player.position.x + nx * MOVE_SPEED * dt * Math.min(1, mag);
      const nextZ = player.position.z + nz * MOVE_SPEED * dt * Math.min(1, mag);
      let mvX = player.position.x, mvZ = player.position.z, moved = false;
      if (walkable(nextX, nextZ)) { mvX = nextX; mvZ = nextZ; moved = true; }
      else if (walkable(nextX, mvZ)) { mvX = nextX; moved = true; }
      else if (walkable(mvX, nextZ)) { mvZ = nextZ; moved = true; }
      if (moved) {
        player.position.x = mvX; player.position.z = mvZ;
        player.rotation.y = Math.atan2(nx, nz);
        walkT += dt * 8;
        legL.rotation.x = Math.sin(walkT) * 0.5; legR.rotation.x = -Math.sin(walkT) * 0.5;
        armL.rotation.x = -Math.sin(walkT) * 0.4; armR.rotation.x = Math.sin(walkT) * 0.4;
        if (fishState !== 'idle' && fishState !== 'charging') resetFishing();
      }
    } else {
      legL.rotation.x *= 0.8; legR.rotation.x *= 0.8; armL.rotation.x *= 0.8; armR.rotation.x *= 0.8;
    }
    // tinggi lantai halus pas naik/turun dek (jalan terus, diam pun tetap disinkronkan)
    player.position.y += (groundHeightAt(player.position.x, player.position.z) - player.position.y) * Math.min(1, dt * 16);
  }

  // ================= LOOP UTAMA =================
  let lastT = performance.now(), fpsAcc = 0, fpsCount = 0, fpsShown = 60;
  const fpsEl = document.getElementById('fpsFish');
  let rafId = 0, loopOn = false, loopPaused = false;
  function animate() {
    loopOn = true;
    rafId = requestAnimationFrame(animate);
    const now = performance.now();
    let dt = (now - lastT) / 1000; lastT = now;
    dt = Math.min(dt, 0.08);

    fpsAcc += dt; fpsCount++;
    if (fpsAcc >= 0.5) { fpsShown = Math.round(fpsCount / fpsAcc); fpsAcc = 0; fpsCount = 0; fpsEl.textContent = fpsShown + ' FPS'; }

    if (gameStarted) {
      updatePlayerMove(dt);
      updateAutoFish(dt);
      if (!document.querySelector(".modalOverlay.show")) updateFishing(dt);
      updateCamera();
      water.rotation.y += dt * 0.01;
      updateTownAnim(now / 1000);
      updateInteract();
    }
    renderer.render(scene, camera);
  }

  // Pause loop + audio waktu app di-minimize / layar mati, lanjut lagi pas balik
  document.addEventListener('visibilitychange', () => {
    if (!loopOn) return;
    if (document.hidden) {
      loopPaused = true;
      cancelAnimationFrame(rafId);
      Sfx.suspend();
    } else if (loopPaused) {
      loopPaused = false;
      lastT = performance.now(); // biar dt gak loncat besar setelah balik
      Sfx.resume();
      rafId = requestAnimationFrame(animate);
    }
  });

  // ================= LOADING & START =================
  const loadingScreenEl = document.getElementById('loadingScreen');
  const loadingBarEl = document.getElementById('loadingBarFill');
  const loadingLabelEl = document.getElementById('loadingLabel');
  function setLoadingProgress(pct, label) {
    loadingBarEl.style.width = Math.max(4, Math.min(100, pct)) + '%';
    if (label) loadingLabelEl.textContent = label;
  }
  let gameStarted = false;
  async function boot() {
    try {
      setLoadingProgress(20, 'Menyiapkan ikan & toko...');
      loadSave();
      await new Promise(r => setTimeout(r, 0));
      setLoadingProgress(55, 'Membangun pulau...');
      await new Promise(r => setTimeout(r, 0));
      updateCamera();
      renderer.render(scene, camera); // render 1 frame awal biar gak blank pas start screen muncul
      setLoadingProgress(85, 'Hampir siap...');
      await new Promise(r => setTimeout(r, 0));
      refreshHud();
    } catch (e) {
      console.error('Boot gagal:', e);
      loadingLabelEl.textContent = 'Error boot: ' + e.message;
    }
    setLoadingProgress(100, 'Selesai!');
    loadingScreenEl.classList.add('hidden');
    setTimeout(() => { loadingScreenEl.style.display = 'none'; }, 450);
    document.getElementById('startScreen').style.display = 'flex';
    animate();
  }

  document.getElementById('startBtn').addEventListener('click', () => {
    Sfx.unlock();
    document.getElementById('startScreen').style.display = 'none';
    document.getElementById('hud').style.display = 'flex';
    document.getElementById('topRightBW').style.display = 'flex';
    document.getElementById('joystickZone').style.display = 'block';
    document.getElementById('fishActionWrap').style.display = 'flex';
    gameStarted = true;
  });


  window.__PMC = {
    scene: scene, player: player, body: body, legL: legL, rodMesh: rodMesh, boatMesh: boatMesh, town: town,
    TOWN_SHOPS: TOWN_SHOPS, TOWN_COLLIDERS: TOWN_COLLIDERS, FISH_TABLE: FISH_TABLE, MUTATIONS: MUTATIONS,
    RARITY_COLOR: RARITY_COLOR, RARITY_LABEL: RARITY_LABEL, RARITY_ORDER: RARITY_ORDER, ROD_TIERS: ROD_TIERS, BAIT_TYPES: BAIT_TYPES,
    GEAR_COLORS: GEAR_COLORS, ISLAND_RADIUS: ISLAND_RADIUS, DECK_Y: DECK_Y, fmtKg: fmtKg, get fishState() { return fishState; }, get tapCount() { return reelTapCount; },
    makeSignTexture: makeSignTexture, fishIconCanvas: fishIconCanvas, addXp: addXp, Sfx: Sfx, vibe: vibe,
    get save() { return save; }, persist: persistSave, refresh: refreshHud, toast: showToast,
    setSpeed: function (v) { MOVE_SPEED = v; }, hookFinish: function (w) { var o = finishReel; finishReel = function (ok) { var c = currentCatch; o(ok); w(ok, c); }; },
    hookRoll: function (w) { var o = rollFish; rollFish = function (b) { return w(o, b); }; },
    hookAnim: function (w) { var o = updateTownAnim; updateTownAnim = function (t) { o(t); w(t); }; },
    setNearWater: function (f) { var o = nearWater; nearWater = function () { return f(o); }; },
    setWalkable: function (f) { var o = walkable; walkable = function (x, z) { return f(o, x, z); }; },
    setGround: function (f) { var o = groundHeightAt; groundHeightAt = function (x, z) { return f(o, x, z); }; }
  };
  if (window.PMExt) { try { window.PMExt(window.__PMC); } catch (e) { console.warn('PMExt gagal:', e); } }

  boot();
})();
</script>

<script>
(function () {
  var KEY = 'pancingmania_save_v1';
  function $(id) { return document.getElementById(id); }
  var ov = document.createElement('div');
  ov.className = 'modalOverlay'; ov.id = 'modalBackup';
  ov.innerHTML = '<div class="modalBox"><div class="modalHead"><h2>Backup Save</h2><button class="modalClose" id="bkClose">✕</button></div><div class="modalBody"><textarea id="bkText" rows="6" placeholder="Kode save muncul di sini. Tempel kode lama buat Muat." style="width:100%;border-radius:12px;border:2px solid rgba(255,255,255,0.3);background:rgba(0,0,0,0.35);color:#fff;font:11px monospace;padding:8px;user-select:text;-webkit-user-select:text;resize:none;"></textarea><div style="display:flex;gap:8px;"><button class="rowBtn" id="bkCopy" style="flex:1">Salin Save</button><button class="rowBtn" id="bkLoad" style="flex:1">Muat Save</button></div><div id="bkMsg" style="font-size:11px;color:var(--text-dim);min-height:14px;"></div></div></div>';
  document.body.appendChild(ov);
  function msg(t) { $('bkMsg').textContent = t; }

  $('bkClose').onclick = function () { ov.classList.remove('show'); };

  $('bkCopy').onclick = function () {
    var raw = localStorage.getItem(KEY);
    if (!raw) { msg('Belum ada save.'); return; }
    var code = 'PM1:' + btoa(unescape(encodeURIComponent(raw)));
    var t = $('bkText'); t.value = code; t.select();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(
        function () { msg('Tersalin! Simpen di Catatan / chat sendiri.'); },
        function () { msg('Kode udah kepilih, salin manual.'); });
    } else { msg('Kode udah kepilih, salin manual.'); }
  };

  $('bkLoad').onclick = function () {
    var v = $('bkText').value.trim(), raw, o;
    if (v.indexOf('PM1:') !== 0) { msg('Kode nggak valid.'); return; }
    try {
      raw = decodeURIComponent(escape(atob(v.slice(4))));
      o = JSON.parse(raw);
      if (!o || typeof o.coins !== 'number' || typeof o.inventory !== 'object') throw 0;
    } catch (e) { msg('Kode rusak / nggak lengkap.'); return; }
    if (!confirm('Timpa save sekarang dengan kode ini?')) return;
    var orig = Storage.prototype.setItem;
    orig.call(localStorage, KEY, raw);
    Storage.prototype.setItem = function (k) { if (k === KEY) return; return orig.apply(this, arguments); };
    location.reload();
  };

  var pills = $('hudPills');
  if (pills) {
    var b = document.createElement('button');
    b.className = 'hudPill'; b.textContent = 'Backup';
    b.onclick = function () { $('bkText').value = ''; msg(''); ov.classList.add('show'); };
    pills.appendChild(b);
  }
})();
</script>
<style>
#menuPanel { display: none; position: absolute; top: 100%; right: 0; margin-top: 8px; flex-direction: column; gap: 6px; padding: 8px; min-width: 130px; border-radius: 16px; background: linear-gradient(160deg, #1d5068, #0c2836); border: 3px solid rgba(255,255,255,0.92); box-shadow: 0 5px 0 rgba(0,0,0,0.32), 0 10px 18px rgba(0,0,0,0.4); z-index: 12; }
#menuPanel.show { display: flex; }
#menuPanel .hudPill { width: 100%; text-align: center; }
</style>
<script>
(function () {
  var pills = document.getElementById('hudPills');
  if (!pills) return;
  var panel = document.createElement('div'); panel.id = 'menuPanel';
  var menuBtn = document.createElement('button'); menuBtn.className = 'hudPill'; menuBtn.textContent = 'Menu ▾';
  pills.appendChild(menuBtn); pills.appendChild(panel);
  Array.prototype.slice.call(pills.querySelectorAll('.hudPill')).forEach(function (b) {
    var t = b.textContent || '';
    if (b.id === 'btnSound' || t.indexOf('Grafis') === 0 || t === 'Backup') {
      panel.appendChild(b);
      if (t === 'Backup') b.addEventListener('click', function () { panel.classList.remove('show'); });
    }
  });
  menuBtn.addEventListener('click', function (e) { e.stopPropagation(); panel.classList.toggle('show'); });
  panel.addEventListener('click', function (e) { e.stopPropagation(); });
  document.addEventListener('click', function () { panel.classList.remove('show'); });
})();
</script>
<style>
#updSec { margin-bottom: 4px; }
#updSec h3 { margin: 6px 0 4px; font-size: 12.5px; font-weight: 900; color: var(--gold); letter-spacing: 0.4px; }
#updSec ul { margin: 0 0 6px; padding-left: 18px; }
#updSec li { font-size: 12px; line-height: 1.45; margin-bottom: 3px; color: var(--text); }
#updVer { font-size: 11px; color: var(--text-dim); margin-bottom: 2px; }
</style>
<script>
(function () {
  var VER = 'v4.18', DATE = '4 Okt 2026', KEY = 'pm_seen_ver';
  var LOG = [
    ["Update v4.18", [
      "Area api unggun di tengah pulau: api 3D HD dengan nyala, percikan, dan asap, plus kuali di tripod, 3 bangku batu, tenda bergaris, dan tumpukan kayu. Malam hari api menyala hangat dan menerangi sekitarnya.",
      "Jalan setapak batu dari plaza ke api unggun, Rumah Nelayan, sampai pantai belakang (ada papan PANTAI di ujung, bisa dipakai mancing).",
      "Gubuk jadi Rumah Nelayan 3D. Ada Mbok Sari yang kasih Bingkisan Harian (koin dan XP) dan jalan pintas ke menu Misi.",
      "Kunang-kunang muncul malam hari, kupu-kupu terbang siang hari.",
      "Bunga, semak, dan rumput tinggi yang bergoyang tersebar di pulau, terutama di pinggir jalan setapak."
    ]]
  ];
  var vb0 = document.getElementById('versionBadge'); if (vb0) vb0.textContent = VER; // badge versi ikut VER
  var g0 = document.getElementById('gearRow'), s0 = document.getElementById('statsRow');
  if (g0 && s0 && s0.parentNode !== g0) g0.appendChild(s0); // statistik digabung ke baris alat pancing
  function lsGet() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
  function lsSet(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
  var ov = document.createElement('div');
  ov.className = 'modalOverlay'; ov.id = 'modalUpdate';
  var html = '<div class="modalBox"><div class="modalHead"><h2>Info Update ' + VER + '</h2><button class="modalClose" id="updClose">✕</button></div><div class="modalBody"><div id="updVer">' + DATE + '</div><div id="updSec">';
  LOG.forEach(function (sec) {
    html += '<h3>' + sec[0] + '</h3><ul>';
    sec[1].forEach(function (t) { html += '<li>' + t + '</li>'; });
    html += '</ul>';
  });
  html += '</div></div><div class="modalFoot"><span>Pancing Mania ' + VER + '</span><button class="rowBtn" id="updOk">Oke</button></div></div>';
  ov.innerHTML = html;
  document.body.appendChild(ov);
  function closeUpd() { ov.classList.remove('show'); lsSet(VER); var b = document.getElementById('btnUpdInfo'); if (b) b.textContent = 'Info Update'; }
  document.getElementById('updClose').onclick = closeUpd;
  document.getElementById('updOk').onclick = closeUpd;
  var host = document.getElementById('menuPanel') || document.getElementById('hudPills');
  if (host) {
    var btn = document.createElement('button');
    btn.className = 'hudPill'; btn.id = 'btnUpdInfo';
    btn.textContent = lsGet() === VER ? 'Info Update' : 'Info Update (BARU)';
    btn.onclick = function () { ov.classList.add('show'); var mp = document.getElementById('menuPanel'); if (mp) mp.classList.remove('show'); };
    host.appendChild(btn);
  }
  var startBtn = document.getElementById('startBtn');
  if (startBtn) startBtn.addEventListener('click', function () {
    if (lsGet() !== VER) setTimeout(function () { ov.classList.add('show'); }, 700);
  });
})();
</script>
<style>
/* v3.5: panel HUD diringkas jadi 2 baris */
#gearRow { flex-wrap: wrap; gap: 3px 4px; margin-top: 3px; }
#gearRow .gearChip { padding: 0 5px; font-size: 8.5px; }
#statsRow { display: contents; }
#gearRow .st { font-size: 8.5px; padding: 0 5px; border-radius: 8px; background: rgba(0,0,0,.38); border-width: 1.5px; border-style: solid; }
</style>
<style>
/* v3.6: label bawah & FPS lebih kebaca */
#versionBadge { color: rgba(255,255,255,.88) !important; text-shadow: 0 1px 3px rgba(0,0,0,.95), 0 0 7px rgba(0,0,0,.75) !important; }
#envLabel { color: #fff !important; font-weight: 800 !important; text-shadow: 0 1px 3px rgba(0,0,0,.95), 0 0 7px rgba(0,0,0,.75) !important; background: rgba(0,0,0,.28); padding: 1px 10px; border-radius: 999px; }
#fpsFish { color: rgba(255,255,255,.85); text-shadow: 0 1px 3px rgba(0,0,0,.95); }
</style>
<style>
/* v3.7: layar maintenance penuh & pesannya terbaca */
#mpGate[data-k="m"] { background: radial-gradient(ellipse at 50% 40%, #0c2230 0%, #02080e 72%); }
#mpGate[data-k="m"] h2 { font-size: 26px; }
#mpGate[data-k="m"] .mpSm { font-size: 15px; color: rgba(255,255,255,.9); max-width: min(86vw, 420px); line-height: 1.45; }
#mpGate .mpAuto { font-size: 11px; color: rgba(255,255,255,.5); max-width: min(86vw, 360px); }
</style>
<!-- landscape-fix v2.4 -->
<style>
@media (orientation: landscape) and (max-height: 520px) {
  #hud { top: calc(6px + env(safe-area-inset-top, 0px)); }
  .hudPanel { padding: 4px 10px 4px 16px; border-width: 2px; }
  #hudPills { top: calc(8px + env(safe-area-inset-top, 0px)); left: auto; right: calc(70px + env(safe-area-inset-right, 0px)); transform: none; max-width: none; gap: 4px; }
  .hudPill { font-size: 9px; padding: 4px 8px; }
  #versionBadge { top: auto; bottom: calc(3px + env(safe-area-inset-bottom, 0px)); }
  #envLabel { top: auto !important; bottom: calc(26px + env(safe-area-inset-bottom, 0px)) !important; }
  #topRightBW { top: calc(6px + env(safe-area-inset-top, 0px)); gap: 5px; }
  .iconBtn { width: 46px; }
  .iconCircle { width: 40px; height: 40px; }
  #topRightBW .ico { width: 20px !important; height: 20px !important; }
  #joystickZone { width: 104px; height: 104px; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); }
  #fishActionWrap { bottom: calc(10px + env(safe-area-inset-bottom, 0px)); }
  #fishBtn { width: 84px; height: 84px; font-size: 11px; border-width: 3px; }
  #fishBtn .ico { width: 17px; height: 17px; }
  #powerWrap, #reelWrap { bottom: calc(40px + env(safe-area-inset-bottom, 0px)); }
  #castRating { bottom: 100px; }
  #interactBtn { bottom: calc(24px + env(safe-area-inset-bottom, 0px)); right: calc(132px + env(safe-area-inset-right, 0px)); }
  #toastWrap { top: 56px; }
  .modalOverlay { padding: 8px calc(8px + env(safe-area-inset-right, 0px)) 8px calc(8px + env(safe-area-inset-left, 0px)); }
  .modalBox { width: min(92vw, 620px); max-height: 92vh; max-height: 92dvh; }
  .modalHead { padding: 9px 14px; }
  .modalBody { padding: 8px 12px; }
  .modalFoot { padding: 8px 14px; }
  #invList { grid-template-columns: repeat(3, 1fr); }
  #startScreen { gap: 8px; padding: 10px; overflow-y: auto; justify-content: flex-start; }
  #startScreen > :first-child { margin-top: auto; }
  #startScreen > :last-child { margin-bottom: auto; }
  #startTitle { font-size: 30px; }
  #startBtn { padding: 10px 36px; margin-top: 2px; }
  #startTips { padding: 6px 12px; }
  #loadingScreen { gap: 10px; }
  #loadingLogo { font-size: 26px; }
}
</style>
<script>
(function () {
  function f() { window.dispatchEvent(new Event('resize')); }
  function later() { setTimeout(f, 120); setTimeout(f, 400); }
  window.addEventListener('orientationchange', later);
  if (screen.orientation && screen.orientation.addEventListener) screen.orientation.addEventListener('change', later);
})();
</script>
<script>
(function () {
  var KEY = 'pancingmania_save_v1';
  function C() { return window.__PMC; }
  function flush() {
    try { if (C() && C().save) localStorage.setItem(KEY, JSON.stringify(C().save)); } catch (e) {}
  }
  document.addEventListener('visibilitychange', function () { if (document.hidden) flush(); });
  window.addEventListener('pagehide', flush);
  setInterval(flush, 15000);
  var wl = null;
  function lockScreen() {
    try {
      if ('wakeLock' in navigator && !wl) {
        navigator.wakeLock.request('screen').then(function (l) {
          wl = l; l.addEventListener('release', function () { wl = null; });
        }).catch(function () {});
      }
    } catch (e) {}
  }
  document.addEventListener('visibilitychange', function () { if (!document.hidden) lockScreen(); });
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (t && t.classList && t.classList.contains('modalOverlay') && t.id !== 'modalUpdate') t.classList.remove('show');
  });
  function dstr(d) { return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); }
  function dailyBonus() {
    var c = C(); if (!c) return;
    var s = c.save, today = dstr(new Date()), yest = dstr(new Date(Date.now() - 86400000));
    if (s.loginDay === today) return;
    s.loginStreak = (s.loginDay === yest) ? (s.loginStreak || 0) + 1 : 1;
    s.loginDay = today;
    var n = Math.min(s.loginStreak, 7), coins = 40 * n + 10 * (s.level || 1);
    s.coins += coins; c.persist(); c.refresh();
    c.toast('Bonus login hari ke-' + s.loginStreak + ': +' + coins + ' koin');
    c.Sfx.sell();
  }
  var sb = document.getElementById('startBtn');
  if (sb) sb.addEventListener('click', function () {
    lockScreen();
    setTimeout(dailyBonus, 1200);
  });
})();
</script>
<script>
(function () {
  function C() { return window.__PMC; }

  // 1) Konfirmasi sebelum Jual Semua kalau ada ikan Epik+ atau mutasi
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('#btnSellHud,#btnSellAll');
    if (!b) return;
    var c = C(); if (!c) return;
    var inv = c.save.inventory, keep = 0;
    for (var k in inv) {
      var x = inv[k]; if (!x || x.count <= 0) continue;
      if (c.RARITY_ORDER.indexOf(x.fish.rarity) >= 3 || (x.mutation && x.mutation.id !== 'normal')) keep += x.count;
    }
    if (keep > 0 && !confirm('Di tas ada ' + keep + ' ikan Epik ke atas / mutasi. Jual semua?')) {
      e.stopImmediatePropagation(); e.preventDefault();
    }
  }, true);

  // 2) Tombol Back Android menutup menu yang kebuka
  var pushed = false;
  function anyOpen() { return !!document.querySelector('.modalOverlay.show'); }
  new MutationObserver(function () {
    var open = anyOpen();
    if (open && !pushed) { pushed = true; try { history.pushState({ pm: 1 }, ''); } catch (e) {} }
    else if (!open && pushed) { pushed = false; try { history.back(); } catch (e) {} }
  }).observe(document.body, { attributes: true, subtree: true, attributeFilter: ['class'] });
  window.addEventListener('popstate', function () {
    if (!anyOpen()) return;
    pushed = false;
    document.querySelectorAll('.modalOverlay.show').forEach(function (m) { m.classList.remove('show'); });
  });

  // 3) Toggle getar
  var vib = true;
  try { vib = localStorage.getItem('pm_vib') !== '0'; } catch (e) {}
  var ov = navigator.vibrate && navigator.vibrate.bind(navigator);
  if (ov) navigator.vibrate = function (p) { return vib ? ov(p) : false; };
  var host = document.getElementById('menuPanel') || document.getElementById('hudPills');
  if (host) {
    var btn = document.createElement('button');
    btn.className = 'hudPill';
    btn.textContent = 'Getar: ' + (vib ? 'ON' : 'OFF');
    btn.onclick = function () {
      vib = !vib;
      try { localStorage.setItem('pm_vib', vib ? '1' : '0'); } catch (e) {}
      btn.textContent = 'Getar: ' + (vib ? 'ON' : 'OFF');
      if (vib && ov) ov(30);
    };
    host.appendChild(btn);
  }
})();
</script>
<script>
(function () {
  function waves() { return '<div class="wvBox"><div class="wv w1"></div><div class="wv w2"></div><div class="wv w3"></div></div>'; }

  // ---- loading screen ----
  var ls = document.getElementById('loadingScreen');
  if (ls) {
    var tips = ['Lepas tombol pas marker di zona Perfect buat peluang ikan langka naik.',
      'Malam hari dan hujan bikin ikan langka lebih gampang nyangkut.',
      'Ikan Rahasia harus ditarik manual, Auto Mancing gak bisa.',
      'Coba Mesin Gacha di plaza buat dapetin skin rod keren.',
      'Cek Pasar tiap hari, harga ikan berubah-ubah.',
      'Lempar kail ke air buat mulai mancing.'];
    var tip = document.createElement('div'); tip.id = 'loadingTip';
    tip.textContent = 'Tips: ' + tips[Math.floor(Math.random() * tips.length)];
    var pct = document.createElement('div'); pct.id = 'loadingPct'; pct.textContent = '0%';
    var track = document.getElementById('loadingBarTrack');
    if (track) track.insertAdjacentElement('afterend', pct);
    ls.appendChild(tip);
    ls.insertAdjacentHTML('beforeend', waves() + '<div class="ldBobber"></div>');
    var fill = document.getElementById('loadingBarFill');
    if (fill) new MutationObserver(function () {
      pct.textContent = Math.round(parseFloat(fill.style.width) || 0) + '%';
    }).observe(fill, { attributes: true, attributeFilter: ['style'] });
  }

  // ---- halaman utama ----
  var ss = document.getElementById('startScreen');
  if (ss) {
    var d = document.createElement('div'); d.id = 'startDeco';
    var b = '<div class="sun"></div>' + waves();
    for (var i = 0; i < 14; i++) {
      var sz = 4 + Math.floor(Math.random() * 7);
      b += '<i class="bub" style="left:' + Math.floor(Math.random() * 100) + '%;width:' + sz + 'px;height:' + sz + 'px;animation-duration:' + (7 + Math.random() * 9).toFixed(1) + 's;animation-delay:-' + (Math.random() * 12).toFixed(1) + 's"></i>';
    }
    d.innerHTML = b;
    ss.insertAdjacentElement('afterend', d);

    var stats = document.createElement('div'); stats.id = 'startStats';
    var btn = document.getElementById('startBtn');
    if (btn) ss.insertBefore(stats, btn);
    function upd() {
      var c = window.__PMC; if (!c || !c.save) return;
      var s = c.save, n = Object.keys(s.discovered || {}).length;
      stats.innerHTML = '<span>Level ' + s.level + '</span><span>' + s.coins + ' koin</span><span>Koleksi ' + n + '/' + c.FISH_TABLE.length + '</span>';
    }
    upd();
    new MutationObserver(upd).observe(ss, { attributes: true, attributeFilter: ['style'] });
    setTimeout(upd, 400);
  }
})();
</script>
<script>
(function () {
  var C = window.__PMC; if (!C) return;
  var HASH = 1449508395;
  function hh(s) { var x = 2166136261; for (var i = 0; i < s.length; i++) { x ^= s.charCodeAt(i); x = Math.imul(x, 16777619); } return x >>> 0; }
  var dev = false; try { dev = localStorage.getItem('pm_dev') === '1'; } catch (e) {}
  var lab = null;

  function label() {
    if (lab) return;
    var c = document.createElement('canvas'); c.width = 384; c.height = 96;
    var g = c.getContext('2d');
    g.fillStyle = 'rgba(10,14,24,0.8)'; g.fillRect(6, 18, 372, 60);
    g.strokeStyle = '#ffcf4d'; g.lineWidth = 4; g.strokeRect(8, 20, 368, 56);
    var gr = g.createLinearGradient(0, 0, 384, 0);
    gr.addColorStop(0, '#fff2a8'); gr.addColorStop(0.5, '#ffcf4d'); gr.addColorStop(1, '#ff9e4a');
    g.fillStyle = gr; g.font = 'bold 44px sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';
    g.shadowColor = 'rgba(0,0,0,0.7)'; g.shadowBlur = 6; g.fillText('DEVELOPER', 192, 50);
    lab = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(c), transparent: true, depthTest: false, fog: false }));
    lab.scale.set(1.7, 0.425, 1); lab.position.set(0, 2.4, 0); lab.renderOrder = 10;
    C.player.add(lab);
  }

  function enable() {
    if (!C.ROD_TIERS.some(function (r) { return r.id === 'dev'; }))
      C.ROD_TIERS.push({ id: 'dev', name: 'Developer Rod', price: 0, biteSpeed: 6, rarityBoost: 99, castRange: 40 });
    if (!C.BAIT_TYPES.some(function (b) { return b.id === 'dev'; }))
      C.BAIT_TYPES.push({ id: 'dev', name: 'Developer Bait', price: 0, rarityBoost: 99, stock: 999 });
    C.GEAR_COLORS.rod.dev = '#ff2d55'; C.GEAR_COLORS.bait.dev = '#ff2d55';
    var s = C.save;
    if (s.ownedRods.indexOf('dev') < 0) s.ownedRods.push('dev');
    s.baitStock.dev = 999;
    label();
    var host = document.getElementById('menuPanel') || document.getElementById('hudPills');
    if (host && !document.getElementById('btnDevOff')) {
      var b = document.createElement('button'); b.className = 'hudPill'; b.id = 'btnDevOff'; b.textContent = 'Developer: ON';
      b.onclick = function () { try { localStorage.removeItem('pm_dev'); } catch (e) {} location.reload(); };
      host.appendChild(b);
    }
    C.persist(); C.refresh();
  }

  if (dev) enable();
  else {
    // pastikan save tanpa mode dev gak bawa item dev
    var s0 = C.save;
    s0.ownedRods = (s0.ownedRods || []).filter(function (x) { return x !== 'dev'; });
    if (s0.rod === 'dev') s0.rod = 'bambu';
    if (s0.bait === 'dev') s0.bait = 'biasa';
    if (s0.baitStock) delete s0.baitStock.dev;
  }

  // peluang Secret/Mitos cuma aktif kalau Rod DAN Bait developer dipakai
  C.hookRoll(function (orig, boost) {
    var r = orig(boost), s = C.save;
    if (!dev || s.rod !== 'dev' || s.bait !== 'dev') return r;
    var x = Math.random(), rar = x < 0.15 ? 'secret' : (x < 0.50 ? 'mythical' : null);
    if (!rar) return r;
    var z = r.fish.zone;
    var pool = C.FISH_TABLE.filter(function (f) { return f.rarity === rar && (!f.zone || f.zone === z); });
    if (!pool.length) return r;
    var f = pool[Math.floor(Math.random() * pool.length)];
    r.fish = f; r.value = Math.round(f.value * r.mutation.mult);
    return r;
  });

  // buka: tap badge versi 7x lalu masukkan kode
  var badge = document.getElementById('versionBadge'), n = 0, t0 = 0;
  if (badge) {
    badge.style.pointerEvents = 'auto'; badge.style.padding = '6px 30px';
    badge.addEventListener('click', function () {
      var now = Date.now(); if (now - t0 > 3000) n = 0; t0 = now;
      if (++n < 7) { if (n >= 3) C.toast('Developer: ' + n + '/7'); return; } n = 0;
      if (dev) { C.toast('Mode developer sudah aktif'); return; }
      askCode(function (k) {
        if (hh('pm-dev:' + k) === HASH) {
          dev = true; try { localStorage.setItem('pm_dev', '1'); } catch (e) {}
          enable(); C.toast('Mode developer aktif');
        } else C.toast('Kode salah');
      });
      function askCode(cb) {
        var o = document.createElement('div'); o.className = 'modalOverlay show'; o.style.zIndex = 90;
        o.innerHTML = '<div class="modalBox" style="width:min(90vw,360px)"><div class="modalHead"><h2>Kode developer</h2></div><div class="modalBody"><input id="pmDevIn" type="password" autocomplete="off" style="width:100%;padding:10px;border-radius:12px;border:2px solid rgba(255,255,255,.4);background:rgba(0,0,0,.35);color:#fff;font-size:14px;user-select:text;-webkit-user-select:text"><div style="display:flex;gap:8px"><button class="rowBtn" id="pmDevNo" style="flex:1">Batal</button><button class="rowBtn" id="pmDevOk" style="flex:1">Masuk</button></div></div></div>';
        document.body.appendChild(o);
        var i = o.querySelector('#pmDevIn'); setTimeout(function () { i.focus(); }, 100);
        o.querySelector('#pmDevNo').onclick = function () { o.remove(); };
        o.querySelector('#pmDevOk').onclick = function () { var v = i.value; o.remove(); cb(v); };
      }
    });
  }
})();
</script>
<script>
(function () {
  var C = window.__PMC; if (!C) return;
  function wood(rx, ry, col) {
    var c = document.createElement('canvas'); c.width = c.height = 128; var g = c.getContext('2d'); g.fillStyle = col; g.fillRect(0, 0, 128, 128);
    for (var i = 0; i < 8; i++) { g.fillStyle = 'rgba(0,0,0,' + (0.1 + 0.06 * (i % 2)) + ')'; g.fillRect(0, i * 16, 128, 2);
      for (var k = 0; k < 6; k++) { g.fillStyle = 'rgba(60,30,10,.12)'; g.fillRect(Math.random() * 128, i * 16 + 4 + Math.random() * 9, 18, 1.5); } }
    var t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rx, ry); t.anisotropy = 4; return t;
  }
  var S = function (o) { return new THREE.MeshStandardMaterial(o); };
  var hullM = S({ map: wood(1, 3, '#8a4a2b'), roughness: 0.7 }), white = S({ color: 0xf4f1e8, roughness: 0.5 }),
      dark = S({ color: 0x2a2018, roughness: 0.8 }), brass = S({ color: 0xc9a24a, metalness: 0.8, roughness: 0.3 }),
      glass = S({ color: 0x88ccee, emissive: 0x224466, roughness: 0.1, metalness: 0.3 }),
      lamp = S({ color: 0xffe08a, emissive: 0xffc04a, emissiveIntensity: 1.2 }), red = S({ color: 0xe8432f, roughness: 0.6, side: THREE.DoubleSide });
  var b = C.boatMesh;
  b.children.forEach(function (m, i) { if (!m.isMesh) return; m.castShadow = m.receiveShadow = true; m.material = i === 0 ? hullM : (i === 1 || i === 2) ? white : dark; });
  function add(geo, mat, x, y, z) { var m = new THREE.Mesh(geo, mat); m.position.set(x, y, z); m.castShadow = true; b.add(m); return m; }
  [-0.9, 0.9].forEach(function (sx) { add(new THREE.BoxGeometry(0.08, 0.22, 4.2), dark, sx, 0.45, 0); });
  add(new THREE.BoxGeometry(1.6, 0.08, 0.4), hullM, 0, 0.38, 1.3);
  add(new THREE.BoxGeometry(1.6, 0.08, 0.4), hullM, 0, 0.38, -1.7);
  add(new THREE.BoxGeometry(0.7, 0.26, 0.05), glass, 0, 0.85, -0.14);
  add(new THREE.CylinderGeometry(0.03, 0.03, 0.8, 8), brass, 0, 0.75, 1.95);
  add(new THREE.SphereGeometry(0.11, 12, 10), lamp, 0, 1.2, 1.95);
  var rope = add(new THREE.TorusGeometry(0.22, 0.05, 8, 18), S({ color: 0xc8b07a, roughness: 0.9 }), 0.4, 0.42, 1.3); rope.rotation.x = Math.PI / 2;
  var flag = add(new THREE.PlaneGeometry(0.55, 0.32), red, 0.3, 2.3, 0.6);
  var gem = new THREE.Mesh(new THREE.OctahedronGeometry(0.05), S({ color: 0xffffff, emissive: 0xffffff, emissiveIntensity: 0.8, metalness: 0.4, roughness: 0.2 }));
  gem.position.set(0, 0.12, 0.035); C.rodMesh.add(gem);
  var ring = new THREE.Mesh(new THREE.TorusGeometry(0.038, 0.01, 6, 14), brass); ring.position.set(0, 0.12, 0); ring.rotation.x = Math.PI / 2; C.rodMesh.add(ring);
  var lastRod = '';
  C.hookAnim(function (t) {
    flag.rotation.y = Math.sin(t * 3) * 0.35; flag.position.x = 0.3 + Math.sin(t * 3) * 0.03;
    var id = C.save.rod; if (id === lastRod) return; lastRod = id;
    var idx = C.ROD_TIERS.findIndex(function (r) { return r.id === id; }), col = new THREE.Color(C.GEAR_COLORS.rod[id] || '#9fb4bd');
    gem.material.color.copy(col); gem.material.emissive.copy(col); gem.visible = ring.visible = idx >= 1; gem.scale.setScalar(1 + idx * 0.25);
  });
