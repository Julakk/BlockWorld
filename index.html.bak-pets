      addLamp(cx - 3.55, 42.3); addLamp(cx + 3.55, 42.3);
      bench(cx, 42.2, 2.2);
      sign(cx, 29.3, sd < 0 ? 'SPOT KIRI' : 'SPOT KANAN', sd < 0 ? '#1f6f8f' : '#1f7d72');
    });

    /* platform lebar di ujung dermaga utama */
