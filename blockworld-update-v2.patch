+  // v3.6: tombol darurat buat kejadian kejeblos di dalam gua/lubang galian sendiri
+  // dan gak nemu jalan naik lagi ke permukaan. Nembak lurus ke atas dari posisi
+  // sekarang (bukan ground level statis), jadi tetap aman dipakai walau lagi
+  // di gunung tinggi atau di bawah laut.
+  function escapeToSurface() {
+    if (playerDead) return;
+    const gx = Math.round(player.pos.x), gz = Math.round(player.pos.z);
+    const surfaceY = findGroundY(gx, gz, groundHeightAt(gx, gz) + 40);
+    player.pos.set(gx + 0.5, surfaceY + 1, gz + 0.5);
+    player.velY = 0;
+    showToast(svgIcon('ladder') + ' Naik ke permukaan!');
+    setSecondaryOpen(false);
+  }
+  document.getElementById('escapeSurfaceBtn').addEventListener('click', escapeToSurface);
